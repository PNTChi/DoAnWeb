@model DoAnWeb.tb_ThuongHieu
@{
    ViewBag.Title = "formThemTH";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@using (Html.BeginForm("ThemTH", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <h3 id="formCategoryTitle">Thêm thương hiệu mới</h3>
    <hr>
    @Html.ValidationSummary(true)

    <div class="mb-3">
        @Html.Label("TenThuongHieu", "Tên thương hiệu", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.TenThuongHieu, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.TenThuongHieu)
    </div>
    <div class="mb-3">
        @Html.Label("BiDanh", "Bí danh", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.BiDanh, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.BiDanh)
    </div>
    <div class="mb-3">
        @Html.Label("HienThi", "Hiển thị", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.HienThi, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.HienThi)
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">Lưu thương hiệu</button>
        <a href="@Url.Action("ThuongHieu", "Admin")" class="btn btn-secondary">Hủy</a>
    </div>
}