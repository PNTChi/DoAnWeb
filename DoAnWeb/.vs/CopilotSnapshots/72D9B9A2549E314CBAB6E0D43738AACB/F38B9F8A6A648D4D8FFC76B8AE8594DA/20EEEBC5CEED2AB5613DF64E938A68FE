### 2. ✅ Controller (`Controllers\SanPhamController.cs`)
**Đã cập nhật:**

#### **Action Index - Xử lý filter theo thương hiệu:**
```csharp
public ActionResult Index(int? danhMucId, int? thuongHieuId, decimal? giaMin, decimal? giaMax,
    string loc, string search, int? page)
{
    var query = db.tb_SanPham.Where(sp => sp.HienThi == true);
    
    string categoryName = "Tất cả sản phẩm";

    // Filter theo danh mục
    if (danhMucId.HasValue)
    {
        query = query.Where(sp => sp.DanhMucId == danhMucId.Value);
        var danhMuc = db.tb_DanhMuc.Find(danhMucId.Value);
        if (danhMuc != null)
        {
            categoryName = danhMuc.TenDanhMuc;
        }
    }

    // Filter theo thương hiệu
    if (thuongHieuId.HasValue)
    {
        query = query.Where(sp => sp.ThuongHieuId == thuongHieuId.Value);
        
        var thuongHieu = db.tb_ThuongHieu.Find(thuongHieuId.Value);
        if (thuongHieu != null)
        {
            categoryName = danhMucId.HasValue 
                ? $"{categoryName} - {thuongHieu.TenThuongHieu}" 
                : thuongHieu.TenThuongHieu;
        }
    }
    
    // ... (các filter khác: giá, search, pagination)
    
    // ✨ MỚI: Lưu thông tin vào ViewBag cho breadcrumb
    ViewBag.DanhMucId = danhMucId;
    ViewBag.ThuongHieuId = thuongHieuId;
    
    if (danhMucId.HasValue)
    {
        var danhMuc = db.tb_DanhMuc.Find(danhMucId.Value);
        ViewBag.TenDanhMuc = danhMuc?.TenDanhMuc;
    }
    
    if (thuongHieuId.HasValue)
    {
        var thuongHieu = db.tb_ThuongHieu.Find(thuongHieuId.Value);
        ViewBag.TenThuongHieu = thuongHieu?.TenThuongHieu;
    }

    return View(viewModel);
}
```

**Những gì đã cải thiện:**
- ✅ Xử lý tham số `thuongHieuId` từ URL
- ✅ Filter sản phẩm theo thương hiệu
- ✅ Hiển thị tên thương hiệu trong tiêu đề trang
- ✅ Kết hợp filter: danh mục + thương hiệu (ví dụ: "Điện thoại - Samsung")
- ✅ **MỚI:** Truyền `ViewBag.TenThuongHieu` để hiển thị trong breadcrumb

