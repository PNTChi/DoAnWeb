using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using DoAnWeb.Models;

namespace DoAnWeb.Controllers
{
    /// <summary>
    /// Controller xử lý các chức năng liên quan đến Menu và Danh mục
    /// </summary>
    public class MenuController : Controller
    {
        // Khởi tạo DbContext để truy vấn database
        private WebBanHangDienTuEntities db = new WebBanHangDienTuEntities();

        /// <summary>
        /// Action trả về Partial View danh mục sản phẩm cho Sidebar
        /// Được gọi từ _Layout.cshtml bằng @Html.Action()
        /// </summary>
        /// <returns>PartialView với danh sách danh mục kèm thương hiệu</returns>
        [ChildActionOnly] // Chỉ cho phép gọi từ View khác, không truy cập trực tiếp qua URL
        public ActionResult DanhMuc()
        {
            // Lấy tất cả danh mục đang hiển thị
            var danhSachDanhMuc = db.tb_DanhMuc
                .Where(dm => dm.HienThi == true)
                .OrderBy(dm => dm.ThuTu)
                .ToList();

            // Tạo danh sách ViewModel với thương hiệu cho mỗi danh mục
            var viewModelList = new List<MenuDanhMucViewModel>();

            foreach (var danhMuc in danhSachDanhMuc)
            {
                var viewModel = new MenuDanhMucViewModel
                {
                    DanhMuc = danhMuc,
                    SoLuongSanPham = danhMuc.tb_SanPham.Count(sp => sp.HienThi == true),
                    DanhSachThuongHieu = GetThuongHieuByDanhMuc(danhMuc.Id)
                };

                viewModelList.Add(viewModel);
            }

            // Trả về PartialView với danh sách ViewModel
            return PartialView("_DanhMuc", viewModelList);
        }

        /// <summary>
        /// Lấy danh sách thương hiệu có sản phẩm trong danh mục
        /// </summary>
        /// <param name="danhMucId">ID danh mục</param>
        /// <returns>Danh sách thương hiệu kèm số lượng sản phẩm</returns>
        private List<ThuongHieuItem> GetThuongHieuByDanhMuc(int danhMucId)
        {
            var thuongHieuList = db.tb_SanPham
                .Where(sp => sp.DanhMucId == danhMucId
                 && sp.HienThi == true
                  && sp.ThuongHieuId.HasValue
   && sp.tb_ThuongHieu != null
                 && sp.tb_ThuongHieu.HienThi == true)
                .GroupBy(sp => new
     {
                    sp.ThuongHieuId,
        sp.tb_ThuongHieu.TenThuongHieu,
     sp.tb_ThuongHieu.HinhAnh
                })
     .Select(g => new ThuongHieuItem
                {
             Id = g.Key.ThuongHieuId.Value,
          TenThuongHieu = g.Key.TenThuongHieu,
   HinhAnh = g.Key.HinhAnh,
               SoLuongSanPham = g.Count()
 })
              .OrderByDescending(th => th.SoLuongSanPham) // Thương hiệu có nhiều sản phẩm nhất lên đầu
         .Take(10) // Giới hạn 10 thương hiệu cho mỗi danh mục
        .ToList();

            return thuongHieuList;
        }

        /// <summary>
  /// Helper method: Xác định tên Partial View phù hợp dựa trên tên danh mục
        /// </summary>
  /// <param name="tenDanhMuc">Tên danh mục từ database</param>
        /// <returns>Tên Partial View tương ứng</returns>
  private string GetPartialViewName(string tenDanhMuc)
        {
     // Map tên danh mục với Partial View tương ứng
       var mapping = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
            {
 { "Điện thoại", "_MenuDienThoai" },
  { "Laptop", "_MenuLaptop" },
    { "Tablet", "_MenuTablet" },
      { "Phụ kiện", "_MenuPhuKien" }
 };

 // Trả về tên Partial View nếu tìm thấy, nếu không dùng template chung
      return mapping.ContainsKey(tenDanhMuc) 
                ? mapping[tenDanhMuc] 
        : "_CategoryMenuItem"; // Template chung cho các danh mục khác
        }

        /// <summary>
        /// Action trả về Partial View menu top bar (blue bar)
        /// Hiển thị các danh mục chính trên thanh điều hướng
        /// </summary>
        /// <returns>PartialView với danh sách danh mục chính</returns>
        [ChildActionOnly]
        public ActionResult TopMenu()
        {
            // Lấy danh mục chính để hiển thị trên top menu
            var danhSachDanhMuc = db.tb_DanhMuc
                .Where(dm => dm.HienThi == true)
                .OrderBy(dm => dm.ThuTu)
                .Take(5) // Giới hạn 5 danh mục chính
                .Select(dm => new
                {
                    dm.Id,
                    dm.TenDanhMuc,
                    dm.Icon,
                    dm.BiDanh
                })
                .ToList();

            return PartialView("_TopMenu", danhSachDanhMuc);
        }

        /// <summary>
        /// Giải phóng tài nguyên khi controller bị hủy
        /// </summary>
        protected override void Dispose(bool disposing)
        {
            if (disposing)
            {
                db.Dispose();
            }
            base.Dispose(disposing);
        }
    }
}
