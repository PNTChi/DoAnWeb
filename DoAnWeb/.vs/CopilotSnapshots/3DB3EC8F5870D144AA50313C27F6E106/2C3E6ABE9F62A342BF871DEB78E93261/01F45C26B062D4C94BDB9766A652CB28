@{
    ViewBag.Title = "Liên hệ";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Liên hệ</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-6 py-4 rounded-lg mb-6 animate-fade-in" role="alert">
        <div class="flex items-center">
            <i class="fas fa-check-circle text-2xl mr-3"></i>
            <div>
                <strong class="font-bold">Thành công!</strong>
                <p class="text-sm">@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times text-green-700 hover:text-green-900"></i>
            </button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-6 py-4 rounded-lg mb-6 animate-fade-in" role="alert">
        <div class="flex items-center">
            <i class="fas fa-exclamation-circle text-2xl mr-3"></i>
            <div>
                <strong class="font-bold">Lỗi!</strong>
                <p class="text-sm">@TempData["ErrorMessage"]</p>
            </div>
            <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times text-red-700 hover:text-red-900"></i>
            </button>
        </div>
    </div>
}

<!-- Page Header -->
<div class="bg-gradient-to-r from-green-500 to-teal-500 rounded-lg shadow-lg p-8 mb-8 text-white">
    <div class="text-center">
        <h1 class="text-4xl font-bold mb-3 flex items-center justify-center">
            <i class="fas fa-envelope mr-3"></i>
            LIÊN HỆ VỚI CHÚNG TÔI
        </h1>
        <p class="text-xl opacity-90">
            Chúng tôi luôn sẵn sàng lắng nghe và hỗ trợ bạn
        </p>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Contact Info Cards (1/3) -->
    <div class="lg:col-span-1 space-y-6">
        <!-- Hotline Card -->
        <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
            <div class="flex items-center mb-4">
                <div class="w-14 h-14 bg-gradient-to-br from-blue-500 to-blue-600 rounded-full flex items-center justify-center mr-4">
                    <i class="fas fa-phone-alt text-white text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Hotline</h3>
                    <p class="text-sm text-gray-600">Hỗ trợ 24/7</p>
                </div>
            </div>
            <a href="tel:18001060" class="text-2xl font-bold text-blue-600 hover:text-blue-700 block">
                @ViewBag.HotlineText
            </a>
            <p class="text-sm text-gray-600 mt-2">Miễn phí gọi từ cả nước</p>
        </div>

        <!-- Email Card -->
        <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
            <div class="flex items-center mb-4">
                <div class="w-14 h-14 bg-gradient-to-br from-red-500 to-pink-600 rounded-full flex items-center justify-center mr-4">
                    <i class="fas fa-envelope text-white text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Email</h3>
                    <p class="text-sm text-gray-600">Gửi thắc mắc</p>
                </div>
            </div>
            <a href="mailto:support@laptopstore.vn" class="text-lg font-semibold text-red-600 hover:text-red-700 block break-all">
                @ViewBag.EmailText
            </a>
            <p class="text-sm text-gray-600 mt-2">Phản hồi trong 24h</p>
        </div>

        <!-- Address Card -->
        <div class="bg-white rounded-lg shadow-lg p-6 hover:shadow-xl transition-shadow">
            <div class="flex items-center mb-4">
                <div class="w-14 h-14 bg-gradient-to-br from-green-500 to-teal-600 rounded-full flex items-center justify-center mr-4">
                    <i class="fas fa-map-marker-alt text-white text-xl"></i>
                </div>
                <div>
                    <h3 class="text-lg font-bold text-gray-900">Địa chỉ</h3>
                    <p class="text-sm text-gray-600">Cửa hàng</p>
                </div>
            </div>
            <p class="text-gray-700 leading-relaxed">
                @ViewBag.AddressText
            </p>
            <div class="mt-4 pt-4 border-t">
                <p class="text-sm text-gray-600">
                    <i class="far fa-clock mr-2"></i>
                    <strong>Giờ làm việc:</strong><br>
                    @ViewBag.WorkingHours
                </p>
            </div>
        </div>

        <!-- Social Media -->
        <div class="bg-white rounded-lg shadow-lg p-6">
            <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-share-alt mr-2 text-purple-600"></i>
                Kết nối với chúng tôi
            </h3>
            <div class="grid grid-cols-2 gap-3">
                <a href="#" class="flex items-center justify-center p-3 bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition-colors">
                    <i class="fab fa-facebook-f text-xl mr-2"></i>
                    <span class="font-semibold">Facebook</span>
                </a>
                <a href="#" class="flex items-center justify-center p-3 bg-red-600 hover:bg-red-700 text-white rounded-lg transition-colors">
                    <i class="fab fa-youtube text-xl mr-2"></i>
                    <span class="font-semibold">YouTube</span>
                </a>
                <a href="#" class="flex items-center justify-center p-3 bg-gradient-to-r from-purple-500 to-pink-500 hover:from-purple-600 hover:to-pink-600 text-white rounded-lg transition-colors">
                    <i class="fab fa-instagram text-xl mr-2"></i>
                    <span class="font-semibold">Instagram</span>
                </a>
                <a href="#" class="flex items-center justify-center p-3 bg-black hover:bg-gray-800 text-white rounded-lg transition-colors">
                    <i class="fab fa-tiktok text-xl mr-2"></i>
                    <span class="font-semibold">TikTok</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Contact Form (2/3) -->
    <div class="lg:col-span-2">
        <div class="bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b flex items-center">
                <i class="fas fa-paper-plane mr-3 text-green-600"></i>
                Gửi tin nhắn cho chúng tôi
            </h2>

            <form id="contactForm" action="@Url.Action("GuiLienHe", "LienHe")" method="post">
                @Html.AntiForgeryToken()

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <!-- Họ tên -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Họ và tên <span class="text-red-500">*</span>
                        </label>
                        <input type="text"
                               name="hoTen"
                               required
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all"
                               placeholder="Nguyễn Văn A">
                    </div>

                    <!-- Email -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Email <span class="text-red-500">*</span>
                        </label>
                        <input type="email"
                               name="email"
                               required
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all"
                               placeholder="email@example.com">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                    <!-- Số điện thoại -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Số điện thoại
                        </label>
                        <input type="tel"
                               name="soDienThoai"
                               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all"
                               placeholder="0912345678">
                    </div>

                    <!-- Chủ đề -->
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Chủ đề
                        </label>
                        <select name="chuDe"
                                class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all">
                            <option value="">-- Chọn chủ đề --</option>
                            <option value="Hỗ trợ kỹ thuật">Hỗ trợ kỹ thuật</option>
                            <option value="Tư vấn sản phẩm">Tư vấn sản phẩm</option>
                            <option value="Báo giá">Báo giá</option>
                            <option value="Khiếu nại">Khiếu nại</option>
                            <option value="Góp ý">Góp ý</option>
                            <option value="Khác">Khác</option>
                        </select>
                    </div>
                </div>

                <!-- Nội dung -->
                <div class="mb-6">
                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Nội dung <span class="text-red-500">*</span>
                    </label>
                    <textarea name="noiDung"
                              rows="6"
                              required
                              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-green-500 focus:border-green-500 transition-all resize-none"
                              placeholder="Nhập nội dung chi tiết..."></textarea>
                </div>

                <!-- Submit Button -->
                <div class="flex items-center justify-between">
                    <div class="text-sm text-gray-600">
                        <i class="fas fa-info-circle mr-1"></i>
                        <span class="text-red-500">*</span> Thông tin bắt buộc
                    </div>
                    <button type="submit"
                            class="bg-gradient-to-r from-green-500 to-teal-500 hover:from-green-600 hover:to-teal-600 text-white font-bold py-3 px-8 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center">
                        <i class="fas fa-paper-plane mr-2"></i>
                        Gửi tin nhắn
                    </button>
                </div>
            </form>
        </div>

        <!-- Google Maps -->
        <div class="bg-white rounded-lg shadow-lg p-6 mt-8">
            <h3 class="text-xl font-bold text-gray-900 mb-4 flex items-center">
                <i class="fas fa-map-marked-alt mr-2 text-red-600"></i>
                Bản đồ
            </h3>
            <div class="aspect-video rounded-lg overflow-hidden border-2 border-gray-200">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.6305546302195!2d106.62524631533422!3d10.762622162279946!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752be27d8b4f4d%3A0x92dcba2950430867!2zVHLGsOG7nW5nIMSQ4bqhaSBo4buNYyBDw7RuZyBUaMawxqFuZyBUUC4gSOG7kyBDaMOtIE1pbmg!5e0!3m2!1svi!2s!4v1642584765431!5m2!1svi!2s"
                        width="100%"
                        height="100%"
                        style="border:0;"
                        allowfullscreen=""
                        loading="lazy"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- FAQ Section (Optional) -->
<div class="bg-white rounded-lg shadow-lg p-8 mt-8">
    <h2 class="text-2xl font-bold text-gray-900 mb-6 text-center">
        <i class="fas fa-question-circle mr-2 text-orange-600"></i>
        Câu hỏi thường gặp
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="border-l-4 border-blue-500 pl-4">
            <h4 class="font-bold text-gray-900 mb-2">Thời gian giao hàng?</h4>
            <p class="text-gray-600 text-sm">Nội thành TP.HCM: 2-4 giờ. Ngoại thành: 1-2 ngày. Tỉnh khác: 2-5 ngày.</p>
        </div>
        <div class="border-l-4 border-green-500 pl-4">
            <h4 class="font-bold text-gray-900 mb-2">Chính sách bảo hành?</h4>
            <p class="text-gray-600 text-sm">Bảo hành chính hãng 12-24 tháng tùy sản phẩm. 1 đổi 1 trong 7 ngày đầu.</p>
        </div>
        <div class="border-l-4 border-red-500 pl-4">
            <h4 class="font-bold text-gray-900 mb-2">Hình thức thanh toán?</h4>
            <p class="text-gray-600 text-sm">COD, chuyển khoản ngân hàng, ví điện tử MoMo, ZaloPay, thẻ tín dụng.</p>
        </div>
        <div class="border-l-4 border-purple-500 pl-4">
            <h4 class="font-bold text-gray-900 mb-2">Chính sách đổi trả?</h4>
            <p class="text-gray-600 text-sm">Đổi trả miễn phí trong 7 ngày nếu sản phẩm lỗi, không đúng mô tả.</p>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Phone number formatting
        $('input[type="tel"]').on('input', function () {
            var value = $(this).val().replace(/\D/g, '');
            $(this).val(value);
        });

        // Auto-hide messages after 5 seconds
        setTimeout(function () {
            $('[role="alert"]').fadeOut('slow', function () {
                $(this).remove();
            });
        }, 5000);

        // Form validation
        $('#contactForm').on('submit', function (e) {
            var isValid = true;
            var firstError = null;

            // Check required fields
            $(this).find('[required]').each(function () {
                if (!$(this).val().trim()) {
                    isValid = false;
                    if (!firstError) {
                        firstError = $(this);
                    }
                    $(this).addClass('border-red-500');
                } else {
                    $(this).removeClass('border-red-500');
                }
            });

            if (!isValid) {
                e.preventDefault();
                if (firstError) {
                    $('html, body').animate({
                        scrollTop: firstError.offset().top - 100
                    }, 500);
                    firstError.focus();
                }
                alert('Vui lòng điền đầy đủ thông tin bắt buộc');
            }
        });
    </script>

    <style>
        .animate-fade-in {
            animation: fadeIn 0.5s ease-in;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(-10px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
    </style>
}