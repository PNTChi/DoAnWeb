@model DoAnWeb.tb_TinTuc

@{
    ViewBag.Title = Model.TieuDe;
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
  <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
    <i class="fas fa-home mr-2"></i>
Trang chủ
</a>
 </li>
 <li>
      <div class="flex items-center">
       <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
     <a href="@Url.Action("Index", "TinTuc")" class="text-sm font-medium text-gray-700 hover:text-blue-600">
   Tin tức
     </a>
    </div>
 </li>
      <li aria-current="page">
   <div class="flex items-center">
      <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
      <span class="text-sm font-medium text-gray-500 line-clamp-1">@Model.TieuDe</span>
 </div>
        </li>
    </ol>
</nav>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Main Content (3/4) -->
    <div class="lg:col-span-3">
  <article class="bg-white rounded-lg shadow-lg overflow-hidden">
       <!-- Featured Image -->
     @if (!string.IsNullOrEmpty(Model.HinhAnh))
      {
      <div class="w-full aspect-video overflow-hidden bg-gray-100">
       <img src="@Url.Content("~/Content/Images/" + Model.HinhAnh)" 
        alt="@Model.TieuDe" 
    class="w-full h-full object-cover" />
    </div>
   }

            <!-- Content -->
      <div class="p-8">
   <!-- Category & Date -->
                <div class="flex items-center space-x-4 mb-4">
      @if (Model.tb_DanhMucTin != null)
      {
            <span class="bg-blue-100 text-blue-800 text-sm font-semibold px-3 py-1 rounded-full">
        @Model.tb_DanhMucTin.TenDanhMuc
     </span>
   }
      @if (Model.NoiBat == true)
     {
        <span class="bg-red-100 text-red-800 text-sm font-semibold px-3 py-1 rounded-full">
    <i class="fas fa-fire mr-1"></i>Nổi bật
     </span>
        }
 </div>

     <!-- Title -->
   <h1 class="text-4xl font-bold text-gray-900 mb-4">
       @Model.TieuDe
    </h1>

    <!-- Meta Info -->
    <div class="flex items-center space-x-6 text-sm text-gray-600 pb-6 border-b mb-6">
        <div class="flex items-center">
      <i class="far fa-calendar mr-2"></i>
    <span>@(Model.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</span>
         </div>
    <div class="flex items-center">
      <i class="far fa-eye mr-2"></i>
      <span>@(Model.LuotXem ?? 0) lượt xem</span>
    </div>
    @if (Model.NgayCapNhat.HasValue)
        {
        <div class="flex items-center">
            <i class="far fa-clock mr-2"></i>
    <span>Cập nhật: @Model.NgayCapNhat.Value.ToString("dd/MM/yyyy")</span>
     </div>
       }
      </div>

    <!-- Summary -->
        @if (!string.IsNullOrEmpty(Model.TomTat))
       {
       <div class="bg-blue-50 border-l-4 border-blue-500 p-6 mb-6 rounded">
       <p class="text-lg text-gray-700 leading-relaxed italic">
    @Model.TomTat
   </p>
       </div>
        }

     <!-- Main Content -->
        @if (!string.IsNullOrEmpty(Model.NoiDung))
       {
    <div class="prose prose-lg max-w-none">
       @Html.Raw(Model.NoiDung)
    </div>
 }

        <!-- Tags (if any) -->
   <div class="mt-8 pt-6 border-t">
   <div class="flex items-center space-x-2">
        <i class="fas fa-tags text-gray-400"></i>
      <div class="flex flex-wrap gap-2">
      <a href="#" class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-3 py-1 rounded-full transition-colors">Công nghệ</a>
     <a href="#" class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-3 py-1 rounded-full transition-colors">Điện thoại</a>
 <a href="#" class="bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm px-3 py-1 rounded-full transition-colors">Review</a>
     </div>
      </div>
   </div>

   <!-- Share -->
       <div class="mt-6 pt-6 border-t">
    <h3 class="text-lg font-bold text-gray-900 mb-4">Chia sẻ bài viết:</h3>
   <div class="flex items-center space-x-3">
        <a href="#" class="flex items-center justify-center w-10 h-10 bg-blue-600 hover:bg-blue-700 text-white rounded-full transition-colors">
        <i class="fab fa-facebook-f"></i>
    </a>
    <a href="#" class="flex items-center justify-center w-10 h-10 bg-sky-500 hover:bg-sky-600 text-white rounded-full transition-colors">
         <i class="fab fa-twitter"></i>
   </a>
       <a href="#" class="flex items-center justify-center w-10 h-10 bg-red-600 hover:bg-red-700 text-white rounded-full transition-colors">
         <i class="fab fa-pinterest-p"></i>
     </a>
   <a href="#" class="flex items-center justify-center w-10 h-10 bg-green-600 hover:bg-green-700 text-white rounded-full transition-colors">
    <i class="fab fa-whatsapp"></i>
 </a>
       </div>
       </div>
      </div>
   </article>

        <!-- Tin liên quan -->
@if (ViewBag.TinLienQuan != null && ((List<DoAnWeb.tb_TinTuc>)ViewBag.TinLienQuan).Any())
 {
   <div class="bg-white rounded-lg shadow-lg p-6 mt-8">
  <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-3 border-b flex items-center">
    <i class="fas fa-newspaper mr-3 text-blue-600"></i>
       Tin liên quan
 </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
       @foreach (var tin in (List<DoAnWeb.tb_TinTuc>)ViewBag.TinLienQuan)
    {
    <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })" 
     class="flex items-start space-x-4 group p-4 rounded-lg hover:bg-gray-50 transition-colors">
         @if (!string.IsNullOrEmpty(tin.HinhAnh))
      {
       <img src="@Url.Content("~/Content/Images/" + tin.HinhAnh)" 
  alt="@tin.TieuDe" 
     class="w-32 h-24 object-cover rounded flex-shrink-0" />
    }
        <div class="flex-1 min-w-0">
   <h3 class="text-base font-semibold text-gray-900 line-clamp-2 group-hover:text-blue-600 mb-2">
 @tin.TieuDe
 </h3>
    <p class="text-sm text-gray-500">
   <i class="far fa-calendar mr-1"></i>
@(tin.NgayTao?.ToString("dd/MM/yyyy") ?? "")
     </p>
 </div>
 </a>
        }
      </div>
   </div>
 }
    </div>

    <!-- Sidebar (1/4) -->
    <div class="lg:col-span-1 space-y-6">
 <!-- Tin mới nhất -->
 @if (ViewBag.TinMoiNhat != null && ((List<DoAnWeb.tb_TinTuc>)ViewBag.TinMoiNhat).Any())
        {
   <div class="bg-white rounded-lg shadow-md p-5">
  <h3 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b flex items-center">
      <i class="fas fa-clock mr-2 text-green-600"></i>
    Tin mới nhất
  </h3>
   <div class="space-y-4">
     @foreach (var tin in (List<DoAnWeb.tb_TinTuc>)ViewBag.TinMoiNhat)
     {
        <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })" 
     class="flex items-start space-x-3 group">
@if (!string.IsNullOrEmpty(tin.HinhAnh))
  {
       <img src="@Url.Content("~/Content/Images/" + tin.HinhAnh)" 
         alt="@tin.TieuDe" 
    class="w-20 h-20 object-cover rounded flex-shrink-0" />
     }
   <div class="flex-1 min-w-0">
       <h4 class="text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-blue-600 mb-1">
      @tin.TieuDe
     </h4>
      <p class="text-xs text-gray-500">
    <i class="far fa-calendar mr-1"></i>
@(tin.NgayTao?.ToString("dd/MM/yyyy") ?? "")
   </p>
    </div>
        </a>
  }
      </div>
   </div>
 }

     <!-- Newsletter -->
 <div class="bg-gradient-to-br from-blue-500 to-cyan-500 rounded-lg shadow-md p-6 text-white">
   <h3 class="text-xl font-bold mb-3">
    <i class="fas fa-envelope mr-2"></i>
  Đăng ký nhận tin
    </h3>
        <p class="text-sm mb-4 opacity-90">
      Nhận tin tức mới nhất qua email
   </p>
    <form>
        <input type="email" 
    placeholder="Email của bạn" 
        class="w-full px-4 py-3 rounded-lg text-gray-900 mb-3 focus:ring-2 focus:ring-white" 
   required>
     <button type="submit" class="w-full bg-white hover:bg-gray-100 text-blue-600 font-bold py-3 px-4 rounded-lg transition-colors">
    Đăng ký ngay
     </button>
        </form>
     </div>
    </div>
</div>

@section scripts {
<script>
    // Add reading progress bar
    $(window).scroll(function() {
  var scrollTop = $(window).scrollTop();
   var docHeight = $(document).height();
     var winHeight = $(window).height();
var scrollPercent = (scrollTop) / (docHeight - winHeight);
        var scrollPercentRounded = Math.round(scrollPercent * 100);
   
        // You can add a progress bar here
        console.log('Reading progress: ' + scrollPercentRounded + '%');
    });
</script>
}
