@model DoAnWeb.tb_TaiKhoan

@{
    ViewBag.Title = "Tài khoản của tôi";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
<a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
           <i class="fas fa-home mr-2"></i>
        Trang chủ
</a>
  </li>
        <li aria-current="page">
     <div class="flex items-center">
    <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Tài khoản</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-6 py-4 rounded-lg mb-6 animate__animated animate__fadeInDown" role="alert">
        <div class="flex items-center">
         <i class="fas fa-check-circle text-2xl mr-3"></i>
    <div>
              <strong class="font-bold">Thành công!</strong>
       <p class="text-sm">@TempData["SuccessMessage"]</p>
            </div>
        <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
     <i class="fas fa-times text-green-700 hover:text-green-900"></i>
</button>
     </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-6 py-4 rounded-lg mb-6 animate__animated animate__fadeInDown" role="alert">
        <div class="flex items-center">
   <i class="fas fa-exclamation-circle text-2xl mr-3"></i>
 <div>
        <strong class="font-bold">Lỗi!</strong>
        <p class="text-sm">@TempData["ErrorMessage"]</p>
            </div>
 <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
 <i class="fas fa-times text-red-700 hover:text-red-900"></i>
     </button>
        </div>
    </div>
}

<!-- Page Header -->
<div class="bg-gradient-to-r from-purple-500 to-indigo-500 rounded-lg shadow-lg p-6 mb-6 text-white">
    <div class="flex items-center">
        <div class="w-20 h-20 bg-white bg-opacity-20 rounded-full flex items-center justify-center mr-4">
            <i class="fas fa-user text-4xl"></i>
      </div>
     <div>
        <h1 class="text-3xl font-bold">@Model.HoTen</h1>
            <p class="text-lg opacity-90">@Model.Email</p>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Sidebar Menu (1/4) -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-md p-4 sticky top-4">
          <h3 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b">Quản lý tài khoản</h3>
  <nav class="space-y-2">
     <a href="@Url.Action("Index", "TaiKhoan")" class="flex items-center px-4 py-3 bg-blue-50 text-blue-600 rounded-lg font-semibold">
     <i class="fas fa-user-circle w-5 mr-3"></i>
 Thông tin tài khoản
        </a>
  <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="flex items-center px-4 py-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
    <i class="fas fa-key w-5 mr-3"></i>
        Đổi mật khẩu
  </a>
      <a href="@Url.Action("DonHang", "TaiKhoan")" class="flex items-center px-4 py-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
         <i class="fas fa-shopping-bag w-5 mr-3"></i>
  Đơn hàng của tôi
</a>
     <a href="@Url.Action("Logout", "Account")" class="flex items-center px-4 py-3 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
            <i class="fas fa-sign-out-alt w-5 mr-3"></i>
  Đăng xuất
             </a>
            </nav>
     </div>
    </div>

    <!-- Main Content (3/4) -->
    <div class="lg:col-span-3">
      <div class="bg-white rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b flex items-center">
         <i class="fas fa-user-edit mr-3 text-blue-600"></i>
                Thông tin cá nhân
            </h2>

          <form action="@Url.Action("CapNhat", "TaiKhoan")" method="post">
        @Html.AntiForgeryToken()

         <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
   <!-- Họ tên -->
    <div>
        <label class="block text-sm font-semibold text-gray-700 mb-2">
     Họ và tên <span class="text-red-500">*</span>
             </label>
        <input type="text" 
      name="hoTen" 
      value="@Model.HoTen"
        required
     class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
    </div>

         <!-- Email -->
              <div>
              <label class="block text-sm font-semibold text-gray-700 mb-2">
    Email <span class="text-red-500">*</span>
      </label>
             <input type="email" 
                name="email" 
      value="@Model.Email"
   required
               class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
        </div>
        </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
        <!-- Số điện thoại -->
   <div>
      <label class="block text-sm font-semibold text-gray-700 mb-2">
          Số điện thoại
   </label>
     <input type="tel" 
  name="soDienThoai" 
     value="@Model.SoDienThoai"
  class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all">
    </div>

              <!-- Tên đăng nhập (readonly) -->
           <div>
<label class="block text-sm font-semibold text-gray-700 mb-2">
       Tên đăng nhập
        </label>
     <input type="text" 
   value="@Model.TenDangNhap"
         readonly
     class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-gray-50 text-gray-600 cursor-not-allowed">
      </div>
       </div>

 <!-- Submit Button -->
<div class="flex items-center justify-between pt-4 border-t">
   <div class="text-sm text-gray-600">
   <i class="fas fa-info-circle mr-1"></i>
            <span class="text-red-500">*</span> Thông tin bắt buộc
         </div>
             <button type="submit" 
                class="bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white font-bold py-3 px-8 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5 flex items-center">
      <i class="fas fa-save mr-2"></i>
 Lưu thay đổi
 </button>
   </div>
            </form>
      </div>

      <!-- Account Stats -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
      <div class="bg-white rounded-lg shadow-md p-6 text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-3">
          <i class="fas fa-shopping-cart text-blue-600 text-2xl"></i>
            </div>
        <p class="text-3xl font-bold text-gray-900">@ViewBag.TongDonHang</p>
       <p class="text-sm text-gray-600 mt-1">Tổng đơn hàng</p>
    </div>
  <div class="bg-white rounded-lg shadow-md p-6 text-center">
        <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-3">
         <i class="fas fa-check-circle text-green-600 text-2xl"></i>
                </div>
  <p class="text-3xl font-bold text-gray-900">@ViewBag.DonHangHoanThanh</p>
                <p class="text-sm text-gray-600 mt-1">Đã hoàn thành</p>
      </div>
  <div class="bg-white rounded-lg shadow-md p-6 text-center">
        <div class="w-16 h-16 bg-orange-100 rounded-full flex items-center justify-center mx-auto mb-3">
   <i class="fas fa-clock text-orange-600 text-2xl"></i>
      </div>
     <p class="text-3xl font-bold text-gray-900">@ViewBag.DonHangDangXuLy</p>
   <p class="text-sm text-gray-600 mt-1">Đang xử lý</p>
 </div>
      </div>
    </div>
</div>

@section scripts {
<script>
    // Phone number formatting
    $('input[type="tel"]').on('input', function() {
        var value = $(this).val().replace(/\D/g, '');
  $(this).val(value);
    });

    // Auto-hide messages after 5 seconds
    setTimeout(function() {
        $('[role="alert"]').fadeOut('slow', function() {
       $(this).remove();
        });
    }, 5000);
</script>
}
