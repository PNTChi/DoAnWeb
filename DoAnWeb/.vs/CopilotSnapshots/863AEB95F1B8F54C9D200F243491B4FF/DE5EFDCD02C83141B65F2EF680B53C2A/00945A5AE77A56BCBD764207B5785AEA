@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

body {
    font-family: 'Inter', sans-serif;
}

.sidebar {
    position: fixed;
    top: 0;
    left: -300px;
    width: 300px;
    height: 100%;
    background-color: #ffffff;
    box-shadow: 2px 0 5px rgba(0,0,0,0.2);
    transition: left 0.3s ease-in-out;
    z-index: 1000;
    padding-top: 50px;
    padding-bottom: 50px;
    border-radius: 8px;
    overflow-y: auto;
}

    .sidebar.active {
        left: 0;
    }

.sidebar-header {
    padding: 1rem;
    border-bottom: 1px solid #e5e7eb;
    margin-bottom: 1rem;
}

.sidebar-menu a {
    display: flex;
    align-items: center;
    padding: 0.75rem 1rem;
    color: #1f2937;
    text-decoration: none;
    font-weight: 500;
    transition: background-color 0.2s;
    position: relative;
}

    .sidebar-menu a:hover {
        background-color: #f3f4f6;
        border-radius: 4px;
    }

.sidebar-menu i {
    margin-right: 0.75rem;
    width: 1.5rem;
    text-align: center;
}

.category-list {
    list-style: none;
    padding-left: 2rem;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease-in-out;
}

    .category-list.active {
        max-height: 300px;
    }

    .category-list li a {
        display: block;
        padding: 0.5rem 1rem;
        color: #4b5563;
        text-decoration: none;
        font-weight: 400;
    }

        .category-list li a:hover {
            color: #1f2937;
            background-color: #f3f4f6;
            border-radius: 4px;
        }

.sidebar-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgba(0,0,0,0.5);
    display: none;
    z-index: 999;
}

    .sidebar-overlay.active {
        display: block;
    }

/* CSS cho slider sản phẩm */
.product-slider {
    position: relative;
    overflow: hidden;
}

.product-slides {
    display: flex;
    transition: transform 0.5s ease-in-out;
}

.product-card {
    min-width: calc(20% - 12.8px); /* Điều chỉnh chiều rộng để bù cho gap (trên màn hình lớn 5 item) */
    flex-shrink: 0;
}

@media (max-width: 1280px) {
    .product-card {
        min-width: calc(25% - 12px); /* 4 items */
    }
}

@media (max-width: 1024px) {
    .product-card {
        min-width: calc(33.333% - 10.67px); /* 3 items */
    }
}

@media (max-width: 768px) {
    .product-card {
        min-width: calc(50% - 8px); /* 2 items */
    }
}

@media (max-width: 640px) {
    .product-card {
        min-width: 100%; /* 1 item */
    }
}

.slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(156, 163, 175, 0.7);
    color: white;
    border: none;
    padding: 10px;
    cursor: pointer;
    z-index: 10;
    border-radius: 9999px;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.3s;
}

    .slider-btn:hover {
        background: rgba(107, 114, 128, 0.8);
    }

.prev-btn {
    left: 10px;
}

.next-btn {
    right: 10px;
}

/* Thêm style cho banner slider */
#banner-slides-container {
    display: flex;
    transition: transform 0.7s ease-in-out;
}

.banner-slide {
    min-width: 100%;
    flex-shrink: 0;
}

