       <i class="fas fa-list-alt text-blue-600 mr-3"></i> Danh mục sản phẩm
   </h2>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
      @foreach (var danhMuc in Model.DanhMuc)
     {
      <a href="@Url.Action("Index", "SanPham", new { danhMucId = danhMuc.Id })" class="category-card bg-white rounded-lg shadow p-4 text-center transition duration-300 hover:shadow-2xl hover:bg-blue-50 transform hover:-translate-y-1">
  <div class="w-16 h-16 mx-auto mb-2">
   @if (!string.IsNullOrEmpty(danhMuc.Icon))
    {
      <i class="@danhMuc.Icon text-4xl text-blue-600"></i>
      }
else
         {
 <img src="https://placehold.co/80x80" alt="@danhMuc.TenDanhMuc" class="w-full h-full object-contain">
   }
</div>
   <p class="font-medium text-gray-800">@danhMuc.TenDanhMuc</p>
