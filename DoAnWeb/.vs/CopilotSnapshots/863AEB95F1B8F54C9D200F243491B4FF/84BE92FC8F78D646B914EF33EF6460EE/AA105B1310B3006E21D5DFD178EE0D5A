@model DoAnWeb.tb_DanhMuc

@* 
 Partial View: Template cho 1 menu item danh mục
 Có thể tái sử dụng cho mọi loại danh mục
*@

<!-- Danh mục: @Model.TenDanhMuc -->
<a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.Id })" class="toggle-category">
    @* Hiển thị icon nếu có *@
    @if (!string.IsNullOrEmpty(Model.Icon))
    {
        <i class="@Model.Icon"></i>
    }
    else
    {
        <i class="fas fa-tags"></i>
    }
    @Model.TenDanhMuc
</a>

<ul class="category-list">
<li>
     <a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.Id })">
          Tất cả @Model.TenDanhMuc
        </a>
    </li>
    <li>
        <a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.Id, loc = "moi" })">
 Sản phẩm mới
    </a>
    </li>
    <li>
<a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.Id, loc = "banchay" })">
     Bán chạy nhất
        </a>
    </li>
    <li>
        <a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.Id, giaMax = 5000000 })">
     Dưới 5 triệu
   </a>
    </li>
    <li>
        <a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.Id, giaMax = 10000000 })">
   Dưới 10 triệu
        </a>
    </li>
    @* Có thể thêm filter theo số lượng sản phẩm *@
    @if (Model.tb_SanPham != null && Model.tb_SanPham.Any())
  {
        <li class="text-xs text-gray-500 px-3 py-1">
   <i class="fas fa-box mr-1"></i>
            @Model.tb_SanPham.Count(sp => sp.HienThi == true) sản phẩm
        </li>
    }
</ul>
