<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Web bán thiết bị điện tử</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Đường dẫn CSS: Lưu ý dấu ~ để trỏ về thư mục gốc -->
    <link href="~/Content/Trang-Chu.css" rel="stylesheet" />
</head>
<body class="bg-gray-50">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
        <div class="container mx-auto px-4 py-3">
            <div class="flex items-center justify-between">
                <!-- Logo -->
                <div class="flex items-center">
                    <a href="@Url.Action("Index", "Home")" class="text-2xl font-bold text-blue-600 flex items-center">
                        <img src="~/Images/logo.png" alt="Logo" class="mr-2" style="max-height: 50px;" />
                    </a>
                </div>
                <!-- Search Bar -->
                <div class="flex-1 mx-8">
                    <div class="flex items-center justify-between">
                        <!-- Ô tìm kiếm -->
                        <div class="relative w-1/2">
                            <input type="text" placeholder="Tìm kiếm sản phẩm..."
                                   class="w-full py-2 px-4 border border-gray-300 rounded-full focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent">
                            <button class="absolute right-0 top-0 h-full px-4 text-gray-500 hover:text-blue-600">
                                <i class="fas fa-search"></i>
                            </button>
                        </div>
                        <!-- Menu -->
                        <div class="flex space-x-4 ml-8">
                            <a href="@Url.Action("Index", "Home")" class="px-4 py-3 font-medium hover:text-blue-600 focusable">TRANG CHỦ</a>
                            <a href="#" class="px-4 py-3 font-medium hover:text-blue-600 focusable">KHUYẾN MÃI</a>
                            <a href="#" class="px-4 py-3 font-medium hover:text-blue-600 focusable">TIN TỨC</a>
                            <a href="#" class="px-4 py-3 font-medium hover:text-blue-600 focusable">LIÊN HỆ</a>
                        </div>
                    </div>
                </div>
                <!-- Icon: User - Giỏ hàng -->
                <div class="flex items-center space-x-4 ">
                    <!--User-->
                    <a href="#" class="text-gray-700 hover:text-blue-600 p-2">
                        <i class="fas fa-user text-xl"></i>
                    </a>
                    <!--Giỏ hàng-->
                    <a href="#" class="text-gray-700 hover:text-blue-600 relative text-danger">
                        <i class="fas fa-shopping-cart text-xl"></i>
                        <!--<span class="absolute -top-2 -right-2 bg-red-500 text-white text-xs rounded-full w-5 h-5 flex items-center justify-center"></span>-->
                    </a>
                </div>
            </div>
        </div>
    </header>
    <!-- Category Navigation -  Danh mục sản phẩm trên đầu -->
    <nav class="bg-blue-600 text-white">
        <div class="container mx-auto px-4">
            <ul class="flex overflow-x-auto py-3 space-x-6">
                <li class="dropdown relative">
                    <a href="#" class="flex items-center hover:bg-blue-700 px-3 py-2 rounded whitespace-nowrap">
                        <i class=" mr-2"></i> Tablet
                    </a>
                </li>
                <li class="dropdown relative">
                    <a href="#" class="flex items-center hover:bg-blue-700 px-3 py-2 rounded whitespace-nowrap">
                        <i class="fas fa-phone mr-2"></i> Điện thoại
                    </a>
                </li>
                <li class="dropdown relative">
                    <a href="#" class="flex items-center hover:bg-blue-700 px-3 py-2 rounded whitespace-nowrap">
                        <i class="fas fa-laptop mr-2"></i> Laptop
                    </a>
                </li>
                <li class="dropdown relative">
                    <a href="#" class="flex items-center hover:bg-blue-700 px-3 py-2 rounded whitespace-nowrap">
                        <i class="fas fa-phone-alt mr-2"></i> Apple Watch
                    </a>
                </li>
                <li class="dropdown relative">
                    <a href="#" class="flex items-center hover:bg-blue-700 px-3 py-2 rounded whitespace-nowrap">
                        <i class="fas fa-tools mr-2"></i> Phụ kiện
                    </a>
                </li>
            </ul>
        </div>
    </nav>
    <!--Sidebar - Danh mục bên trái -->
    <div class="sidebar" id="sidebar">
        <div class="sidebar-header">
            <h1 class="text-xl font-bold text-center font-size-3">Danh mục</h1>
        </div>
        <div class="sidebar-menu">
            <a href="#" class="toggle-category"><i class="fas fa-mobile-alt"></i> Điện thoại</a>
            <ul class="category-list">
                <li><a href="#">Tất cả điện thoại</a></li>
                <li><a href="#">iPhone</a></li>
                <li><a href="#">Samsung</a></li>
                <li><a href="#">Xiaomi</a></li>
                <li><a href="#">Oppo</a></li>
                <li><a href="#">Dưới 5 triệu</a></li>
            </ul>
            <a href="#" class="toggle-category"><i class="fas fa-laptop"></i> Laptop</a>
            <ul class="category-list">
                <li><a href="#">Tất cả laptop</a></li>
                <li><a href="#">Dell</a></li>
                <li><a href="#">HP</a></li>
                <li><a href="#">MacBook</a></li>
                <li><a href="#">Laptop gaming</a></li>
                <li><a href="#">Dưới 15 triệu</a></li>
            </ul>
            <a href="#" class="toggle-category"><i class="fas fa-tablet-alt"></i> Tablet</a>
            <ul class="category-list">
                <li><a href="#">Tất cả tablet</a></li>
                <li><a href="#">Samsung</a></li>
                <li><a href="#">Apple iPad</a></li>
                <li><a href="#">Xiaomi</a></li>
                <li><a href="#">Tablet 10 inch</a></li>
                <li><a href="#">Dưới 10 triệu</a></li>
            </ul>
            <a href="#" class="toggle-category"><i class="fas fa-headphones"></i> Phụ kiện</a>
            <ul class="category-list">
                <li><a href="#">Tất cả phụ kiện</a></li>
                <li><a href="#">Tai nghe</a></li>
                <li><a href="#">Sạc và cáp</a></li>
                <li><a href="#">Ốp lưng</a></li>
                <li><a href="#">Thẻ nhớ</a></li>
                <li><a href="#">Dưới 500k</a></li>
            </ul>
        </div>
    </div>
    <!-- Lớp phủ mờ khi sidebar mở -->
    <div id="sidebarOverlay" class="sidebar-overlay fixed inset-0 bg-black bg-opacity-50 z-50 hidden"></div>
    <!-- Main Content -->
    <main class="container mx-auto px-4 py-6">
        <!-- Nút bật Sidebar cố định cho danh mục bên trái -->
        <div class="fixed top-1/3 -translate-y-1/2 left-0 z-30">
            <button id="sidebarToggle" class="w-10 h-16 rounded-r-lg bg-blue-600 text-white flex items-center justify-center shadow-lg hover:bg-blue-700 transition">
                <a href="#" class="fas fa-bars text-lg"></a>
            </button>
        </div>
        <!-- RenderBody: Nơi nội dung của từng trang con sẽ hiển thị ở đây -->
        @RenderBody()
    </main>
    <!-- Footer -->
    <footer class="bg-black text-white py-8">
        <div class="container mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                <div>
                    <h3 class="text-lg font-bold mb-4">THÔNG TIN LIÊN HỆ</h3>
                    <p class="mb-2"><i class="fas fa-map-marker-alt mr-2"></i> Tổng đài hỗ trợ: 1800.1060</p>
                    <p class="mb-2"><i class="fas fa-phone mr-2"></i> Hỗ trợ khách hàng: hỗ trợ@laptrinhweb.vn</p>
                    <p><i class="fas fa-envelope mr-2"></i> Liên hệ báo giá: baogia@doanlaptrinhweb.vn</p>
                </div>
                <div>
                    <h3 class="text-lg font-bold mb-4">VỀ ĐỒ ÁN LTW</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="hover:text-yellow-400 focusable">Giới thiệu đồ án</a></li>
                        <li><a href="#" class="hover:text-yellow-400 focusable">Tuyển dụng</a></li>
                        <li><a href="#" class="hover:text-yellow-400 focusable">Gửi góp ý, khiếu nại</a></li>
                        <li><a href="#" class="hover:text-yellow-400 focusable">Chính sách bảo mật</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-lg font-bold mb-4">HỖ TRỢ KHÁCH HÀNG</h3>
                    <ul class="space-y-2">
                        <li><a href="#" class="hover:text-yellow-400 focusable">Hướng dẫn mua hàng online</a></li>
                        <li><a href="#" class="hover:text-yellow-400 focusable">Chính sách bảo hành</a></li>
                        <li><a href="#" class="hover:text-yellow-400 focusable">Chính sách đổi trả</a></li>
                        <li><a href="#" class="hover:text-yellow-400 focusable">Câu hỏi thường gặp</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-lg font-bold mb-4">KẾT NỐI VỚI CHÚNG TÔI</h3>
                    <div class="flex space-x-4 mb-4">
                        <a href="#" class="text-2xl hover:text-yellow-400 focusable" aria-label="Facebook"><i class="fab fa-facebook"></i></a>
                        <a href="#" class="text-2xl hover:text-yellow-400 focusable" aria-label="YouTube"><i class="fab fa-youtube"></i></a>
                        <a href="#" class="text-2xl hover:text-yellow-400 focusable" aria-label="Instagram"><i class="fab fa-instagram"></i></a>
                        <a href="#" class="text-2xl hover:text-yellow-400 focusable" aria-label="TikTok"><i class="fab fa-tiktok"></i></a>
                    </div>
                    <h4 class="text-lg font-bold mb-2">ĐĂNG KÝ NHẬN BẢN TIN</h4>
                    <div class="flex">
                        <input type="email" placeholder="Email của bạn" class="px-3 py-2 text-black w-full rounded-l focusable" aria-label="Đăng ký nhận bản tin">
                        <button class="bg-yellow-400 hover:bg-yellow-500 text-black px-4 py-2 rounded-r focusable" aria-label="Gửi">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
            <div class="border-t border-gray-700 mt-8 pt-6 text-center text-gray-400">
                <p>© 2025 Đồ án lập trình Web. GPDKKD: do Trường DH Công Thương TP.HCM & Phòng GD và DT cấp ngày 24/08/2025.</p>
                <p>GP: 238/GP-BTTTT do Khoa công nghệ thông tin cấp ngày 01/09/2023.</p>
            </div>
        </div>
    </footer>
    <!-- 3 cái Icon  -->
    <div class="fixed bottom-6 right-3 z-40">
        <div class="flex flex-col space-y-3">
            <a href="#" class="w-12 h-12 rounded-full bg-green-500 text-white flex items-center justify-center shadow-lg hover:bg-green-600 transition">
                <i class="fab fa-facebook-messenger text-xl"></i>
            </a>
            <a href="#" class="w-12 h-12 rounded-full bg-blue-600 text-white flex items-center justify-center shadow-lg hover:bg-blue-700 transition">
                <i class="fas fa-phone-alt"></i>
            </a>
            <a href="#" class="w-12 h-12 rounded-full bg-red-500 text-white flex items-center justify-center shadow-lg hover:bg-red-600 transition">
                <i class="fas fa-shopping-cart"></i>
            </a>
        </div>
    </div>
    <!-- Javascript -->
    <script src="~/Content/Trang-Chu.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>