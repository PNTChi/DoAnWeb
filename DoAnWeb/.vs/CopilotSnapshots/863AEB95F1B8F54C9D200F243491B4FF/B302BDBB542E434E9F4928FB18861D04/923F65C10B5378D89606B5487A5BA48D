using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;

namespace DoAnWeb.Controllers
{
    /// <summary>
  /// Controller xử lý các chức năng liên quan đến Menu và Danh mục
    /// </summary>
    public class MenuController : Controller
    {
        // Khởi tạo DbContext để truy vấn database
private WebBanHangDienTuEntities db = new WebBanHangDienTuEntities();

  /// <summary>
     /// Action trả về Partial View danh mục sản phẩm cho Sidebar
    /// Được gọi từ _Layout.cshtml bằng @Html.Action()
        /// </summary>
        /// <returns>PartialView với danh sách danh mục</returns>
        [ChildActionOnly] // Chỉ cho phép gọi từ View khác, không truy cập trực tiếp qua URL
        public ActionResult DanhMuc()
        {
     // Lấy tất cả danh mục đang hiển thị, sắp xếp theo thứ tự
   var danhSachDanhMuc = db.tb_DanhMuc
   .Where(dm => dm.HienThi == true)
      .OrderBy(dm => dm.ThuTu)
   .ToList();

  // Trả về PartialView với danh sách danh mục
return PartialView("_DanhMuc", danhSachDanhMuc);
        }

 /// <summary>
        /// Giải phóng tài nguyên khi controller bị hủy
        /// </summary>
        protected override void Dispose(bool disposing)
  {
            if (disposing)
            {
  db.Dispose();
       }
   base.Dispose(disposing);
        }
    }
}
