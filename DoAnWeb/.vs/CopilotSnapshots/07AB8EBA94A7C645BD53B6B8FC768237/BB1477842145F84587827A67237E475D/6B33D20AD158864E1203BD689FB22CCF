@model DoAnWeb.tb_DonHang
@{
    ViewBag.Title = "Chi tiết đơn hàng #" + Model.MaDonHang;
    var chiTiet = ViewBag.ChiTiet as List<DoAnWeb.Models.ChiTietDonHangViewModel>;
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        <li>
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <a href="@Url.Action("Index", "TaiKhoan")" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                    Tài khoản
                </a>
            </div>
        </li>
        <li>
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <a href="@Url.Action("DonHang", "TaiKhoan")" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                    Đơn hàng
                </a>
            </div>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Chi tiết</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Page Title -->
<div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-file-invoice mr-3 text-blue-600"></i>
        Đơn hàng #@Model.MaDonHang
    </h1>
    
    @{
        string statusClass = "bg-yellow-100 text-yellow-800";
        string statusText = "Chờ xác nhận";
        string statusIcon = "fa-clock";
        
        switch (Model.TrangThai)
        {
            case 1:
                statusClass = "bg-orange-100 text-orange-800";
                statusText = "Chờ xác nhận";
                statusIcon = "fa-clock";
                break;
            case 2:
                statusClass = "bg-blue-100 text-blue-800";
                statusText = "Đã xác nhận";
                statusIcon = "fa-check-circle";
                break;
            case 3:
                statusClass = "bg-purple-100 text-purple-800";
                statusText = "Đang giao hàng";
                statusIcon = "fa-shipping-fast";
                break;
            case 4:
                statusClass = "bg-green-100 text-green-800";
                statusText = "Đã giao hàng";
                statusIcon = "fa-check-double";
                break;
            case 5:
                statusClass = "bg-red-100 text-red-800";
                statusText = "Đã hủy";
                statusIcon = "fa-times-circle";
                break;
        }
    }
    
    <span class="@statusClass px-4 py-2 rounded-full text-sm font-semibold">
        <i class="fas @statusIcon mr-1"></i>
        @statusText
    </span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Main Content (2/3 width) -->
    <div class="lg:col-span-2 space-y-6">
        <!-- Order Items -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-3 border-b flex items-center">
                <i class="fas fa-shopping-bag mr-3 text-orange-600"></i>
                Sản phẩm đã đặt
            </h2>

            <div class="space-y-4">
                @if (chiTiet != null && chiTiet.Any())
                {
                    foreach (var item in chiTiet)
                    {
                        <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg">
                            @if (!string.IsNullOrEmpty(item.HinhAnh))
                            {
                                <img src="@Url.Content("~/Content/Images/" + item.HinhAnh)" 
                                     alt="@item.TenSanPham" 
                                     class="w-20 h-20 object-contain rounded border border-gray-200" />
                            }
                            else
                            {
                                <img src="@Url.Content("~/Content/Images/no-image.png")" 
                                     alt="No Image" 
                                     class="w-20 h-20 object-contain rounded border border-gray-200" />
                            }

                            <div class="flex-1">
                                <h3 class="font-semibold text-gray-900 mb-1">@item.TenSanPham</h3>
                                <div class="flex items-center justify-between mt-2">
                                    <p class="text-sm text-gray-700">
                                        <span class="font-semibold">@String.Format("{0:0,0}", item.Gia) ₫</span>
                                        <span class="text-gray-500"> x @item.SoLuong</span>
                                    </p>
                                    <p class="text-lg font-bold text-blue-600">
                                        @String.Format("{0:0,0}", item.ThanhTien) ₫
                                    </p>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-8 text-gray-500">
                        <i class="fas fa-inbox text-4xl mb-2"></i>
                        <p>Không có sản phẩm nào</p>
                    </div>
                }
            </div>
        </div>

        <!-- Order Timeline -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-3 border-b flex items-center">
                <i class="fas fa-history mr-3 text-purple-600"></i>
                Lịch sử đơn hàng
            </h2>

            <div class="space-y-4">
                <!-- Created -->
                <div class="flex items-start">
                    <div class="flex-shrink-0">
                        <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                            <i class="fas fa-check text-green-600"></i>
                        </div>
                    </div>
                    <div class="ml-4 flex-1">
                        <p class="font-semibold text-gray-900">Đơn hàng đã được tạo</p>
                        <p class="text-sm text-gray-600">@(Model.NgayTao.HasValue ? Model.NgayTao.Value.ToString("HH:mm:ss - dd/MM/yyyy") : "N/A")</p>
                    </div>
                </div>

                <!-- Processing -->
                @if (Model.TrangThai >= 2)
                {
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-blue-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-blue-600"></i>
                            </div>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">Đơn hàng đã được xác nhận</p>
                            <p class="text-sm text-gray-600">@(Model.NgayCapNhat?.ToString("HH:mm:ss - dd/MM/yyyy") ?? "Đang cập nhật...")</p>
                        </div>
                    </div>
                }

                <!-- Shipping -->
                @if (Model.TrangThai >= 3)
                {
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-purple-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-purple-600"></i>
                            </div>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">Đơn hàng đang được giao</p>
                            <p class="text-sm text-gray-600">Đang vận chuyển...</p>
                        </div>
                    </div>
                }

                <!-- Delivered -->
                @if (Model.TrangThai == 4)
                {
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-green-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-check text-green-600"></i>
                            </div>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">Đơn hàng đã được giao thành công</p>
                            <p class="text-sm text-gray-600">Hoàn tất</p>
                        </div>
                    </div>
                }

                <!-- Cancelled -->
                @if (Model.TrangThai == 5)
                {
                    <div class="flex items-start">
                        <div class="flex-shrink-0">
                            <div class="w-10 h-10 bg-red-100 rounded-full flex items-center justify-center">
                                <i class="fas fa-times text-red-600"></i>
                            </div>
                        </div>
                        <div class="ml-4 flex-1">
                            <p class="font-semibold text-gray-900">Đơn hàng đã bị hủy</p>
                            <p class="text-sm text-gray-600">@(Model.NgayCapNhat?.ToString("HH:mm:ss - dd/MM/yyyy") ?? "N/A")</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Sidebar (1/3 width) -->
    <div class="space-y-6">
        <!-- Customer Information -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-3 border-b flex items-center">
                <i class="fas fa-user mr-3 text-blue-600"></i>
                Thông tin nhận hàng
            </h2>

            <div class="space-y-3 text-sm">
                <div class="flex items-start">
                    <i class="fas fa-user-circle text-gray-400 mr-3 mt-1"></i>
                    <div>
                        <p class="text-gray-600">Họ tên</p>
                        <p class="font-semibold text-gray-900">@Model.TenKhachHang</p>
                    </div>
                </div>

                <div class="flex items-start">
                    <i class="fas fa-phone text-gray-400 mr-3 mt-1"></i>
                    <div>
                        <p class="text-gray-600">Số điện thoại</p>
                        <p class="font-semibold text-gray-900">@Model.SoDienThoai</p>
                    </div>
                </div>

                <div class="flex items-start">
                    <i class="fas fa-envelope text-gray-400 mr-3 mt-1"></i>
                    <div>
                        <p class="text-gray-600">Email</p>
                        <p class="font-semibold text-gray-900">@Model.Email</p>
                    </div>
                </div>

                <div class="flex items-start">
                    <i class="fas fa-map-marker-alt text-gray-400 mr-3 mt-1"></i>
                    <div>
                        <p class="text-gray-600">Địa chỉ giao hàng</p>
                        <p class="font-semibold text-gray-900">@Model.DiaChi</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Order Summary -->
        <div class="bg-white rounded-lg shadow-md p-6">
            <h2 class="text-xl font-bold text-gray-900 mb-4 pb-3 border-b flex items-center">
                <i class="fas fa-receipt mr-3 text-green-600"></i>
                Tổng thanh toán
            </h2>

            <div class="space-y-3">
                <div class="flex justify-between text-gray-700">
                    <span>Tạm tính:</span>
                    <span class="font-semibold">@String.Format("{0:0,0}", Model.TongTien) ₫</span>
                </div>

                <div class="flex justify-between text-gray-700">
                    <span>Phí vận chuyển:</span>
                    <span class="font-semibold text-green-600">Miễn phí</span>
                </div>

                <div class="border-t pt-3">
                    <div class="flex justify-between items-center">
                        <span class="text-lg font-bold text-gray-900">Tổng cộng:</span>
                        <span class="text-2xl font-bold text-red-600">
                            @String.Format("{0:0,0}", Model.TongTien) ₫
                        </span>
                    </div>
                </div>

                <div class="pt-3 border-t">
                    <p class="text-sm text-gray-600">
                        <i class="fas fa-wallet mr-2 text-blue-600"></i>
                        <strong>Phương thức thanh toán:</strong><br>
                        <span class="ml-6">
                            @{
                                var paymentMethod = "Thanh toán khi nhận hàng";
                                switch (Model.LoaiThanhToan)
                                {
                                    case 1: paymentMethod = "Thanh toán khi nhận hàng (COD)"; break;
                                    case 2: paymentMethod = "Chuyển khoản ngân hàng"; break;
                                    case 3: paymentMethod = "Ví điện tử MoMo"; break;
                                    case 4: paymentMethod = "Ví điện tử ZaloPay"; break;
                                    case 5: paymentMethod = "Thẻ tín dụng/Ghi nợ"; break;
                                }
                            }
                            @paymentMethod
                        </span>
                    </p>
                </div>
            </div>
        </div>

        <!-- Actions -->
        @if (Model.TrangThai <= 2)
        {
            <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
                <p class="text-sm text-yellow-800 mb-3">
                    <i class="fas fa-info-circle mr-2"></i>
                    Bạn có thể hủy đơn hàng nếu chưa được giao
                </p>
                <button onclick="huyDonHang(@Model.Id)" class="w-full bg-red-600 hover:bg-red-700 text-white font-semibold py-2 px-4 rounded-lg transition-colors">
                    <i class="fas fa-times-circle mr-2"></i>
                    Hủy đơn hàng
                </button>
            </div>
        }

        <div class="bg-white rounded-lg shadow-md p-4">
            <a href="@Url.Action("DonHang", "TaiKhoan")" class="flex items-center justify-center text-blue-600 hover:text-blue-700 font-semibold">
                <i class="fas fa-arrow-left mr-2"></i>
                Quay lại danh sách đơn hàng
            </a>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    @Html.AntiForgeryToken()
    
    function huyDonHang(orderId) {
        Swal.fire({
            title: 'Xác nhận hủy đơn hàng?',
            text: 'Bạn có chắc chắn muốn hủy đơn hàng này không?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Hủy đơn hàng',
            cancelButtonText: 'Không'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("HuyDonHang", "TaiKhoan")',
                    type: 'POST',
                    data: {
                        id: orderId,
                        __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi hủy đơn hàng', 'error');
                    }
                });
            }
        });
    }
</script>
}
