        /// <summary>
        /// GET: Danh sách ??n hàng
        /// </summary>
        public ActionResult DonHang(int page = 1, int pageSize = 10)
        {
   if (!IsAuthenticated)
          {
        return RedirectToAction("Login", "Account");
        }

            var query = db.tb_DonHang
                .Where(dh => dh.TaiKhoanId == CurrentUser.Id)
    .OrderByDescending(dh => dh.NgayTao);

       // Pagination
            var totalOrders = query.Count();
      var totalPages = (int)Math.Ceiling((double)totalOrders / pageSize);
            ViewBag.CurrentPage = page;
    ViewBag.TotalPages = totalPages;
  ViewBag.TotalOrders = totalOrders;

   var orders = query
         .Skip((page - 1) * pageSize)
         .Take(pageSize)
   .ToList();

   return View(orders);
      }

        /// <summary>
        /// GET: Chi tiết đơn hàng
        /// </summary>
        public ActionResult ChiTietDonHang(int id)
        {
            if (!IsAuthenticated)
            {
                return RedirectToAction("Login", "Account");
            }

            var donHang = db.tb_DonHang
                .FirstOrDefault(dh => dh.Id == id && dh.TaiKhoanId == CurrentUser.Id);

            if (donHang == null)
            {
                TempData["ErrorMessage"] = "Không tìm thấy đơn hàng";
                return RedirectToAction("DonHang");
            }

            // Lấy chi tiết đơn hàng kèm thông tin sản phẩm
            var chiTiet = db.tb_ChiTietDonHang
                .Where(ct => ct.DonHangId == id)
                .Select(ct => new ChiTietDonHangViewModel
                {
                    SanPhamId = ct.SanPhamId,
                    TenSanPham = ct.tb_SanPham.TenSanPham,
                    HinhAnh = ct.tb_SanPham.HinhAnh,
                    SoLuong = ct.SoLuong,
                    Gia = ct.Gia,
                    ThanhTien = ct.SoLuong * ct.Gia
                })
                .ToList();

            ViewBag.ChiTiet = chiTiet;

            return View(donHang);
        }

        /// <summary>
        /// POST: H?y ??n hàng
        /// </summary>
    [HttpPost]
 [ValidateAntiForgeryToken]
     public JsonResult HuyDonHang(int id)
        {
       if (!IsAuthenticated)
{
      return Json(new { success = false, message = "Vui lòng ??ng nh?p" });
            }

     try
            {
       var donHang = db.tb_DonHang
     .FirstOrDefault(dh => dh.Id == id && dh.TaiKhoanId == CurrentUser.Id);

       if (donHang == null)
              {
                    return Json(new { success = false, message = "Không tìm th?y ??n hàng" });
                }

         // Ch? cho phép h?y ??n hàng ? tr?ng thái "Ch? xác nh?n" ho?c "?ã xác nh?n"
  if (donHang.TrangThai > 2)
             {
      return Json(new { success = false, message = "Không th? h?y ??n hàng này" });
        }

    // C?p nh?t tr?ng thái
       donHang.TrangThai = 5; // 5 = ?ã h?y
    donHang.NgayCapNhat = DateTime.Now;

         // Hoàn l?i s? l??ng s?n ph?m
       var chiTiet = db.tb_ChiTietDonHang.Where(ct => ct.DonHangId == id).ToList();
             foreach (var item in chiTiet)
       {
  var sanPham = db.tb_SanPham.Find(item.SanPhamId);
             if (sanPham != null && sanPham.SoLuong.HasValue)
  {
          sanPham.SoLuong += item.SoLuong;
             }
            }

          db.SaveChanges();

        return Json(new { success = true, message = "H?y ??n hàng thành công" });
          }
       catch (Exception ex)
            {
    return Json(new { success = false, message = "Có l?i x?y ra. Vui lòng th? l?i sau." });
