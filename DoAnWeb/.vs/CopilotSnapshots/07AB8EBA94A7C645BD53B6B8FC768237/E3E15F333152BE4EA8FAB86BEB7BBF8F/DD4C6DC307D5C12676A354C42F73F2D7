
@{
    ViewBag.Title = "TongQuan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div id="dashboard" class="tab-content active">
    <h1 class="mb-4">Bảng điều khiển</h1>
    <div class="row">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card bg-primary shadow"><div class="icon"><i class="fas fa-dollar-sign"></i></div><div class="info"><h3 id="totalRevenue">0</h3><p>Tổng doanh thu</p></div></div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card bg-success shadow"><div class="icon"><i class="fas fa-shopping-cart"></i></div><div class="info"><h3 id="totalOrders">0</h3><p>Tổng đơn hàng</p></div></div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card bg-info shadow"><div class="icon"><i class="fas fa-users"></i></div><div class="info"><h3 id="totalCustomers">0</h3><p>Tổng khách hàng</p></div></div>
        </div>
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="stat-card bg-warning shadow"><div class="icon"><i class="fas fa-box-open"></i></div><div class="info"><h3 id="totalProducts">0</h3><p>Sản phẩm trong kho</p></div></div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm"><div class="card-header">Doanh thu 6 tháng gần nhất</div><div class="card-body"><canvas id="dashboardRevenueChart"></canvas></div></div>
        </div>
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm"><div class="card-header">Sản phẩm bán chạy</div><div class="card-body"><canvas id="dashboardTopProductsChart"></canvas></div></div>
        </div>
    </div>
</div>