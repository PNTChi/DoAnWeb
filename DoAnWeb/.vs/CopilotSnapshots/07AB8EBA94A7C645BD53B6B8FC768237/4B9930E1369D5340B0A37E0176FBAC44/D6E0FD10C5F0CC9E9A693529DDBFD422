        // POST: Sửa sản phẩm
        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult SuaSP(QLSP sp, HttpPostedFileBase fileupload, decimal? GiaMoi)
        {
            try
            {
                var sanPham = db.tb_SanPham.Find(sp.Id);
                if (sanPham == null)
                {
                    return HttpNotFound();
                }

                // Cập nhật thông tin cơ bản
                sanPham.TenSanPham = sp.TenSanPham;
                sanPham.BiDanh = sp.BiDanh;
                sanPham.MaSanPham = sp.MaSanPham;
                sanPham.MoTa = sp.MoTa;
                sanPham.ChiTiet = sp.ChiTiet;
                sanPham.SoLuong = sp.SoLuong;
                sanPham.LuotXem = sp.LuotXem;
                sanPham.DanhMucId = sp.DanhMucId;
                sanPham.ThuongHieuId = sp.ThuongHieuId;
                sanPham.NgayCapNhat = DateTime.Now;

                // Logic giá mới:
                // - Nếu GiaMoi khác giá hiện tại (Gia hoặc GiaKhuyenMai)
                // - Thì giá cũ chuyển thành Gia (giá gốc)
                // - Và GiaMoi trở thành GiaKhuyenMai
                if (GiaMoi.HasValue)
                {
                    var giaHienTai = sanPham.GiaKhuyenMai ?? sanPham.Gia;
                    
                    if (GiaMoi.Value != giaHienTai)
                    {
                        // Giá cũ (hiện tại) trở thành giá gốc nếu chưa có
                        if (!sanPham.GiaKhuyenMai.HasValue)
                        {
                            // Trường hợp chưa có khuyến mãi: Gia giữ nguyên, GiaMoi thành GiaKhuyenMai
                            sanPham.GiaKhuyenMai = GiaMoi.Value;
                        }
                        else
                        {
                            // Trường hợp đã có khuyến mãi: GiaKhuyenMai cũ thành Gia, GiaMoi thành GiaKhuyenMai mới
                            sanPham.Gia = sanPham.GiaKhuyenMai.Value;
                            sanPham.GiaKhuyenMai = GiaMoi.Value;
                        }
                    }
                }
                // Nếu không có GiaMoi, giữ nguyên giá

                // Xử lý upload ảnh mới (nếu có)
                if (fileupload != null && fileupload.ContentLength > 0)
                {
                    // Xóa ảnh cũ
                    if (!string.IsNullOrEmpty(sanPham.HinhAnh))
                    {
                        var oldImagePath = Path.Combine(Server.MapPath("~/Content/Images"), sanPham.HinhAnh);
                        if (System.IO.File.Exists(oldImagePath))
                        {
                            System.IO.File.Delete(oldImagePath);
                        }
                    }

                    // Lưu ảnh mới
                    var filename = Path.GetFileName(fileupload.FileName);
                    var path = Path.Combine(Server.MapPath("~/Content/Images"), filename);
                    
                    if (System.IO.File.Exists(path))
                    {
                        filename = DateTime.Now.Ticks + "_" + filename;
                        path = Path.Combine(Server.MapPath("~/Content/Images"), filename);
                    }
                    
                    fileupload.SaveAs(path);
                    sanPham.HinhAnh = filename;
                }

                // Cập nhật thông số kỹ thuật
                // Xóa thông số cũ
                var oldThongSo = db.tb_ThongSo.Where(ts => ts.SanPhamId == sp.Id).ToList();
                db.tb_ThongSo.RemoveRange(oldThongSo);

                // Thêm thông số mới
                var thongSoList = new List<tb_ThongSo>();
                
                if (!string.IsNullOrEmpty(sp.BoNhoRAM))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Bộ nhớ RAM", GiaTri = sp.BoNhoRAM, ThuTu = 1 });
                
                if (!string.IsNullOrEmpty(sp.BoNhoTrong))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Bộ nhớ trong", GiaTri = sp.BoNhoTrong, ThuTu = 2 });
                
                if (!string.IsNullOrEmpty(sp.ManHinh))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Màn hình", GiaTri = sp.ManHinh, ThuTu = 3 });
                
                if (!string.IsNullOrEmpty(sp.DungLuongPin))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Dung lượng pin", GiaTri = sp.DungLuongPin, ThuTu = 4 });
                
                if (!string.IsNullOrEmpty(sp.Camera))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Camera", GiaTri = sp.Camera, ThuTu = 5 });
                
                if (!string.IsNullOrEmpty(sp.HeDieuHanh))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Hệ điều hành", GiaTri = sp.HeDieuHanh, ThuTu = 6 });
                
                if (!string.IsNullOrEmpty(sp.CongKetNoi))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Cổng kết nối", GiaTri = sp.CongKetNoi, ThuTu = 7 });

                if (thongSoList.Any())
                {
                    db.tb_ThongSo.AddRange(thongSoList);
                }

                db.SaveChanges();

                TempData["SuccessMessage"] = "Cập nhật sản phẩm thành công!";
                return RedirectToAction("QLSP");
            }
            catch (Exception ex)
            {
                ViewBag.ThongBao = "Có lỗi xảy ra: " + ex.Message;
                ViewBag.lstDMSP = new SelectList(db.tb_DanhMuc.ToList(), "Id", "TenDanhMuc", sp.DanhMucId);
                ViewBag.lstTH = new SelectList(db.tb_ThuongHieu.ToList(), "Id", "TenThuongHieu", sp.ThuongHieuId);
                return View("formSuaSP", sp);
            }
        }

        // GET: Xóa sản phẩm
        public ActionResult XoaSP(int id)
        {
            try
            {
                var sanPham = db.tb_SanPham.Find(id);
                if (sanPham == null)
                {
                    TempData["ErrorMessage"] = "Không tìm thấy sản phẩm!";
                    return RedirectToAction("QLSP");
                }

                // Xóa thông số kỹ thuật liên quan
                var thongSo = db.tb_ThongSo.Where(ts => ts.SanPhamId == id).ToList();
                db.tb_ThongSo.RemoveRange(thongSo);

                // Xóa ảnh sản phẩm từ thư mục (nếu có)
                if (!string.IsNullOrEmpty(sanPham.HinhAnh))
                {
                    var imagePath = Path.Combine(Server.MapPath("~/Content/Images"), sanPham.HinhAnh);
                    if (System.IO.File.Exists(imagePath))
                    {
                        System.IO.File.Delete(imagePath);
                    }
                }

                // Xóa sản phẩm
                db.tb_SanPham.Remove(sanPham);
                db.SaveChanges();

                TempData["SuccessMessage"] = "Xóa sản phẩm thành công!";
            }
            catch (Exception ex)
            {
                TempData["ErrorMessage"] = "Có lỗi xảy ra khi xóa sản phẩm: " + ex.Message;
            }

            return RedirectToAction("QLSP");
        }











        public ActionResult TimKiemSP(string timsp, int page = 1)
        {
            int pageSize = 5;

            // 1. Khởi tạo truy vấn từ bảng tb_SanPham
            var query = db.tb_SanPham.AsQueryable();

            if (!String.IsNullOrEmpty(timsp))
            {
                // 2. Lọc sản phẩm theo Tên Sản phẩm HOẶC Mã Sản phẩm
                string keyword = timsp.ToLower();
                query = query.Where(sp =>
                    sp.TenSanPham.ToLower().Contains(keyword) ||
                    sp.MaSanPham.ToLower().Contains(keyword)
                );
            }

            // 3. Xử lý phân trang
            int totalItems = query.Count();
            int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

            // 4. Phân trang, sắp xếp và chiếu dữ liệu sang View Model QLSP
            var lstsp = query
                .OrderBy(sp => sp.Id)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(sp => new QLSP
                { 
                    Id = sp.Id,
                    TenSanPham = sp.TenSanPham,
                    BiDanh = sp.BiDanh,
                    MaSanPham = sp.MaSanPham,
                    MoTa = sp.MoTa,
                    ChiTiet = sp.ChiTiet,
                    Gia = sp.Gia,
                    GiaKhuyenMai = sp.GiaKhuyenMai,
                    SoLuong = sp.SoLuong ?? 0,
                    LuotXem = sp.LuotXem ?? 0,

                    HinhAnh = sp.HinhAnh,
                    // Các thuộc tính liên kết
                    // Lấy Hình Ảnh
                    //DsHinhAnh = sp.tb_AnhSanPham.OrderBy(ha => ha.Id).Select(ha => ha.HinhAnh).ToList(),

                    TenDanhMuc = sp.tb_DanhMuc.TenDanhMuc,
