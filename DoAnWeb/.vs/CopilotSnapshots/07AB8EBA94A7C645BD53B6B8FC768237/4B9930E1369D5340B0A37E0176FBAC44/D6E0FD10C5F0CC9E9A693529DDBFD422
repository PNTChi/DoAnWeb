        // GET: Admin - Tổng quan
        public ActionResult TongQuan()
        {
            // Tính tổng doanh thu
            var totalRevenue = db.tb_DonHang
                .Where(d => d.TrangThai == 3 || d.TrangThai == 4) // Đã giao hoặc Hoàn thành
                .Sum(d => (decimal?)d.TongTien) ?? 0;

            // Tính tổng đơn hàng
            var totalOrders = db.tb_DonHang.Count();

            // Tính tổng khách hàng
            var totalCustomers = db.tb_TaiKhoan
                .Count(t => t.LaQuanTri == false);

            // Tính tổng sản phẩm trong kho
            var totalProducts = db.tb_SanPham
                .Sum(s => (int?)s.SoLuong) ?? 0;

            // Doanh thu 6 tháng gần nhất
            var sixMonthsAgo = DateTime.Now.AddMonths(-6);
            var revenueByMonth = db.tb_DonHang
                .Where(d => d.NgayTao >= sixMonthsAgo && (d.TrangThai == 3 || d.TrangThai == 4))
                .GroupBy(d => new { d.NgayTao.Value.Year, d.NgayTao.Value.Month })
                .Select(g => new
                {
                    Year = g.Key.Year,
                    Month = g.Key.Month,
                    Revenue = g.Sum(d => d.TongTien)
                })
                .OrderBy(x => x.Year).ThenBy(x => x.Month)
                .ToList();

            // Top 5 sản phẩm bán chạy
            var topProducts = db.tb_ChiTietDonHang
                .GroupBy(ct => ct.SanPhamId)
                .Select(g => new
                {
                    ProductId = g.Key,
                    TotalQuantity = g.Sum(ct => ct.SoLuong),
                    ProductName = db.tb_SanPham.FirstOrDefault(s => s.Id == g.Key).TenSanPham
                })
                .OrderByDescending(x => x.TotalQuantity)
                .Take(5)
                .ToList();

            // Đơn hàng gần đây
            var recentOrders = db.tb_DonHang
                .OrderByDescending(d => d.NgayTao)
                .Take(10)
                .Select(d => new RecentOrderViewModel
                {
                    Id = d.Id,
                    MaDonHang = d.MaDonHang,
                    TenKhachHang = d.TenKhachHang,
                    TongTien = d.TongTien,
                    TrangThai = d.TrangThai,
                    NgayTao = d.NgayTao
                })
                .ToList();

            ViewBag.TotalRevenue = totalRevenue;
            ViewBag.TotalOrders = totalOrders;
            ViewBag.TotalCustomers = totalCustomers;
            ViewBag.TotalProducts = totalProducts;
            ViewBag.RevenueByMonth = revenueByMonth;
            ViewBag.TopProducts = topProducts;
            ViewBag.RecentOrders = recentOrders;

            return View();
        }
        public ActionResult QLSP(int page = 1)
        {
            // 1. Khai báo phân trang
            int pageSize = 5; // Số sản phẩm mỗi trang

            // 2. Truy vấn dữ liệu sản phẩm, phân trang và chiếu sang View Model
            var lstsp = db.tb_SanPham
                .OrderBy(sp => sp.Id) // Sắp xếp để phân trang ổn định
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(sp => new QLSP
                {
                    // Các thuộc tính cơ bản
                    Id = sp.Id,
                    TenSanPham = sp.TenSanPham,
                    BiDanh = sp.BiDanh,
                    MaSanPham = sp.MaSanPham,
                    MoTa = sp.MoTa,
                    ChiTiet = sp.ChiTiet,
                    Gia = sp.Gia,
                    GiaKhuyenMai = sp.GiaKhuyenMai,
                    // Sử dụng ?? 0 cho các cột nullable (theo CSDL của bạn, SoLuong, LuotXem có DEFAULT 0)
                    SoLuong = sp.SoLuong ?? 0,
                    LuotXem = sp.LuotXem ?? 0,

                    HinhAnh = sp.HinhAnh,
                    // Các thuộc tính liên kết
                    // Lấy HinhAnh chính (của Sản phẩm) hoặc Ảnh đầu tiên từ tb_AnhSanPham
                    //DsHinhAnh = sp.tb_AnhSanPham.OrderBy(ha => ha.Id).Select(ha => ha.HinhAnh).ToList(),

                    TenDanhMuc = sp.tb_DanhMuc.TenDanhMuc,
                    TenThuongHieu = sp.tb_ThuongHieu.TenThuongHieu,

                    // Thông số
                    BoNhoRAM = sp.tb_ThongSo.Where(ts => ts.ThuTu == 1).Select(ts => ts.GiaTri).FirstOrDefault(),
                    BoNhoTrong = sp.tb_ThongSo.Where(ts => ts.ThuTu == 2).Select(ts => ts.GiaTri).FirstOrDefault(),
                    ManHinh = sp.tb_ThongSo.Where(ts => ts.ThuTu == 3).Select(ts => ts.GiaTri).FirstOrDefault(),
                    DungLuongPin = sp.tb_ThongSo.Where(ts => ts.ThuTu == 4).Select(ts => ts.GiaTri).FirstOrDefault(),
                    Camera = sp.tb_ThongSo.Where(ts => ts.ThuTu == 5).Select(ts => ts.GiaTri).FirstOrDefault(),
                    HeDieuHanh = sp.tb_ThongSo.Where(ts => ts.ThuTu == 6).Select(ts => ts.GiaTri).FirstOrDefault(),
                    CongKetNoi = sp.tb_ThongSo.Where(ts => ts.ThuTu == 7).Select(ts => ts.GiaTri).FirstOrDefault(),

                    // Các cờ Boolean
                    LaSanPhamTrangChu = sp.LaSanPhamTrangChu,
                    LaSanPhamKhuyenMai = sp.LaSanPhamKhuyenMai,
                    LaSanPhamNoiBat = sp.LaSanPhamNoiBat,
                    LaSanPhamHot = sp.LaSanPhamHot,
                    LaSanPhamMoi = sp.LaSanPhamMoi,
                    LaSanPhamBanChay = sp.LaSanPhamBanChay,
                    HienThi = sp.HienThi,
                    NgayTao = sp.NgayTao,

                }).ToList();

            // 3. Xử lý phân trang cho View
            int totalItems = db.tb_SanPham.Count();
            int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

            ViewBag.CurrentPage = page;
            ViewBag.TotalPages = totalPages;
            ViewBag.TuKhoa = "";

            return View(lstsp);
        }
