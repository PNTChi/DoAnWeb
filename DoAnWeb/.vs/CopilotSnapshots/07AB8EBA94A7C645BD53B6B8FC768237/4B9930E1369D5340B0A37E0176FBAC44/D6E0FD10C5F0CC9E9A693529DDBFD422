        public ActionResult formSuaQTV(int id)
        {
            var qtv = db.tb_TaiKhoan.Find(id);
            if (qtv == null)
            {
                return HttpNotFound();
            }
            return View(qtv);
        }
        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult SuaQTV(tb_TaiKhoan qtv)
        {
            if (ModelState.IsValid)
            {
                var qtvGoc = db.tb_TaiKhoan.Find(qtv.Id);
                if (qtvGoc == null)
                {
                    return HttpNotFound();
                }
                qtvGoc.HoTen = qtv.HoTen;
                qtvGoc.TenDangNhap = qtv.TenDangNhap;
                qtvGoc.Email = qtv.Email;
                qtvGoc.HoatDong = qtv.HoatDong;

                if (!string.IsNullOrEmpty(qtv.MatKhau))
                {
                    qtvGoc.MatKhau = qtv.MatKhau;
                }
                db.SaveChanges();
                return RedirectToAction("QuanTriVien");
            }
            return View("formSuaQTV", qtv);
        }
        public ActionResult XoaQTV(int id)
        {
            var qtv = db.tb_TaiKhoan.Find(id);
            if (qtv != null)
            {
                db.tb_TaiKhoan.Remove(qtv);
                db.SaveChanges();
            }
            return RedirectToAction("QuanTriVien");
        }
        public ActionResult TimQuanTriVien(string timqtv, int page = 1)
        {
            int pageSize = 5;
            var query = db.tb_TaiKhoan.AsQueryable();
            query = query.Where(qtv => qtv.LaQuanTri == true);

            if (!String.IsNullOrEmpty(timqtv))
            {
                string keyword = timqtv.ToLower();
                query = query.Where(qtv =>
                     qtv.HoTen.ToLower().Contains(keyword) ||
                     qtv.TenDangNhap.ToLower().Contains(keyword));
            }

            int totalItems = query.Count();
            int totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

            var lstQTV = query
                .OrderBy(qtv => qtv.Id)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .ToList();

            ViewBag.CurrentPage = page;
            ViewBag.TotalPages = totalPages;
            ViewBag.TuKhoa = timqtv;

            return View("QuanTriVien", lstQTV);
        }
