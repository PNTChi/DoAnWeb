@model DoAnWeb.Models.ShoppingCart

@{
    ViewBag.Title = "Giỏ hàng";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
 <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
    <i class="fas fa-home mr-2"></i>
      Trang ch?
</a>
        </li>
        <li aria-current="page">
          <div class="flex items-center">
          <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Gi? hàng</span>
          </div>
     </li>
    </ol>
</nav>

<!-- Page Title -->
<div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-shopping-cart mr-3 text-blue-600"></i>
        Gi? hàng c?a b?n
 </h1>
    @if (Model != null && !Model.IsEmpty())
  {
        <span class="text-sm text-gray-600">
            @Model.GetTotalQuantity() s?n ph?m
        </span>
    }
</div>

@if (Model != null && !Model.IsEmpty())
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cart Items (Left - 2/3 width) -->
        <div class="lg:col-span-2 space-y-4">
          @foreach (var item in Model.Items)
            {
        <div class="cart-item bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow" 
         data-product-id="@item.ProductId" 
     data-color="@item.Color">
     <div class="flex items-center space-x-6">
   <!-- Product Image -->
      <div class="flex-shrink-0">
         <a href="@Url.Action("ChiTietSP", "SanPham", new { id = item.ProductId })">
          @if (!string.IsNullOrEmpty(item.ProductImage))
   {
      <img src="@Url.Content("~/Content/Images/" + item.ProductImage)" 
 alt="@item.ProductName" 
     class="w-24 h-24 object-contain rounded border border-gray-200" />
  }
         else
  {
        <img src="@Url.Content("~/Content/Images/no-image.png")" 
 alt="No Image" 
  class="w-24 h-24 object-contain rounded border border-gray-200" />
    }
           </a>
       </div>

  <!-- Product Info -->
        <div class="flex-1">
          <h3 class="text-lg font-semibold text-gray-900 mb-2">
          <a href="@Url.Action("ChiTietSP", "SanPham", new { id = item.ProductId })" 
            class="hover:text-blue-600">
    @item.ProductName
          </a>
     </h3>
          
           @if (!string.IsNullOrEmpty(item.Color))
     {
        <p class="text-sm text-gray-600 mb-2">
     <span class="font-medium">Màu:</span> @item.Color
         </p>
     }

    <div class="flex items-center space-x-4">
     <!-- Price -->
         <p class="text-lg font-bold text-blue-600">
     @String.Format("{0:0,0}", item.Price) ?
             </p>

      <!-- Quantity Selector -->
   <div class="flex items-center border border-gray-300 rounded">
       <button type="button" 
     class="btn-decrease px-3 py-1 hover:bg-gray-100 transition-colors" 
    onclick="updateQuantity(@item.ProductId, @item.Quantity - 1, '@item.Color')">
               <i class="fas fa-minus text-gray-600"></i>
        </button>
      <input type="number" 
class="quantity-input w-16 text-center border-x border-gray-300 py-1 font-semibold" 
         value="@item.Quantity" 
         min="1" 
           readonly />
     <button type="button" 
              class="btn-increase px-3 py-1 hover:bg-gray-100 transition-colors" 
       onclick="updateQuantity(@item.ProductId, @item.Quantity + 1, '@item.Color')">
        <i class="fas fa-plus text-gray-600"></i>
   </button>
           </div>

              <!-- Item Total -->
   <p class="item-total text-lg font-bold text-gray-900">
  @String.Format("{0:0,0}", item.TotalPrice) ?
              </p>
    </div>
     </div>

 <!-- Remove Button -->
                <div class="flex-shrink-0">
               <button type="button" 
     class="btn-remove text-red-500 hover:text-red-700 hover:bg-red-50 p-2 rounded transition-colors" 
      onclick="removeItem(@item.ProductId, '@item.Color')" 
           title="Xóa s?n ph?m">
        <i class="fas fa-trash-alt text-xl"></i>
           </button>
        </div>
        </div>
                </div>
         }
  </div>

 <!-- Order Summary (Right - 1/3 width) -->
        <div class="lg:col-span-1">
          <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4">
    <h2 class="text-xl font-bold text-gray-900 mb-6 pb-4 border-b">
         Thông tin ??n hàng
    </h2>

         <div class="space-y-4 mb-6">
    <div class="flex justify-between text-gray-700">
            <span>T?m tính:</span>
    <span id="subtotal" class="font-semibold">@String.Format("{0:0,0}", Model.GetTotal()) ?</span>
   </div>

           <div class="flex justify-between text-gray-700">
             <span>Phí v?n chuy?n:</span>
       <span class="font-semibold text-green-600">Mi?n phí</span>
     </div>

          <div class="border-t pt-4">
          <div class="flex justify-between items-center">
           <span class="text-lg font-bold text-gray-900">T?ng c?ng:</span>
       <span id="total" class="text-2xl font-bold text-red-600">
         @String.Format("{0:0,0}", Model.GetTotal()) ?
     </span>
  </div>
       </div>
   </div>

        <!-- Checkout Button -->
    <a href="@Url.Action("Index", "ThanhToan")" 
    class="block w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-4 px-6 rounded-lg transition-all duration-200 text-center shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
    <i class="fas fa-credit-card mr-2"></i>
     Ti?n hành thanh toán
          </a>

       <!-- Continue Shopping -->
    <a href="@Url.Action("Index", "Home")" 
  class="block w-full mt-3 text-center text-blue-600 hover:text-blue-800 font-semibold py-2">
       <i class="fas fa-arrow-left mr-2"></i>
         Ti?p t?c mua hàng
         </a>

   <!-- Promo Code (Optional) -->
      <div class="mt-6 pt-6 border-t">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Mã gi?m giá</h3>
           <div class="flex space-x-2">
              <input type="text" 
                 placeholder="Nh?p mã gi?m giá" 
  class="flex-1 px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500" />
  <button type="button" 
                  class="px-4 py-2 bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold rounded transition-colors">
           Áp d?ng
     </button>
         </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Empty Cart -->
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
 <div class="mb-6">
 <i class="fas fa-shopping-cart text-gray-300 text-8xl"></i>
        </div>
      <h2 class="text-2xl font-bold text-gray-700 mb-4">Gi? hàng tr?ng</h2>
        <p class="text-gray-500 mb-6">
 B?n ch?a có s?n ph?m nào trong gi? hàng
   </p>
<a href="@Url.Action("Index", "Home")" 
           class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors">
       <i class="fas fa-arrow-left mr-2"></i>
          Ti?p t?c mua s?m
        </a>
    </div>
}

@section scripts {
<script>
    // Update quantity
    function updateQuantity(productId, quantity, color) {
        if (quantity < 1) {
        if (!confirm('B?n có mu?n xóa s?n ph?m này kh?i gi? hàng?')) {
       return;
        }
        }

        $.ajax({
url: '@Url.Action("UpdateQuantity", "GioHang")',
 type: 'POST',
            data: {
 productId: productId,
   quantity: quantity,
      color: color
            },
      success: function (response) {
       if (response.success) {
         if (quantity === 0) {
   // Remove item from DOM
          $('[data-product-id="' + productId + '"][data-color="' + color + '"]').fadeOut(300, function() {
     $(this).remove();
       checkEmptyCart();
       });
       } else {
        // Update quantity input
        var $item = $('[data-product-id="' + productId + '"][data-color="' + color + '"]');
     $item.find('.quantity-input').val(quantity);
           
// Update item total
            $item.find('.item-total').text(formatCurrency(response.itemTotal));
        }

           // Update cart totals
          updateCartTotals(response.cartTotal, response.cartCount);

          // Show notification
             showNotification(response.message, 'success');
           } else {
            showNotification(response.message, 'error');
     }
            },
 error: function () {
      showNotification('Có l?i x?y ra, vui lòng th? l?i', 'error');
            }
});
    }

  // Remove item
function removeItem(productId, color) {
        if (!confirm('B?n có ch?c mu?n xóa s?n ph?m này?')) {
  return;
     }

        $.ajax({
            url: '@Url.Action("Remove", "GioHang")',
       type: 'POST',
 data: {
    productId: productId,
     color: color
            },
            success: function (response) {
       if (response.success) {
   // Remove item from DOM
              $('[data-product-id="' + productId + '"][data-color="' + color + '"]').fadeOut(300, function() {
       $(this).remove();
     checkEmptyCart();
      });

          // Update cart totals
           updateCartTotals(response.cartTotal, response.cartCount);

   // Show notification
        showNotification(response.message, 'success');
       } else {
     showNotification(response.message, 'error');
   }
   },
      error: function () {
           showNotification('Có l?i x?y ra, vui lòng th? l?i', 'error');
  }
 });
    }

    // Update cart totals
    function updateCartTotals(total, count) {
     $('#subtotal').text(formatCurrency(total));
        $('#total').text(formatCurrency(total));
  
        // Update header cart count (if exists)
      $('.cart-count').text(count);
    }

    // Format currency
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN').format(amount) + ' ?';
    }

    // Check if cart is empty
    function checkEmptyCart() {
        if ($('.cart-item').length === 0) {
 location.reload();
        }
    }

    // Show notification
    function showNotification(message, type) {
        var bgColor = type === 'success' ? 'bg-green-500' : 'bg-red-500';
        var notification = $('<div class="fixed top-4 right-4 ' + bgColor + ' text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in">' +
            '<i class="fas fa-' + (type === 'success' ? 'check' : 'exclamation') + '-circle mr-2"></i>' +
    message +
     '</div>');
        
        $('body').append(notification);
        
        setTimeout(function() {
       notification.fadeOut(300, function() {
            $(this).remove();
            });
        }, 3000);
    }

    // Quantity input change (optional - if you want manual input)
    $('.quantity-input').on('change', function() {
     var $item = $(this).closest('.cart-item');
        var productId = $item.data('product-id');
        var color = $item.data('color');
        var quantity = parseInt($(this).val());
        
        if (quantity < 1) {
    $(this).val(1);
            quantity = 1;
        }
        
        updateQuantity(productId, quantity, color);
  });
</script>
}
