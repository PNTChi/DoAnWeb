
@{
    ViewBag.Title = "BaoCaoThongKe";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div id="reports" class="tab-content active">
    <h1 class="mb-4">Báo cáo & thống kê</h1>
    <div class="table-container">
        <div class="row">
            <div class="col-md-6">
                <h3>Doanh thu theo tháng</h3>
                <canvas id="revenueChart"></canvas>
            </div>
            <div class="col-md-6">
                <h3>Sản phẩm bán chạy</h3>
                <canvas id="topProductsChart"></canvas>
            </div>
        </div>
        <div class="mt-4">
            <h3>Báo cáo chi tiết</h3>
            <div class="input-group mb-3">
                <input type="date" class="form-control" id="fromDate">
                <input type="date" class="form-control" id="toDate">
                <button class="btn btn-primary">Tạo báo cáo</button>
            </div>
            <table class="table table-bordered" id="reportDetailTable">
                <thead>
                    <tr>
                        <th>Chỉ số</th>
                        <th>Giá trị</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>Doanh thu tổng</td>
                        <td>100,000,000 VNĐ</td>
                    </tr>
                    <tr>
                        <td>Tỷ lệ hủy đơn</td>
                        <td>5%</td>
                    </tr>
                    <tr>
                        <td>Hàng tồn kho nhiều nhất</td>
                        <td>iPhone 14 Pro (50)</td>
                    </tr>
                </tbody>
            </table>
            <button class="btn btn-info" onclick="printReport()">
                <i class="fas fa-print"></i> In báo cáo
            </button>
            <button class="btn btn-success" id="exportReportExcelBtn">
                <i class="fas fa-file-excel"></i> Xuất Excel
            </button>
        </div>
    </div>
</div>