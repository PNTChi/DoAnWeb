using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using DoAnWeb.Models;

namespace DoAnWeb.Controllers
{
    /// <summary>
    /// Controller xử lý giỏ hàng
    /// </summary>
    public class GioHangController : BaseController
    {
        private const string CART_SESSION = "Cart";

        /// <summary>
        /// Lấy giỏ hàng từ Session
        /// </summary>
    private ShoppingCart GetCart()
    {
    var cart = Session[CART_SESSION] as ShoppingCart;
      if (cart == null)
 {
 cart = new ShoppingCart();
    Session[CART_SESSION] = cart;
  }
 return cart;
  }

        /// <summary>
        /// Lưu giỏ hàng vào Session
        /// </summary>
        private void SaveCart(ShoppingCart cart)
   {
    Session[CART_SESSION] = cart;
        }

        /// <summary>
 /// GET: Hiển thị giỏ hàng
     /// </summary>
        public ActionResult Index()
   {
            // Kiểm tra đăng nhập
            if (!IsAuthenticated || CurrentUser == null)
            {
                TempData["ErrorMessage"] = "Vui lòng đăng nhập để xem giỏ hàng";
                return RedirectToAction("Login", "Account");
            }

       var cart = GetCart();
        return View(cart);
        }

        /// <summary>
        /// POST: Thêm sản phẩm vào giỏ hàng
        /// </summary>
        [HttpPost]
        public JsonResult AddToCart(int productId, int quantity = 1, string color = "")
   {
            try
   {
                // Kiểm tra đăng nhập
                if (!IsAuthenticated || CurrentUser == null)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Vui lòng đăng nhập để thêm sản phẩm vào giỏ hàng",
                        requireLogin = true
                    });
                }

   // Tìm sản phẩm trong database
    var product = db.tb_SanPham.Find(productId);

           if (product == null || product.HienThi == false)
        {
       return Json(new
           {
         success = false,
            message = "Sản phẩm không tồn tại"
    });
   }

       // Kiểm tra số lượng tồn kho
    if (product.SoLuong.HasValue && product.SoLuong.Value < quantity)
      {
      return Json(new
  {
  success = false,
 message = $"Chỉ còn {product.SoLuong.Value} sản phẩm trong kho"
      });
    }

      // Lấy giỏ hàng
  var cart = GetCart();

   // Tạo cart item
    var cartItem = new CartItem
    {
 ProductId = product.Id,
    ProductName = product.TenSanPham,
        ProductImage = product.HinhAnh,
     // Ưu tiên giá khuyến mãi
        Price = product.GiaKhuyenMai.HasValue && product.GiaKhuyenMai.Value > 0 
 ? product.GiaKhuyenMai.Value 
             : product.Gia ?? 0,
 Quantity = quantity,
      Color = color
      };

     // Thêm vào giỏ
      cart.AddItem(cartItem);
      SaveCart(cart);

      return Json(new
    {
         success = true,
     message = "Đã thêm sản phẩm vào giỏ hàng",
    cartCount = cart.GetTotalQuantity(),
         cartTotal = cart.GetTotal()
    });
     }
            catch (Exception ex)
            {
        return Json(new
    {
         success = false,
      message = "Có lỗi xảy ra: " + ex.Message
      });
   }
      }

   /// <summary>
 /// POST: Cập nhật số lượng sản phẩm trong giỏ
        /// </summary>
        [HttpPost]
        public JsonResult UpdateQuantity(int productId, int quantity, string color = "")
    {
            try
            {
    // Kiểm tra số lượng hợp lệ
    if (quantity < 0)
       {
         return Json(new
        {
      success = false,
   message = "Số lượng không hợp lệ"
    });
       }

        // Lấy giỏ hàng
          var cart = GetCart();

     // Nếu quantity = 0 thì xóa sản phẩm
if (quantity == 0)
     {
   cart.RemoveItem(productId, color);
        }
     else
          {
        // Kiểm tra số lượng tồn kho
      var product = db.tb_SanPham.Find(productId);
       if (product != null && product.SoLuong.HasValue && product.SoLuong.Value < quantity)
         {
      return Json(new
         {
           success = false,
         message = $"Chỉ còn {product.SoLuong.Value} sản phẩm trong kho"
     });
       }

  // Cập nhật số lượng
       cart.UpdateQuantity(productId, quantity, color);
            }

       SaveCart(cart);

   return Json(new
      {
       success = true,
       message = "Đã cập nhật giỏ hàng",
       cartCount = cart.GetTotalQuantity(),
     cartTotal = cart.GetTotal(),
              itemTotal = cart.GetItem(productId, color)?.TotalPrice ?? 0
    });
            }
     catch (Exception ex)
        {
      return Json(new
     {
   success = false,
          message = "Có lỗi xảy ra: " + ex.Message
       });
            }
  }

        /// <summary>
 /// POST: Xóa sản phẩm khỏi giỏ hàng
        /// </summary>
   [HttpPost]
  public JsonResult Remove(int productId, string color = "")
 {
 try
         {
var cart = GetCart();
       cart.RemoveItem(productId, color);
  SaveCart(cart);

     return Json(new
 {
      success = true,
      message = "Đã xóa sản phẩm khỏi giỏ hàng",
cartCount = cart.GetTotalQuantity(),
 cartTotal = cart.GetTotal()
      });
 }
            catch (Exception ex)
     {
           return Json(new
        {
        success = false,
          message = "Có lỗi xảy ra: " + ex.Message
     });
            }
     }

   /// <summary>
  /// POST: Xóa toàn bộ giỏ hàng
        /// </summary>
        [HttpPost]
        public JsonResult ClearCart()
        {
    try
            {
                var cart = GetCart();
    cart.Clear();
    SaveCart(cart);

         return Json(new
                {
     success = true,
     message = "Đã xóa toàn bộ giỏ hàng"
     });
   }
            catch (Exception ex)
     {
     return Json(new
        {
        success = false,
     message = "Có lỗi xảy ra: " + ex.Message
            });
  }
    }

  /// <summary>
  /// GET: Lấy số lượng sản phẩm trong giỏ (để hiển thị ở header)
        /// </summary>
        public JsonResult GetCartCount()
  {
    var cart = GetCart();
 return Json(new
  {
         count = cart.GetTotalQuantity(),
       total = cart.GetTotal()
    }, JsonRequestBehavior.AllowGet);
        }

        /// <summary>
        /// POST: Áp dụng mã giảm giá
        /// </summary>
        [HttpPost]
        public JsonResult ApplyDiscount(string discountCode)
        {
            try
            {
                // Kiểm tra mã giảm giá có được nhập
                if (string.IsNullOrWhiteSpace(discountCode))
                {
                    return Json(new
                    {
                        success = false,
                        message = "Vui lòng nhập mã giảm giá"
                    });
                }

                // Tìm mã giảm giá trong database
                var discount = db.tb_MaGiamGia
                    .FirstOrDefault(m => m.MaCode.ToLower() == discountCode.ToLower() 
                                      && m.HienThi == true);

                if (discount == null)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Mã giảm giá không tồn tại hoặc đã hết hạn"
                    });
                }

                // Kiểm tra ngày hết hạn
                if (discount.NgayKetThuc.HasValue && discount.NgayKetThuc.Value < DateTime.Now)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Mã giảm giá đã hết hạn"
                    });
                }

                // Kiểm tra số lượng còn lại
                if (discount.SoLuong.HasValue && discount.SoLuong.Value <= 0)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Mã giảm giá đã hết lượt sử dụng"
                    });
                }

                // Lấy giỏ hàng
                var cart = GetCart();
                
                if (cart.IsEmpty())
                {
                    return Json(new
                    {
                        success = false,
                        message = "Giỏ hàng trống"
                    });
                }

                // Tính toán giảm giá
                decimal cartTotal = cart.GetTotal();
                decimal discountAmount = 0;

                // Ưu tiên giảm theo phần trăm
                if (discount.PhanTramGiam.HasValue && discount.PhanTramGiam.Value > 0)
                {
                    discountAmount = cartTotal * discount.PhanTramGiam.Value / 100;
                }
                // Nếu không có % thì dùng số tiền giảm
                else if (discount.SoTienGiam.HasValue && discount.SoTienGiam.Value > 0)
                {
                    discountAmount = discount.SoTienGiam.Value;
                }

                // Giảm giá không được lớn hơn tổng tiền
                if (discountAmount > cartTotal)
                {
                    discountAmount = cartTotal;
                }

                // Lưu thông tin mã giảm giá vào session
                Session["DiscountCode"] = discount.MaCode;
                Session["DiscountId"] = discount.Id;
                Session["DiscountAmount"] = discountAmount;

                decimal finalTotal = cartTotal - discountAmount;

                return Json(new
                {
                    success = true,
                    message = "Áp dụng mã giảm giá thành công!",
                    discountCode = discount.MaCode,
                    discountAmount = discountAmount,
                    cartTotal = cartTotal,
                    finalTotal = finalTotal,
                    discountPercent = discount.PhanTramGiam ?? 0
                });
            }
            catch (Exception ex)
            {
                return Json(new
                {
                    success = false,
                    message = "Có lỗi xảy ra: " + ex.Message
                });
            }
        }

        /// <summary>
        /// POST: Xóa mã giảm giá
        /// </summary>
        [HttpPost]
        public JsonResult RemoveDiscount()
        {
            try
            {
                // Xóa mã giảm giá khỏi session
                Session.Remove("DiscountCode");
                Session.Remove("DiscountId");
                Session.Remove("DiscountAmount");

                var cart = GetCart();

                return Json(new
                {
                    success = true,
                    message = "Đã xóa mã giảm giá",
                    cartTotal = cart.GetTotal(),
                    finalTotal = cart.GetTotal()
                });
            }
            catch (Exception ex)
            {
                return Json(new
                {
                    success = false,
                    message = "Có lỗi xảy ra: " + ex.Message
                });
            }
        }
    }
}
