@model List<DoAnWeb.Models.QLSP>

@{
    ViewBag.Title = "QLSP";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<!-- Quản lý sản phẩm -->
<div id="products" class="tab-content active">
    <h1 class="mb-4">Quản lý sản phẩm</h1>
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimKiemSP" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timsp" name="timsp" placeholder="Tìm kiếm sản phẩm...">
                <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
            </form>
            <div class="d-flex gap-2">
                <button class="btn btn-secondary" onclick="document.getElementById('csvImportInput').click()">
                    <i class="fas fa-file-import"></i> Import CSV
                </button>
                <input type="file" id="csvImportInput" accept=".csv" style="display: none;">
                <button class="btn btn-success" id="exportCsvBtn">
                    <i class="fas fa-file-excel"></i> Export CSV
                </button>
                <a href="@Url.Action("formThemSP", "Admin")" class="btn btn-primary">
                    <i class="fas fa-plus"></i> Thêm sản phẩm
                </a>
            </div>
        </div>
        <table class="table table-bordered table-hover" id="productTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên sản phẩm</th>
                    <th>Bí danh</th>
                    <th>Mã sản phẩm</th>
                    <th>Mô tả</th>
                    <th>Mô tả chi tiết</th>
                    <th>Giá</th>
                    <th>Giá khuyến mãi</th>
                    <th>Số lượng</th>
                    <th>Lượt xem</th>
                    <th>Hình ảnh</th>
                    <th>Tên danh mục</th>
                    <th>Tên thương hiệu</th>
                    <th>Bộ nhớ ram</th>
                    <th>Bộ nhớ trong</th>
                    <th>Màn hình</th>
                    <th>Pin</th>
                    <th>Camera</th>
                    <th>Hệ điều hành</th>
                    <th>Cổng kết nối</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            

            @foreach (var item in Model)
            {
                <tbody id="productTableBody">
                    <tr id="product-1">
                        <td>@item.Id</td>
                        <td>@item.TenSanPham</td>
                        <td>@item.BiDanh</td>
                        <td>@item.MaSanPham</td>
                        <td>@item.MoTa</td>
                        <td>@item.ChiTiet</td>
                        <td>@item.Gia</td>
                        <td>@item.GiaKhuyenMai</td>
                        <td>@item.SoLuong</td>
                        <td>@item.LuotXem</td>
                        <td><img src="~/Content/Images/@item.HinhAnh" alt=" @item.TenSanPham" class="lazyload" style="width: 100px; height: 100px; object-fit: cover; border: 1px solid #eee;" /></td>
                        <td>@item.TenDanhMuc</td>
                        <td>@item.TenThuongHieu</td>
                        <!-- HIỂN THỊ THÔNG SỐ KỸ THUẬT DỰA TRÊN TÊN CỘT CỐ ĐỊNH -->
                        <!-- Các tên thông số phải khớp với dữ liệu trong tb_ThongSo -->
                        <td>@item.BoNhoRAM</td>
                        <td>@item.BoNhoTrong</td>
                        <td>@item.ManHinh</td>
                        <td>@item.DungLuongPin</td>
                        <td>@item.Camera</td>
                        <td>@item.HeDieuHanh</td>
                        <td>@item.CongKetNoi</td>
                        <td>
                            <a href="@Url.Action("formSuaSP", "Admin", new { id = item.Id })" class="btn btn-sm btn-warning">
                                <i class="fas fa-edit"></i> Sửa
                            </a>
                            <a href="@Url.Action("XoaSP", "Admin", new { id = item.Id })" class="btn btn-sm btn-danger" onclick="return confirm('Bạn có chắc chắn muốn xóa sản phẩm này?');">
                                <i class="fas fa-trash"></i> Xóa
                            </a>
                        </td>
                    </tr>
                </tbody>
            }
        </table>
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QLSP" : "TimKiemSP",
                    new { timsp = ViewBag.TuKhoa, page = currentPage - 1 })">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(
                        String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QLSP" : "TimKiemSP",
                        new { timsp = ViewBag.TuKhoa, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QLSP" : "TimKiemSP",
                    new { timsp = ViewBag.TuKhoa, page = currentPage + 1 })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>