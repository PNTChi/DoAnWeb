using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;
using System.Web.Mvc;
using DoAnWeb.Models;

namespace DoAnWeb.Controllers
{
    /// <summary>
    /// Controller xử lý giỏ hàng
    /// </summary>
    public class GioHangController : BaseController
    {
        private const string CART_SESSION = "Cart";

        /// <summary>
        /// Lấy giỏ hàng từ Session
        /// </summary>
    private ShoppingCart GetCart()
    {
    var cart = Session[CART_SESSION] as ShoppingCart;
      if (cart == null)
 {
 cart = new ShoppingCart();
    Session[CART_SESSION] = cart;
  }
 return cart;
  }

        /// <summary>
        /// Lưu giỏ hàng vào Session
        /// </summary>
        private void SaveCart(ShoppingCart cart)
   {
    Session[CART_SESSION] = cart;
        }

        /// <summary>
 /// GET: Hiển thị giỏ hàng
     /// </summary>
        public ActionResult Index()
   {
       var cart = GetCart();
        return View(cart);
        }

        /// <summary>
        /// POST: Thêm sản phẩm vào giỏ hàng
        /// </summary>
        [HttpPost]
        public JsonResult AddToCart(int productId, int quantity = 1, string color = "")
   {
            try
   {
   // Tìm sản phẩm trong database
    var product = db.tb_SanPham.Find(productId);

           if (product == null || product.HienThi == false)
        {
       return Json(new
           {
         success = false,
            message = "Sản phẩm không tồn tại"
    });
   }

       // Kiểm tra số lượng tồn kho
    if (product.SoLuong.HasValue && product.SoLuong.Value < quantity)
      {
      return Json(new
  {
  success = false,
 message = $"Chỉ còn {product.SoLuong.Value} sản phẩm trong kho"
      });
    }

      // Lấy giỏ hàng
  var cart = GetCart();

   // Tạo cart item
    var cartItem = new CartItem
    {
 ProductId = product.Id,
    ProductName = product.TenSanPham,
        ProductImage = product.HinhAnh,
     // Ưu tiên giá khuyến mãi
        Price = product.GiaKhuyenMai.HasValue && product.GiaKhuyenMai.Value > 0 
 ? product.GiaKhuyenMai.Value 
             : product.Gia ?? 0,
 Quantity = quantity,
      Color = color
      };

     // Thêm vào giỏ
      cart.AddItem(cartItem);
      SaveCart(cart);

      return Json(new
    {
         success = true,
     message = "Đã thêm sản phẩm vào giỏ hàng",
    cartCount = cart.GetTotalQuantity(),
         cartTotal = cart.GetTotal()
    });
     }
            catch (Exception ex)
            {
        return Json(new
    {
         success = false,
      message = "Có lỗi xảy ra: " + ex.Message
      });
   }
      }

   /// <summary>
 /// POST: Cập nhật số lượng sản phẩm trong giỏ
        /// </summary>
        [HttpPost]
        public JsonResult UpdateQuantity(int productId, int quantity, string color = "")
    {
            try
            {
    // Kiểm tra số lượng hợp lệ
    if (quantity < 0)
       {
         return Json(new
        {
      success = false,
   message = "Số lượng không hợp lệ"
    });
       }

        // Lấy giỏ hàng
          var cart = GetCart();

     // Nếu quantity = 0 thì xóa sản phẩm
if (quantity == 0)
     {
   cart.RemoveItem(productId, color);
        }
     else
          {
        // Kiểm tra số lượng tồn kho
      var product = db.tb_SanPham.Find(productId);
       if (product != null && product.SoLuong.HasValue && product.SoLuong.Value < quantity)
         {
      return Json(new
         {
           success = false,
         message = $"Chỉ còn {product.SoLuong.Value} sản phẩm trong kho"
     });
       }

  // Cập nhật số lượng
       cart.UpdateQuantity(productId, quantity, color);
            }

       SaveCart(cart);

   return Json(new
      {
       success = true,
       message = "Đã cập nhật giỏ hàng",
       cartCount = cart.GetTotalQuantity(),
     cartTotal = cart.GetTotal(),
              itemTotal = cart.GetItem(productId, color)?.TotalPrice ?? 0
    });
            }
     catch (Exception ex)
        {
      return Json(new
     {
   success = false,
          message = "Có lỗi xảy ra: " + ex.Message
       });
            }
  }

        /// <summary>
 /// POST: Xóa sản phẩm khỏi giỏ hàng
        /// </summary>
   [HttpPost]
  public JsonResult Remove(int productId, string color = "")
 {
 try
         {
var cart = GetCart();
       cart.RemoveItem(productId, color);
  SaveCart(cart);

     return Json(new
 {
      success = true,
      message = "Đã xóa sản phẩm khỏi giỏ hàng",
cartCount = cart.GetTotalQuantity(),
 cartTotal = cart.GetTotal()
      });
 }
            catch (Exception ex)
     {
           return Json(new
        {
        success = false,
          message = "Có lỗi xảy ra: " + ex.Message
     });
            }
     }

   /// <summary>
  /// POST: Xóa toàn bộ giỏ hàng
        /// </summary>
        [HttpPost]
        public JsonResult ClearCart()
        {
    try
            {
                var cart = GetCart();
    cart.Clear();
    SaveCart(cart);

         return Json(new
                {
     success = true,
     message = "Đã xóa toàn bộ giỏ hàng"
     });
   }
            catch (Exception ex)
     {
     return Json(new
        {
        success = false,
     message = "Có lỗi xảy ra: " + ex.Message
            });
  }
    }

  /// <summary>
  /// GET: Lấy số lượng sản phẩm trong giỏ (để hiển thị ở header)
        /// </summary>
        public JsonResult GetCartCount()
  {
    var cart = GetCart();
 return Json(new
  {
         count = cart.GetTotalQuantity(),
       total = cart.GetTotal()
    }, JsonRequestBehavior.AllowGet);
        }
    }
}
