                        <div id="searchDropdownMobile" class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-lg shadow-2xl border border-gray-200 z-50 max-h-96 overflow-y-auto">
                            <!-- Results will be populated here -->
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </header>
    
