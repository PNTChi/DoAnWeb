                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody id="invoiceItems">
                                <tr>
                                    <td>iPhone 14 Pro</td>
                                    <td>1</td>
                                    <td>25,000,000 VNĐ</td>
                                    <td>25,000,000 VNĐ</td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th colspan="3" class="text-end">Tổng cộng:</th>
                                    <th id="invoiceTotal">25,000,000 VNĐ</th>
                                </tr>
                            </tfoot>
                        </table>
                        <p class="text-center mt-4">Cảm ơn quý khách đã mua hàng!</p>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
                    <button type="button" class="btn btn-primary" onclick="printModalContent('invoiceModalBody')">
