            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("Banner", "Admin")" onclick="setActive(this)"><i class="fas fa-image"></i> Quản lý quảng cáo</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="@Url.Action("TinTuc", "Admin")" onclick="setActive(this)"><i class="fas fa-newspaper"></i> Quản lý tin tức</a>
            </li>
            <li class="nav-item">
