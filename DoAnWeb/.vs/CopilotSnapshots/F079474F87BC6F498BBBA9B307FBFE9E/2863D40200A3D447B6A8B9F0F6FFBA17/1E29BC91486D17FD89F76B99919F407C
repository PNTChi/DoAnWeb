  {
        <img id="mainImage" 
 src="@Url.Content("~/Content/Images/" + Model.SanPham.HinhAnh)" 
  alt="@Model.SanPham.TenSanPham" 
  class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-110" />
    }
    else
       {
     <img id="mainImage" 
  src="@Url.Content("~/Content/Images/no-image.png")" 
        alt="No Image" 
   class="w-full h-full object-contain" />
      }
    
   <!-- Zoom Icon -->
      <div class="absolute top-4 right-4 bg-white bg-opacity-90 rounded-full p-2 shadow-lg opacity-0 group-hover:opacity-100 transition-opacity">
  <i class="fas fa-search-plus text-gray-600"></i>
     </div>
     </div>

            <!-- Thumbnails Gallery -->
          @if (Model.DanhSachAnh != null && Model.DanhSachAnh.Any())
          {
    <div class="grid grid-cols-4 gap-3">
        @foreach (var anh in Model.DanhSachAnh.Take(4))
   {
   <div class="aspect-square overflow-hidden rounded-lg border-2 border-gray-200 cursor-pointer hover:border-blue-500 transition-all duration-200 thumbnail-image" 
        data-image="@Url.Content("~/Content/Images/" + anh.HinhAnh)">
        <img src="@Url.Content("~/Content/Images/" + anh.HinhAnh)" 
       alt="@Model.SanPham.TenSanPham" 
     class="w-full h-full object-cover hover:scale-110 transition-transform duration-200" />
           </div>
    }
     </div>
      }
       
      <!-- Product Badges -->
      <div class="flex gap-2 flex-wrap">
     @if (Model.SanPham.LaSanPhamMoi == true)
       {
    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-green-100 text-green-800">
         <i class="fas fa-star mr-1"></i> S?n ph?m m?i
               </span>
    }
      @if (Model.SanPham.LaSanPhamBanChay == true)
        {
 <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-orange-100 text-orange-800">
 <i class="fas fa-fire mr-1"></i> Bán ch?y
    </span>
  }
  @if (Model.SanPham.GiaKhuyenMai.HasValue && Model.SanPham.GiaKhuyenMai < Model.SanPham.Gia)
   {
 <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-red-100 text-red-800">
    <i class="fas fa-tag mr-1"></i> Khuy?n mãi
      </span>
     }
  </div>
        </div>
   
   <!-- Right: Product Info -->
        <div class="space-y-6">
     <!-- Product Name -->
        <div>
         <h1 class="text-3xl font-bold text-gray-900 mb-2">@Model.SanPham.TenSanPham</h1>
      @if (Model.SanPham.tb_ThuongHieu != null)
        {
      <p class="text-sm text-gray-600">
Th??ng hi?u: <a href="@Url.Action("Index", "SanPham", new { thuongHieuId = Model.SanPham.ThuongHieuId })" class="text-blue-600 hover:underline font-semibold">@Model.SanPham.tb_ThuongHieu.TenThuongHieu</a>
 </p>
   }
            </div>
         
   <!-- Rating & Views -->
    <div class="flex items-center space-x-6 py-3 border-y border-gray-200">
    @if (Model.TongSoDanhGia > 0)
   {
    <div class="flex items-center">
      @{
          var avgRatingTop = Model.DiemTrungBinh;
      }
      @for (int i = 1; i <= 5; i++)
      {
          if (i <= Math.Floor(avgRatingTop))
          {
              <i class="fas fa-star text-yellow-400 text-lg"></i>
          }
          else if (i == Math.Ceiling(avgRatingTop) && avgRatingTop % 1 != 0)
          {
              <i class="fas fa-star-half-alt text-yellow-400 text-lg"></i>
          }
          else
          {
              <i class="far fa-star text-gray-300 text-lg"></i>
          }
      }
      <span class="ml-2 text-sm font-medium text-gray-700">(@Model.TongSoDanhGia Đánh giá)</span>
</div>
        }
      <div class="text-sm text-gray-600">
     <i class="fas fa-eye mr-1"></i>
      <span class="font-medium">@(Model.SanPham.LuotXem ?? 0)</span> lượt xem
           </div>
     </div>

      <!-- Price -->
  <div class="bg-gray-50 rounded-lg p-4">
 @if (Model.SanPham.GiaKhuyenMai.HasValue && Model.SanPham.GiaKhuyenMai < Model.SanPham.Gia)
     {
          <div class="space-y-2">
     <div class="flex items-center space-x-3">
    <span class="text-4xl font-bold text-red-600">@String.Format("{0:0,0}", Model.SanPham.GiaKhuyenMai.Value) ?</span>
      <span class="bg-red-500 text-white text-sm font-bold px-3 py-1 rounded-full">
     -@Math.Round((decimal)(1 - (Model.SanPham.GiaKhuyenMai.Value / Model.SanPham.Gia.Value)) * 100)%
  </span>
       </div>
                   <div class="text-xl text-gray-500 line-through">@String.Format("{0:0,0}", Model.SanPham.Gia.Value) ?</div>
         </div>
           }
     else
{
            <span class="text-4xl font-bold text-blue-600">@String.Format("{0:0,0}", Model.SanPham.Gia ?? 0) ?</span>
   }
    </div>

 <!-- Color Selection -->
<div>
