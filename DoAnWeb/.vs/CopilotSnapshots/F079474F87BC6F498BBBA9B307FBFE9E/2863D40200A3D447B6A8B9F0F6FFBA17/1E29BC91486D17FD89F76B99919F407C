@model DoAnWeb.Models.ProductDetailViewModel

@{
 ViewBag.Title = Model.SanPham.TenSanPham;
}

@* Success Message *@
@if (TempData["SuccessMessage"] != null)
{
 <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4 animate-fade-in" role="alert">
      <strong class="font-bold">Thành công!</strong>
     <span class="block sm:inline">@TempData["SuccessMessage"]</span>
        <button type="button" class="absolute top-0 right-0 px-4 py-3" onclick="this.parentElement.remove()">
   <i class="fas fa-times"></i>
</button>
    </div>
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
     <li class="inline-flex items-center">
<a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
      <i class="fas fa-home mr-2"></i>
   Trang ch?
   </a>
        </li>
        @if (ViewBag.TenDanhMuc != null)
        {
         <li>
   <div class="flex items-center">
     <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
      <a href="@Url.Action("Index", "SanPham", new { danhMucId = ViewBag.DanhMucId })" class="text-sm font-medium text-gray-700 hover:text-blue-600">
  @ViewBag.TenDanhMuc
