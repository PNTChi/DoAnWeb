      <i class="fas fa-check text-gray-600 opacity-0 peer-checked:opacity-100"></i>
   </div>
 <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 text-xs whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity">B?c</span>
      </label>
 
<label class="relative cursor-pointer group">
         <input type="radio" name="color" value="black" class="peer sr-only" />
        <div class="w-12 h-12 rounded-full bg-gray-900 border-2 border-gray-300 peer-checked:border-blue-600 peer-checked:ring-2 peer-checked:ring-blue-200 hover:scale-110 transition-transform flex items-center justify-center">
      <i class="fas fa-check text-white opacity-0 peer-checked:opacity-100"></i>
     </div>
             <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 text-xs whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity">?en</span>
     </label>
  
  <label class="relative cursor-pointer group">
    <input type="radio" name="color" value="gold" class="peer sr-only" />
    <div class="w-12 h-12 rounded-full bg-yellow-400 border-2 border-gray-300 peer-checked:border-blue-600 peer-checked:ring-2 peer-checked:ring-blue-200 hover:scale-110 transition-transform flex items-center justify-center">
 <i class="fas fa-check text-white opacity-0 peer-checked:opacity-100"></i>
          </div>
    <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 text-xs whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity">Vàng</span>
  </label>
       
             <label class="relative cursor-pointer group">
    <input type="radio" name="color" value="blue" class="peer sr-only" />
  <div class="w-12 h-12 rounded-full bg-blue-600 border-2 border-gray-300 peer-checked:border-blue-600 peer-checked:ring-2 peer-checked:ring-blue-200 hover:scale-110 transition-transform flex items-center justify-center">
      <i class="fas fa-check text-white opacity-0 peer-checked:opacity-100"></i>
       </div>
           <span class="absolute -bottom-6 left-1/2 transform -translate-x-1/2 text-xs whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity">Xanh</span>
  </label>
        </div>
        </div>

    <!-- Short Description -->
      @if (!string.IsNullOrEmpty(Model.SanPham.MoTa))
   {
  <div class="prose prose-sm">
      <h3 class="text-sm font-semibold text-gray-900 mb-2">Mô t? ng?n:</h3>
         <p class="text-gray-700 text-sm leading-relaxed">@Model.SanPham.MoTa</p>
   </div>
      }

       <!-- Stock Status -->
            <div class="flex items-center space-x-2">
         @if (Model.SanPham.SoLuong.HasValue && Model.SanPham.SoLuong > 0)
    {
         <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-green-100 text-green-800">
      <i class="fas fa-check-circle mr-2"></i>
           Còn hàng (@Model.SanPham.SoLuong sản phẩm)
          </span>
            }
  else
    {
  <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-red-100 text-red-800">
    <i class="fas fa-times-circle mr-2"></i>
 H?t hàng
</span>
    }
  </div>

          <!-- Add to Cart Form -->
 @using (Html.BeginForm("ThemVaoGioHang", "SanPham", FormMethod.Post))
            {
      @Html.AntiForgeryToken()
  <input type="hidden" name="sanPhamId" value="@Model.SanPham.Id" />
     <input type="hidden" name="color" id="selectedColor" value="gray" />

 <div class="space-y-4">
          <!-- Quantity -->
  <div>
         <label class="text-sm font-semibold text-gray-900 block mb-2">S? l??ng:</label>
       <div class="flex items-center space-x-4">
     <div class="flex items-center border-2 border-gray-300 rounded-lg overflow-hidden">
         <button type="button" class="px-4 py-3 hover:bg-gray-100 transition-colors" onclick="decrementQty()">
        <i class="fas fa-minus text-gray-600"></i>
    </button>
  <input type="number" 
   name="soLuong" 
 id="quantity" 
     value="1" 
   min="1" 
   max="@(Model.SanPham.SoLuong ?? 1)" 
       class="w-20 text-center border-x-2 border-gray-300 py-3 font-semibold text-gray-900 focus:outline-none" 
