     <span class="text-sm font-medium text-gray-500">@Model.SanPham.TenSanPham</span>
       </div>
      </li>
    </ol>
</nav>

<!-- Product Detail Section -->
<div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      
        <!-- Left: Product Image Gallery -->
   <div class="space-y-4">
      <!-- Main Image -->
<div class="aspect-square overflow-hidden rounded-lg border-2 border-gray-200 bg-gray-50 relative group">
