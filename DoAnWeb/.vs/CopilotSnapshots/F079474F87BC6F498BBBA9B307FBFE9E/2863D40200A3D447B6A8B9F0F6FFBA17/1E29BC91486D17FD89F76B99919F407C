         <button type="button" class="px-4 py-3 hover:bg-gray-100 transition-colors" onclick="incrementQty()">
   <i class="fas fa-plus text-gray-600"></i>
     </button>
   </div>
     
   @if (Model.SanPham.SoLuong.HasValue && Model.SanPham.SoLuong > 0)
  {
    <button type="submit" class="flex-1 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200 flex items-center justify-center shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
       <i class="fas fa-shopping-cart mr-2"></i>
