           }
      else
    {
<button type="button" disabled class="flex-1 bg-gray-400 text-white font-bold py-3 px-6 rounded-lg cursor-not-allowed">
      <i class="fas fa-ban mr-2"></i>
      H?t hàng
     </button>
}
   </div>
    </div>

      <!-- Action Buttons -->
   <div class="grid grid-cols-2 gap-3">
    <button type="button" onclick="buyNow()" class="flex items-center justify-center px-6 py-3 border-2 border-blue-600 text-blue-600 hover:bg-blue-50 font-semibold rounded-lg transition-all duration-200">
    <i class="fas fa-bolt mr-2"></i>
       Mua ngay
       </button>
        <button type="button" class="flex items-center justify-center px-6 py-3 border-2 border-gray-300 hover:border-red-500 hover:text-red-500 hover:bg-red-50 font-semibold rounded-lg transition-all duration-200">
 <i class="far fa-heart mr-2"></i>
         Yêu thích
</button>
 </div>
         </div>
 }

            <!-- Product Meta -->
      <div class="border-t pt-4 space-y-2 text-sm">
       <div class="flex items-center">
    <span class="font-semibold text-gray-700 w-32">Danh m?c:</span>
        <a href="@Url.Action("Index", "SanPham", new { danhMucId = Model.SanPham.DanhMucId })" class="text-blue-600 hover:underline">
 @Model.SanPham.tb_DanhMuc.TenDanhMuc
            </a>
         </div>
     @if (Model.SanPham.tb_ThuongHieu != null)
      {
         <div class="flex items-center">
            <span class="font-semibold text-gray-700 w-32">Th??ng hi?u:</span>
  <a href="@Url.Action("Index", "SanPham", new { thuongHieuId = Model.SanPham.ThuongHieuId })" class="text-blue-600 hover:underline">
   @Model.SanPham.tb_ThuongHieu.TenThuongHieu
      </a>
   </div>
          }
  <div class="flex items-center">
      <span class="font-semibold text-gray-700 w-32">Mã sản phẩm:</span>
            <span class="text-gray-600 font-mono">@Model.SanPham.MaSanPham</span>
    </div>
            </div>
      </div>
    </div>
</div>

<!-- Product Details Tabs -->
<div class="bg-white rounded-lg shadow-lg p-6 mb-8">
    <div class="border-b border-gray-200">
<nav class="-mb-px flex space-x-8">
       <button class="tab-button active border-b-2 border-blue-600 py-4 px-1 text-sm font-medium text-blue-600 transition-colors" data-tab="details">
      <i class="fas fa-info-circle mr-2"></i>Chi ti?t s?n ph?m
         </button>
   <button class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors" data-tab="specs">
             <i class="fas fa-clipboard-list mr-2"></i>Thông s? k? thu?t
       </button>
  <button class="tab-button border-b-2 border-transparent py-4 px-1 text-sm font-medium text-gray-500 hover:text-gray-700 hover:border-gray-300 transition-colors" data-tab="reviews">
   <i class="fas fa-star mr-2"></i>Đánh giá (@ViewBag.SoLuotDanhGia)
      </button>
     </nav>
    </div>

    <!-- Tab Content -->
    <div class="mt-6">
      <!-- Details Tab -->
        <div id="details-tab" class="tab-content">
   @if (!string.IsNullOrEmpty(Model.SanPham.ChiTiet))
      {
           <div class="prose max-w-none">
     @Html.Raw(Model.SanPham.ChiTiet)
        </div>
      }
          else
   {
       <p class="text-gray-500 italic text-center py-8">Chưa có thông tin chi tiết</p>
        }
        </div>

        <!-- Specs Tab -->
      <div id="specs-tab" class="tab-content hidden">
            @if (Model.SanPham.tb_ThongSo != null && Model.SanPham.tb_ThongSo.Any())
            {
         <!-- Specifications Table -->
     <div class="overflow-hidden rounded-lg border border-gray-200">
      <table class="min-w-full divide-y divide-gray-200">
       <thead class="bg-gradient-to-r from-blue-600 to-blue-700">
                    <tr>
   <th scope="col" class="px-6 py-4 text-left text-sm font-bold text-white uppercase tracking-wider w-1/3">
      <i class="fas fa-cog mr-2"></i>Thông số
         </th>
          <th scope="col" class="px-6 py-4 text-left text-sm font-bold text-white uppercase tracking-wider">
     <i class="fas fa-info-circle mr-2"></i>Giá trị
      </th>
              </tr>
</thead>
              <tbody class="bg-white divide-y divide-gray-200">
                    @foreach (var thongSo in Model.SanPham.tb_ThongSo.OrderBy(t => t.Id))
       {
        <tr class="hover:bg-blue-50 transition-colors odd:bg-gray-50">
     <td class="px-6 py-4 whitespace-nowrap">
             <div class="flex items-center">
            <i class="fas fa-check-circle text-blue-600 mr-3"></i>
     <span class="text-sm font-semibold text-gray-900">@thongSo.TenThongSo</span>
         </div>
    </td>
          <td class="px-6 py-4">
     <span class="text-sm text-gray-700">@thongSo.GiaTri</span>
  </td>
             </tr>
    }
        </tbody>
         </table>
        </div>

    <!-- Specifications Summary Card -->
           <div class="mt-6 grid grid-cols-1 md:grid-cols-3 gap-4">
           <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-lg p-4 border border-blue-200">
  <div class="flex items-center justify-between">
          <div>
              <p class="text-sm text-blue-600 font-medium">Tổng số thông số</p>
             <p class="text-2xl font-bold text-blue-900">@Model.SanPham.tb_ThongSo.Count()</p>
          </div>
       <i class="fas fa-list-ul text-3xl text-blue-400"></i>
   </div>
    </div>
            
 <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-lg p-4 border border-green-200">
          <div class="flex items-center justify-between">
       <div>
        <p class="text-sm text-green-600 font-medium">Đã xác thực</p>
             <p class="text-2xl font-bold text-green-900">100%</p>
     </div>
           <i class="fas fa-shield-alt text-3xl text-green-400"></i>
         </div>
           </div>
         
        <div class="bg-gradient-to-br from-purple-50 to-purple-100 rounded-lg p-4 border border-purple-200">
  <div class="flex items-center justify-between">
      <div>
    <p class="text-sm text-purple-600 font-medium">Chính hãng</p>
       <p class="text-2xl font-bold text-purple-900">?</p>
                </div>
       <i class="fas fa-certificate text-3xl text-purple-400"></i>
             </div>
      </div>
      </div>
        }
         else
   {
          <!-- Empty State -->
        <div class="text-center py-12">
     <i class="fas fa-clipboard-list text-gray-300 text-6xl mb-4"></i>
    <h3 class="text-xl font-semibold text-gray-700 mb-2">Chưa có thông số kĩ thuật</h3>
  <p class="text-gray-500">Thông tin chi tiết sẽ được cập nhật sớm</p>
   </div>
    }
        </div>

        <!-- Reviews Tab -->
     <div id="reviews-tab" class="tab-content hidden">
        <!-- Reviews Summary -->
            <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-6 mb-8">
             <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <!-- Overall Rating -->
