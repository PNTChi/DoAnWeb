        <span class="text-lg font-bold text-red-600">@String.Format("{0:0,0}", sp.GiaKhuyenMai.Value)đ</span>
     <span class="text-sm text-gray-500 line-through">@String.Format("{0:0,0}", sp.Gia.Value)đ</span>
   </div>
