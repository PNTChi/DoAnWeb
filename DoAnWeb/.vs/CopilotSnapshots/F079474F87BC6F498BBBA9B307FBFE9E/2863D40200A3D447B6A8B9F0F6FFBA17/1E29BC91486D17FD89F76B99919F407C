}

<script>
    // ========== TAB SWITCHING FUNCTIONALITY ==========
    $(document).ready(function() {
        // Tab switching
        $('.tab-button').on('click', function() {
  var tabName = $(this).data('tab');
        
            // Remove active class from all tabs
          $('.tab-button').removeClass('active border-blue-600 text-blue-600')
     .addClass('border-transparent text-gray-500');
            
    // Add active class to clicked tab
      $(this).removeClass('border-transparent text-gray-500')
        .addClass('active border-blue-600 text-blue-600');
         
       // Hide all tab contents
 $('.tab-content').addClass('hidden');
       
   // Show selected tab content
 $('#' + tabName + '-tab').removeClass('hidden');
        
          // Smooth scroll to tabs
            $('html, body').animate({
            scrollTop: $('.tab-button').offset().top - 100
            }, 300);
        });
    });

    // ========== IMAGE GALLERY FUNCTIONALITY ==========
    $(document).ready(function() {
        // Thumbnail click to change main image
        $('.thumbnail-image').on('click', function() {
            var newImageSrc = $(this).data('image');
    $('#mainImage').attr('src', newImageSrc);
            
     // Update active thumbnail
            $('.thumbnail-image').removeClass('border-blue-500').addClass('border-gray-200');
      $(this).removeClass('border-gray-200').addClass('border-blue-500');
        });
    });

    // ========== QUANTITY CONTROLS ==========
    function incrementQty() {
        var input = document.getElementById('quantity');
        var currentValue = parseInt(input.value);
        var maxValue = parseInt(input.max);
     
        if (currentValue < maxValue) {
  input.value = currentValue + 1;
        }
    }

    function decrementQty() {
    var input = document.getElementById('quantity');
        var currentValue = parseInt(input.value);
        var minValue = parseInt(input.min);
        
        if (currentValue > minValue) {
      input.value = currentValue - 1;
        }
    }

    // ========== COLOR SELECTION ==========
    $(document).ready(function() {
$('input[name="color"]').on('change', function() {
       $('#selectedColor').val($(this).val());
      });
    });

    // ========== ADD TO CART WITH AJAX (GioHangController.AddToCart) ==========
    $('form[action*="ThemVaoGioHang"]').on('submit', function(e) {
        e.preventDefault();
        
        // Hiển thị loading
        Swal.fire({
            title: 'Đang xử lý...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        
        // Lấy thông tin từ form
        var productId = @Model.SanPham.Id;
        var quantity = parseInt($('#quantity').val());
        var color = $('#selectedColor').val();
        var productName = '@Model.SanPham.TenSanPham';
        var price = @(Model.SanPham.GiaKhuyenMai ?? Model.SanPham.Gia ?? 0);
        var image = '@Url.Content("~/Content/Images/" + Model.SanPham.HinhAnh)';
        
        // Gọi API AddToCart (GioHangController)
        $.ajax({
            url: '@Url.Action("AddToCart", "GioHang")',
            type: 'POST',
            data: {
                productId: productId,
                quantity: quantity,
                color: color
            },
            success: function(response) {
                Swal.close();
                
                if (response.success) {
                    // Hiển thị thông báo thành công với thông tin sản phẩm
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        html: `
                            <div class="text-left">
                                <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg mb-4">
                                    <img src="${image}" alt="${productName}" class="w-20 h-20 object-contain rounded border">
                                    <div>
                                        <p class="font-semibold text-gray-900">${productName}</p>
                                        <p class="text-sm text-gray-600">Giá: ${formatCurrency(price)}</p>
                                        <p class="text-sm text-blue-600">Số lượng: ${quantity}</p>
                                    </div>
                                </div>
                                <p class="text-center text-gray-700">Sản phẩm đã được thêm vào giỏ hàng!</p>
                                <p class="text-center text-sm text-gray-500 mt-2">Tổng: <strong>${response.cartCount}</strong> sản phẩm - <strong>${formatCurrency(response.cartTotal)}</strong></p>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-shopping-cart mr-2"></i>Xem giỏ hàng',
                        cancelButtonText: '<i class="fas fa-shopping-bag mr-2"></i>Tiếp tục mua',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280',
                        customClass: {
                            popup: 'rounded-xl',
                            confirmButton: 'px-6 py-3 rounded-lg font-bold',
                            cancelButton: 'px-6 py-3 rounded-lg font-bold'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Index", "GioHang")';
                        }
                    });
                    
                    // Cập nhật số lượng giỏ hàng trên header (nếu có)
                    if (typeof updateCartCount === 'function') {
                        updateCartCount(response.cartCount);
                    }
                } else if (response.requireLogin) {
                    // Yêu cầu đăng nhập
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vui lòng đăng nhập!',
                        text: response.message,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })';
                        }
                    });
                } else {
                    // Lỗi khác
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: response.message,
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#ef4444'
                    });
                }
            },
            error: function() {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra. Vui lòng thử lại.',
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: '#ef4444'
                });
            }
        });
    });
    
    // Format currency helper
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN').format(amount) + ' ₫';
    }

    // ========== BUY NOW FUNCTIONALITY ==========
    function buyNow() {
        // Hiển thị loading
        Swal.fire({
            title: 'Đang xử lý...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });
        
        // Lấy thông tin từ form
        var productId = @Model.SanPham.Id;
        var quantity = parseInt($('#quantity').val());
        var color = $('#selectedColor').val();
        
        // Gọi API AddToCart và redirect đến giỏ hàng
        $.ajax({
            url: '@Url.Action("AddToCart", "GioHang")',
            type: 'POST',
            data: {
                productId: productId,
                quantity: quantity,
                color: color
            },
            success: function(response) {
                Swal.close();
                
                if (response.success) {
                    // Redirect to cart/checkout page
                    window.location.href = '@Url.Action("Index", "GioHang")';
                } else if (response.requireLogin) {
                    // Yêu cầu đăng nhập
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vui lòng đăng nhập!',
                        text: response.message,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })';
                        }
                    });
                } else {
                    // Lỗi khác
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: response.message,
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#ef4444'
                    });
                }
            },
            error: function() {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra. Vui lòng thử lại.',
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: '#ef4444'
                });
            }
        });
    }

    // ========== REVIEWS FUNCTIONALITY ==========

    // Toggle review form
    function toggleReviewForm() {
        $('#reviewForm').slideToggle(300);
        // Reset form if hiding
        if ($('#reviewForm').is(':visible')) {
        $('html, body').animate({
           scrollTop: $('#reviewForm').offset().top - 100
            }, 500);
        } else {
            $('#submitReviewForm')[0].reset();
         resetStars();
        }
    }

    // Star rating interaction
    var selectedRating = 0;
    var ratingTexts = ['', 'Rất tệ', 'Tệ', 'Trung bình', 'Tốt', 'Rất tốt'];

    $('.star-icon').hover(
        function() {
var rating = $(this).data('rating');
            highlightStars(rating);
     $('#ratingText').text(ratingTexts[rating]);
    },
        function() {
            highlightStars(selectedRating);
            $('#ratingText').text(selectedRating > 0 ? ratingTexts[selectedRating] : 'Chọn số sao');
}
    );

    $('.star-icon').click(function() {
        selectedRating = $(this).data('rating');
        $('#ratingValue').val(selectedRating);
        highlightStars(selectedRating);
        $('#ratingText').text(ratingTexts[selectedRating]);
    });

    function highlightStars(rating) {
        $('.star-icon').each(function(index) {
            if (index < rating) {
         $(this).removeClass('far text-gray-300').addClass('fas text-yellow-400');
  } else {
                $(this).removeClass('fas text-yellow-400').addClass('far text-gray-300');
            }
        });
  }

    function resetStars() {
        selectedRating = 0;
        $('#ratingValue').val(0);
        highlightStars(0);
 $('#ratingText').text('Chọn số sao');
    }

    // Submit review via AJAX
    $('#submitReviewForm').on('submit', function(e) {
   e.preventDefault();
      
        console.log('Submitting review...');

        // Validate rating
        if (parseInt($('#ratingValue').val()) < 1) {
         Swal.fire({
   icon: 'warning',
                title: 'Vui lòng chọn số sao',
    timer: 2000
            });
        return;
        }
        
        var formData = $(this).serialize();
   console.log('Form data:', formData);
        
        $.ajax({
  url: '@Url.Action("ThemDanhGia", "SanPham")',
            type: 'POST',
   data: formData,
            beforeSend: function() {
        console.log('Sending AJAX request...');
    },
            success: function(response) {
      console.log('AJAX response:', response);
                if (response.success) {
       Swal.fire({
            icon: 'success',
              title: 'Thành công!',
     text: response.message,
      timer: 2000,
         showConfirmButton: false
             }).then(function() {
            // Reload page to show new review (server-side rendering)
             location.reload();
   });
    } else {
        Swal.fire({
              icon: 'error',
     title: 'Lỗi!',
    text: response.message,
       timer: 2000
         });
     }
            },
            error: function(xhr, status, error) {
  console.error('AJAX error:', error);
             console.error('Status:', status);
        console.error('Response:', xhr.responseText);
      Swal.fire({
           icon: 'error',
      title: 'Lỗi!',
        text: 'Có lỗi xảy ra. Vui lòng thử lại sau.',
         timer: 2000
    });
            }
    });
    });
</script>
     