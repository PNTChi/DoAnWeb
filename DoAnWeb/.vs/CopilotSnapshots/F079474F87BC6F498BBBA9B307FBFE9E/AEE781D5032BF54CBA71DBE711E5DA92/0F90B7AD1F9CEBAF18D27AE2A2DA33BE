@model DoAnWeb.tb_TaiKhoan
@{
    ViewBag.Title = "formSuaQTV";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@using (Html.BeginForm("SuaQTV", "Admin", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    <h3 id="formAdminTitle">Sửa admin</h3>
    <hr>
    @Html.ValidationSummary(true)
    @Html.HiddenFor(model => model.Id)

    <div class="mb-3">
        @Html.Label("TenDangNhap", "Tên đăng nhập", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.TenDangNhap, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.TenDangNhap)
    </div>
    <div class="mb-3">
        @Html.Label("MatKhau", "Mật khẩu", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.MatKhau, new { htmlAttributes = new { @class = "form-control", type = "password" } })
        @Html.ValidationMessageFor(model => model.MatKhau)
    </div>
    <div class="mb-3">
        @Html.Label("HoTen", "Họ tên", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.HoTen, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.HoTen)
    </div>
    <div class="mb-3">
        @Html.Label("Email", "Email", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.Email)
    </div>
    <div class="mb-3">
        @Html.Label("SoDienThoai", "Số điện thoại", htmlAttributes: new { @class = "form-label" })
        @Html.EditorFor(model => model.SoDienThoai, new { htmlAttributes = new { @class = "form-control" } })
        @Html.ValidationMessageFor(model => model.SoDienThoai)
    </div>
    <div class="mb-3">
        @Html.Label("QuyenId", "Vai trò / Quyền hạn", htmlAttributes: new { @class = "form-label" })
        @Html.DropDownList("QuyenId", (SelectList)ViewBag.Quyen, "-- Chọn vai trò --", new { @class = "form-select" })
        @Html.ValidationMessageFor(model => model.QuyenId, "", new { @class = "text-danger" })
        <small class="form-text text-muted">
            <i class="fas fa-info-circle"></i> 
            <strong>Admin:</strong> Toàn quyền quản lý hệ thống | 
            <strong>Staff:</strong> Quyền hạn giới hạn (quản lý sản phẩm, đơn hàng, khách hàng)
        </small>
    </div>
    <div class="mb-3">
        @Html.Label("HoatDong", "Hoạt động", htmlAttributes: new { @class = "form-label" })
        <div class="form-check form-switch">
            @Html.CheckBox("HoatDong", new { @class = "form-check-input", @id = "HoatDongSwitch" })
            <label class="form-check-label" for="HoatDongSwitch">
                Tài khoản đang hoạt động
            </label>
        </div>
        @Html.ValidationMessageFor(model => model.HoatDong, "", new { @class = "text-danger" })
    </div>

    <div class="mt-4">
        <button type="submit" class="btn btn-primary">
            <i class="fas fa-save"></i> Lưu thay đổi
        </button>
        <a href="@Url.Action("QuanTriVien", "Admin")" class="btn btn-secondary">
            <i class="fas fa-times"></i> Hủy
        </a>
    </div>
}