@model List<DoAnWeb.Models.QLDonHangViewModel>

@{
    ViewBag.Title = "DonHang";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<div id="orders" class="tab-content active">
    <h1 class="mb-4">Quản lý đơn hàng</h1>
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimDonHang" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timdh" name="timdh" placeholder="Tìm kiếm sản phẩm...">
                <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
            </form>
            <select class="form-select w-25" id="filterOrder" onchange="location = this.value;">
                <option value="@Url.Action("DonHang", "Admin")">Tất cả</option>
                @foreach (var trangthai in Model.Select(m => m.TrangThai).Distinct())
                {
                    <option value="@Url.Action("LocDonHang", "Admin", new { trangthai = trangthai })">
                        @trangthai
                    </option>
                }
            </select>
        </div>
        <table class="table table-bordered table-hover" id="orderTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Mã đơn hàng</th>
                    <th>Tên khách hàng</th>
                    <th>Số điện thoại</th>
                    <th>Địa chỉ</th>
                    <th>Email</th>
                    <th>Tổng tiền</th>
                    <th>Loại thanh toán</th>
                    <th>Trạng thái</th>
                    <th>Ngày tạo</th>
                    <th>Phương thức vận chuyển</th>
                    <th>Mã giảm giá</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="orderTableBody">
                @foreach (var item in Model)
                {
                    <tr id="order-1">
                        <td>@item.Id</td>
                        <td>@item.MaDonHang</td>
                        <td>@item.TenKhachHang</td>
                        <td>@item.SoDienThoai</td>
                        <td>@item.DiaChi</td>
                        <td>@item.Email</td>
                        <td>@item.TongTien</td>
                        <td>@item.PhuongThucThanhToan</td>
                        <td>
                            @{
                                string statusBadge = "";
                                string statusText = "";
                                switch (item.TrangThai)
                                {
                                    case 1:
                                        statusBadge = "bg-warning";
                                        statusText = "Chờ xác nhận";
                                        break;
                                    case 2:
                                        statusBadge = "bg-info";
                                        statusText = "Đã xác nhận";
                                        break;
                                    case 3:
                                        statusBadge = "bg-primary";
                                        statusText = "Đang giao";
                                        break;
                                    case 4:
                                        statusBadge = "bg-success";
                                        statusText = "Đã giao";
                                        break;
                                    case 5:
                                        statusBadge = "bg-dark";
                                        statusText = "Hoàn thành";
                                        break;
                                    case 6:
                                        statusBadge = "bg-warning text-dark";
                                        statusText = "Yêu cầu trả hàng";
                                        break;
                                    case 7:
                                        statusBadge = "bg-secondary";
                                        statusText = "Đã trả hàng";
                                        break;
                                    default:
                                        statusBadge = "bg-secondary";
                                        statusText = "Không xác định";
                                        break;
                                }
                            }
                            <span class="badge @statusBadge">@statusText</span>
                        </td>
                        <td>@item.NgayTao</td>
                        <td>@item.PhuongThucVanChuyen</td>
                        <td>@item.MaGiamGia</td>
                        <td>
                            <button class="btn btn-sm btn-info" onclick="showInvoiceModal(this)" title="In hóa đơn">
                                <i class="fas fa-print"></i>
                            </button>
                            
                            @if (item.TrangThai == -1)
                            {
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Đã hoàn tiền
                                </span>
                            }
                            else if (item.TrangThai == 4)
                            {
                                <button class="btn btn-sm btn-success" onclick="hoanThanhDonHang(@item.Id)" title="Hoàn thành đơn hàng">
                                    <i class="fas fa-check-double"></i>
                                </button>
                            }
                            else if (item.TrangThai == 5)
                            {
                                <span class="badge bg-success">Đã hoàn thành</span>
                            }
                            else if (item.TrangThai == 6)
                            {
                                <button class="btn btn-sm btn-success" onclick="xacNhanTraHang(@item.Id)" title="Xác nhận đã nhận hàng trả lại">
                                    <i class="fas fa-check-circle"></i>
                                </button>
                            }
                            else if (item.TrangThai == 7)
                            {
                                <span class="badge bg-secondary">
                                    <i class="fas fa-box-open"></i> Đã trả hàng
                                </span>
                            }
                            else if (item.TrangThai < 4)
                            {
                                <button class="btn btn-sm btn-primary" onclick="capNhatTrangThai(@item.Id, @item.TrangThai)" title="Cập nhật trạng thái">
                                    <i class="fas fa-sync"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DonHang" : "TimDonHang",
                    new { timdh = ViewBag.TuKhoa, page = currentPage - 1 })">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(
                        String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DonHang" : "TimDonHang",
                        new { timdh = ViewBag.TuKhoa, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "DonHang" : "TimDonHang",
                    new { timdh = ViewBag.TuKhoa, page = currentPage + 1 })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function hoanThanhDonHang(orderId) {
        Swal.fire({
            title: 'Xác nhận hoàn thành đơn hàng?',
            text: 'Đơn hàng đã được giao thành công và khách hàng đã nhận được hàng?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Xác nhận hoàn thành',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("HoanThanhDonHang", "Admin")',
                    type: 'POST',
                    data: { id: orderId },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi cập nhật trạng thái', 'error');
                    }
                });
            }
        });
    }

    function capNhatTrangThai(orderId, currentStatus) {
        const statusOptions = {
            1: { next: 2, text: 'Xác nhận đơn hàng' },
            2: { next: 3, text: 'Chuyển sang đang giao' },
            3: { next: 4, text: 'Xác nhận đã giao' }
        };

        const option = statusOptions[currentStatus];
        if (!option) {
            Swal.fire('Thông báo', 'Không thể cập nhật trạng thái này', 'info');
            return;
        }

        Swal.fire({
            title: 'Cập nhật trạng thái?',
            text: option.text + '?',
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#3b82f6',
            cancelButtonColor: '#6b7280',
            confirmButtonText: 'Xác nhận',
            cancelButtonText: 'Hủy'
        }).then((result) => {
            if (result.isConfirmed) {
                $.ajax({
                    url: '@Url.Action("CapNhatTrangThaiDonHang", "Admin")',
                    type: 'POST',
                    data: {
                        id: orderId,
                        trangThaiMoi: option.next
                    },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire('Thành công!', response.message, 'success')
                                .then(() => {
                                    window.location.reload();
                                });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi cập nhật trạng thái', 'error');
                    }
                });
            }
        });
    }

    function xacNhanTraHang(orderId) {
        Swal.fire({
            title: 'Xác nhận đã nhận hàng trả lại?',
            html: `
                <div class="text-start">
                    <p class="text-info"><i class="fas fa-info-circle"></i> <strong>Lưu ý:</strong></p>
                    <ul class="text-start">
                        <li>Xác nhận đã nhận được hàng trả lại từ khách</li>
                        <li>Số lượng sản phẩm đã được hoàn vào kho</li>
                        <li>Trạng thái đơn hàng sẽ chuyển sang "Đã trả hàng"</li>
                        <li>Thao tác này không thể hoàn tác!</li>
                    </ul>
                    <p>Bạn có chắc chắn đã nhận được hàng trả lại?</p>
                </div>
            `,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#10b981',
            cancelButtonColor: '#6b7280',
            confirmButtonText: '<i class="fas fa-check-circle"></i> Xác nhận đã trả hàng',
            cancelButtonText: 'Hủy',
            width: '600px'
        }).then((result) => {
            if (result.isConfirmed) {
                // Show loading
                Swal.fire({
                    title: 'Đang xử lý...',
                    html: 'Vui lòng đợi trong giây lát',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                $.ajax({
                    url: '@Url.Action("XacNhanTraHang", "Admin")',
                    type: 'POST',
                    data: { id: orderId },
                    success: function (response) {
                        if (response.success) {
                            Swal.fire({
                                title: 'Xác nhận thành công!',
                                html: `
                                    <div class="text-start">
                                        <p class="text-success"><i class="fas fa-check-circle"></i> ${response.message}</p>
                                        <hr>
                                        <p><strong>Đã hoàn tất:</strong></p>
                                        <ul>
                                            <li>✓ Đã nhận hàng trả lại</li>
                                            <li>✓ Số lượng sản phẩm đã trong kho</li>
                                            <li>✓ Đơn hàng đã hoàn tất xử lý</li>
                                        </ul>
                                    </div>
                                `,
                                icon: 'success',
                                confirmButtonColor: '#10b981'
                            }).then(() => {
                                window.location.reload();
                            });
                        } else {
                            Swal.fire('Lỗi!', response.message, 'error');
                        }
                    },
                    error: function () {
                        Swal.fire('Lỗi!', 'Có lỗi xảy ra khi xác nhận', 'error');
                    }
                });
            }
        });
    }
</script>
}
