@model List<DoAnWeb.tb_TinTuc>

@{
    ViewBag.Title = "Tin tức";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
     <li class="inline-flex items-center">
   <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
         <i class="fas fa-home mr-2"></i>
      Trang chủ
   </a>
        </li>
  <li aria-current="page">
   <div class="flex items-center">
     <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
     <span class="text-sm font-medium text-gray-500">Tin tức</span>
 </div>
        </li>
    </ol>
</nav>

<!-- Page Header -->
<div class="bg-gradient-to-r from-blue-500 to-cyan-500 rounded-lg shadow-lg p-8 mb-6 text-white">
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div class="flex-1">
            @if (ViewBag.IsSearching == true)
            {
                <!-- Search Result Header -->
                <h1 class="text-4xl font-bold mb-2 flex items-center">
                    <i class="fas fa-search mr-3"></i>
                    KẾT QUẢ TÌM KIẾM
                </h1>
                <p class="text-lg opacity-90">
                    Tìm thấy <strong>@ViewBag.TotalNews</strong> kết quả cho "<strong>@ViewBag.SearchKeyword</strong>"
                </p>
                <a href="@Url.Action("Index", "TinTuc")" 
                   class="inline-flex items-center mt-3 px-4 py-2 bg-white bg-opacity-20 hover:bg-opacity-30 rounded-lg text-sm font-semibold transition-all">
                    <i class="fas fa-times mr-2"></i>
                    Xóa bộ lọc
                </a>
            }
            else
            {
                <!-- Normal Header -->
                <h1 class="text-4xl font-bold mb-2 flex items-center">
                    <i class="fas fa-newspaper mr-3"></i>
                    TIN TỨC & SỰ KIỆN
                </h1>
                <p class="text-lg opacity-90">
                    Cập nhật tin tức công nghệ mới nhất | Tìm thấy <strong>@ViewBag.TotalNews</strong> bài viết
                </p>
            }
        </div>
    </div>
</div>

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Main Content (3/4) -->
    <div class="lg:col-span-3">
        <!-- Filter & Sort Bar -->
  <div class="bg-white rounded-lg shadow-md p-4 mb-6">
   <div class="flex items-center justify-between flex-wrap gap-4">
    <!-- Category Filter -->
          <div class="flex items-center space-x-3">
        <label class="text-sm font-semibold text-gray-700">
   <i class="fas fa-filter mr-2"></i>Danh mục:
     </label>
         <select id="danhMucFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        <option value="0" @(ViewBag.DanhMucId == 0 ? "selected" : "")>Tất cả</option>
      @if (ViewBag.DanhMucTinList != null)
     {
        foreach (var dm in (List<DoAnWeb.tb_DanhMucTin>)ViewBag.DanhMucTinList)
      {
       <option value="@dm.Id" @(ViewBag.DanhMucId == dm.Id ? "selected" : "")>
             @dm.TenDanhMuc
   </option>
           }
    }
        </select>
       </div>

   <!-- Sort Options -->
   <div class="flex items-center space-x-3">
    <label class="text-sm font-semibold text-gray-700">
     <i class="fas fa-sort mr-2"></i>Sắp xếp:
   </label>
       <select id="sortBy" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
       <option value="newest" @(ViewBag.SortBy == "newest" ? "selected" : "")>Mới nhất</option>
     <option value="oldest" @(ViewBag.SortBy == "oldest" ? "selected" : "")>Cũ nhất</option>
     <option value="popular" @(ViewBag.SortBy == "popular" ? "selected" : "")>Xem nhiều</option>
 <option value="title_asc" @(ViewBag.SortBy == "title_asc" ? "selected" : "")>Tiêu đề A-Z</option>
     <option value="title_desc" @(ViewBag.SortBy == "title_desc" ? "selected" : "")>Tiêu đề Z-A</option>
    </select>
   </div>
      </div>
  </div>

        <!-- News Grid -->
  @if (Model.Any())
      {
   <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
      @foreach (var tin in Model)
     {
       <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })" 
         class="group block bg-white rounded-lg overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
        
      <!-- Image -->
       <div class="aspect-video overflow-hidden bg-gray-100 relative">
        @if (!string.IsNullOrEmpty(tin.HinhAnh))
     {
       <img src="@Url.Content("~/Content/Images/" + tin.HinhAnh)" 
    alt="@tin.TieuDe" 
           class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-300" />
           }
       else
   {
        <img src="@Url.Content("~/Content/Images/no-image.png")" 
 alt="No Image" 
class="w-full h-full object-contain opacity-30" />
     }
         
      <!-- Category Badge -->
    @if (tin.tb_DanhMucTin != null)
    {
      <div class="absolute top-3 left-3">
       <span class="bg-blue-500 text-white text-xs font-bold px-3 py-1 rounded-full">
        @tin.tb_DanhMucTin.TenDanhMuc
      </span>
    </div>
 }
      </div>

       <!-- Content -->
       <div class="p-5">
         <!-- Date -->
 <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
      <span>
        <i class="far fa-calendar mr-1"></i>
 @(tin.NgayTao?.ToString("dd/MM/yyyy") ?? "N/A")
</span>
     <span>
        <i class="far fa-user mr-1"></i>
       @(tin.NguoiTao ?? "Admin")
      </span>
        </div>

     <!-- Title -->
   <h3 class="text-lg font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
    @tin.TieuDe
  </h3>

      <!-- Summary -->
    @if (!string.IsNullOrEmpty(tin.MoTa))
          {
         <p class="text-sm text-gray-600 line-clamp-3 mb-4">
  @tin.MoTa
    </p>
}

    <!-- Read More -->
           <div class="flex items-center text-blue-600 font-semibold text-sm">
      <span class="group-hover:mr-2 transition-all">Đọc thêm</span>
 <i class="fas fa-arrow-right opacity-0 group-hover:opacity-100 transition-opacity"></i>
      </div>
  </div>
      </a>
   }
       </div>

         <!-- Pagination -->
  if (ViewBag.TotalPages > 1)
    {
        var searchParam = ViewBag.IsSearching == true ? "&q=" + ViewBag.SearchKeyword : "";
     <div class="flex justify-center items-center space-x-2">
      <!-- Previous -->
 @if (ViewBag.CurrentPage > 1)
     {
    <a href="?danhMucId=@ViewBag.DanhMucId&sortBy=@ViewBag.SortBy@searchParam&page=@(ViewBag.CurrentPage - 1)" 
     class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-blue-50 hover:border-blue-500">
 <i class="fas fa-chevron-left"></i>
          </a>
  }

     <!-- Page Numbers -->
      @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
 {
  <a href="?danhMucId=@ViewBag.DanhMucId&sortBy=@ViewBag.SortBy@searchParam&page=@i" 
   class="px-4 py-2 rounded-lg @(i == ViewBag.CurrentPage ? "bg-blue-500 text-white" : "bg-white border border-gray-300 hover:bg-blue-50")">
     @i
    </a>
 }

       <!-- Next -->
  @if (ViewBag.CurrentPage < ViewBag.TotalPages)
       {
       <a href="?danhMucId=@ViewBag.DanhMucId&sortBy=@ViewBag.SortBy@searchParam&page=@(ViewBag.CurrentPage + 1)" 
class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-blue-50 hover:border-blue-500">
     <i class="fas fa-chevron-right"></i>
       </a>
        }
      </div>
  }
        }
  else
 {
   <!-- Empty State -->
     <div class="bg-white rounded-lg shadow-md p-12 text-center">
    <i class="fas fa-newspaper text-gray-300 text-6xl mb-4"></i>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Chưa có tin tức</h3>
     <p class="text-gray-600">Vui lòng quay lại sau</p>
   </div>
        }
    </div>

    <!-- Sidebar (1/4) -->
    <div class="lg:col-span-1 space-y-6">
    <!-- Search Box with Live Search -->
    <div class="bg-white rounded-lg shadow-md p-5">
        <h3 class="text-lg font-bold text-gray-900 mb-4 flex items-center">
            <i class="fas fa-search mr-2 text-blue-600"></i>
            Tìm kiếm
        </h3>
        <form id="searchForm" action="@Url.Action("Index", "TinTuc")" method="get">
            <div class="relative">
                <input type="text" 
                       id="searchInput"
                       name="q" 
                       value="@ViewBag.SearchKeyword"
                       placeholder="Nhập từ khóa..." 
                       class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" 
                       autocomplete="off">
                <button type="submit" class="absolute right-3 top-1/2 -translate-y-1/2 text-blue-600 hover:text-blue-700">
                    <i class="fas fa-search text-xl"></i>
                </button>
                
                <!-- Live Search Dropdown -->
                <div id="searchDropdown" class="hidden absolute top-full left-0 right-0 mt-2 bg-white rounded-lg shadow-xl border border-gray-200 z-50 max-h-96 overflow-y-auto">
                    <!-- Results will be populated here -->
                </div>
            </div>
        </form>
    </div>

        <!-- Tin nổi bật -->
        @if (ViewBag.TinNoiBat != null && ((List<DoAnWeb.tb_TinTuc>)ViewBag.TinNoiBat).Any())
  {
   <div class="bg-white rounded-lg shadow-md p-5">
    <h3 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b flex items-center">
     <i class="fas fa-star mr-2 text-yellow-500"></i>
     Tin nổi bật
    </h3>
     <div class="space-y-4">
        @foreach (var tin in (List<DoAnWeb.tb_TinTuc>)ViewBag.TinNoiBat)
  {
       <a href="@Url.Action("ChiTiet", "TinTuc", new { id = tin.Id })" 
      class="flex items-start space-x-3 group">
       @if (!string.IsNullOrEmpty(tin.HinhAnh))
 {
     <img src="@Url.Content("~/Content/Images/" + tin.HinhAnh)" 
        alt="@tin.TieuDe" 
     class="w-20 h-20 object-cover rounded flex-shrink-0" />
 }
    <div class="flex-1 min-w-0">
     <h4 class="text-sm font-semibold text-gray-900 line-clamp-2 group-hover:text-blue-600 mb-1">
     @tin.TieuDe
 </h4>
        <p class="text-xs text-gray-500">
     <i class="far fa-calendar mr-1"></i>
        @(tin.NgayTao?.ToString("dd/MM/yyyy") ?? "")
      </p>
      </div>
      </a>
   }
      </div>
       </div>
        }
    </div>
</div>

@section scripts {
<script>
    $(document).ready(function() {
        // ===== FILTER & SORT WITH LOADING =====
        $('#danhMucFilter, #sortBy').on('change', function() {
            var danhMucId = $('#danhMucFilter').val();
            var sortBy = $('#sortBy').val();
            var searchKeyword = $('#searchInput').val().trim();
            
            // Show loading overlay
            showLoadingOverlay();
            
            var url = '@Url.Action("Index", "TinTuc")';
            url += '?danhMucId=' + danhMucId;
            url += '&sortBy=' + sortBy;
            if (searchKeyword) {
                url += '&q=' + encodeURIComponent(searchKeyword);
            }
            
            window.location.href = url;
        });

        // ===== LIVE SEARCH =====
        var searchTimeout;
        var $searchInput = $('#searchInput');
        var $searchDropdown = $('#searchDropdown');

        $searchInput.on('input', function() {
            clearTimeout(searchTimeout);
            var keyword = $(this).val().trim();

            if (keyword.length < 2) {
                $searchDropdown.addClass('hidden').empty();
                return;
            }

            searchTimeout = setTimeout(function() {
                performLiveSearch(keyword);
            }, 300); // Debounce 300ms
        });

        // Close dropdown when clicking outside
        $(document).on('click', function(e) {
            if (!$(e.target).closest('#searchInput, #searchDropdown').length) {
                $searchDropdown.addClass('hidden');
            }
        });

        function performLiveSearch(keyword) {
            $.ajax({
                url: '@Url.Action("LiveSearch", "TinTuc")',
                type: 'GET',
                data: { q: keyword },
                dataType: 'json',
                beforeSend: function() {
                    $searchDropdown.html('<div class="p-4 text-center"><i class="fas fa-spinner fa-spin text-blue-600 text-2xl"></i></div>').removeClass('hidden');
                },
                success: function(response) {
                    if (response.success && response.results && response.results.length > 0) {
                        var html = '<div class="p-2">';
                        
                        // Header
                        html += '<div class="px-3 py-2 text-xs font-semibold text-gray-500 border-b">';
                        html += 'Tìm thấy ' + response.count + ' kết quả';
                        html += '</div>';

                        // Results
                        $.each(response.results, function(index, item) {
                            html += '<a href="/TinTuc/ChiTiet/' + item.id + '" class="flex items-start p-3 hover:bg-blue-50 transition-colors border-b last:border-b-0">';
                            
                            // Image
                            var imageUrl = item.hinhAnh ? '/Content/Images/' + item.hinhAnh : '/Content/Images/no-image.png';
                            html += '<img src="' + imageUrl + '" alt="' + escapeHtml(item.tieuDe) + '" class="w-20 h-20 object-cover rounded flex-shrink-0 mr-3" onerror="this.src=\'/Content/Images/no-image.png\'" />';
                            
                            // Info
                            html += '<div class="flex-1 min-w-0">';
                            html += '<h4 class="text-sm font-semibold text-gray-900 line-clamp-2 mb-1">' + escapeHtml(item.tieuDe) + '</h4>';
                            html += '<p class="text-xs text-gray-500">';
                            html += '<i class="far fa-calendar mr-1"></i>' + item.ngayTao;
                            if (item.danhMuc) {
                                html += ' <span class="mx-2">•</span> <span class="text-blue-600">' + escapeHtml(item.danhMuc) + '</span>';
                            }
                            html += '</p>';
                            html += '</div>';
                            
                            // Arrow
                            html += '<i class="fas fa-chevron-right text-gray-400 self-center"></i>';
                            html += '</a>';
                        });
                        
                        // View All - Submit form to search
                        html += '<div class="p-3 border-t bg-gray-50">';
                        html += '<a href="javascript:void(0)" class="block text-center text-blue-600 hover:text-blue-700 font-semibold text-sm" onclick="$(\'#searchInput\').val(\'' + escapeHtml(keyword) + '\'); $(\'#searchForm\').submit();">';
                        html += '<i class="fas fa-search mr-2"></i>Xem tất cả kết quả';
                        html += '</a>';
                        html += '</div>';
                        
                        html += '</div>';
                        
                        $searchDropdown.html(html).removeClass('hidden');
                    } else {
                        // No results
                        var noResultHtml = '<div class="p-6 text-center">';
                        noResultHtml += '<i class="fas fa-search text-gray-300 text-3xl mb-2"></i>';
                        noResultHtml += '<p class="text-gray-500 text-sm">Không tìm thấy kết quả</p>';
                        noResultHtml += '</div>';
                        $searchDropdown.html(noResultHtml).removeClass('hidden');
                    }
                },
                error: function() {
                    $searchDropdown.html('<div class="p-4 text-center text-red-600 text-sm">Có lỗi xảy ra, vui lòng thử lại</div>').removeClass('hidden');
                }
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, function(m) { return map[m]; });
        }

        function showLoadingOverlay() {
            var overlay = $('<div class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center">')
                .append('<div class="bg-white rounded-lg p-6 shadow-xl"><i class="fas fa-spinner fa-spin text-blue-600 text-3xl mb-2"></i><p class="text-gray-700 font-semibold">Đang tải...</p></div>');
            $('body').append(overlay);
        }

        // ===== SMOOTH SCROLL TO TOP =====
        $('.pagination a').on('click', function() {
            $('html, body').animate({ scrollTop: 0 }, 300);
        });

        // ===== ANIMATION ON LOAD =====
        $('.article-card, .group').each(function(index) {
            $(this).css({
                'opacity': '0',
                'transform': 'translateY(20px)'
            }).delay(index * 50).animate({
                opacity: 1
            }, 500, function() {
                $(this).css('transform', 'translateY(0)');
            });
        });
    });
</script>
}
