@model DoAnWeb.Models.LoginViewModel

@{
    ViewBag.Title = "Đăng nhập / Đăng ký";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - TECH SHOP</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <style>
        body {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            margin: 0;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .auth-container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            padding: 40px;
            width: 100%;
            max-width: 450px;
        }

        .auth-form {
            display: none;
        }

            .auth-form.active {
                display: block;
                animation: fadeIn 0.5s ease-in;
            }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .form-heading {
            font-size: 28px;
            font-weight: bold;
            color: #333;
            margin-bottom: 30px;
            text-align: center;
        }

        .input-group {
            position: relative;
            margin-bottom: 25px;
        }

            .input-group input {
                width: 100%;
                padding: 12px 15px;
                border: 2px solid #e0e0e0;
                border-radius: 10px;
                font-size: 16px;
                transition: all 0.3s;
                outline: none;
            }

                .input-group input:focus {
                    border-color: #667eea;
                    box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
                }

            .input-group label {
                position: absolute;
                top: 12px;
                left: 15px;
                color: #999;
                pointer-events: none;
                transition: all 0.3s;
                background: white;
                padding: 0 5px;
            }

            .input-group input:focus + label,
            .input-group input:not(:placeholder-shown) + label {
                top: -10px;
                font-size: 12px;
                color: #667eea;
            }

        .password-toggle {
            position: absolute;
            right: 15px;
            top: 50%;
            transform: translateY(-50%);
            cursor: pointer;
            color: #999;
        }

            .password-toggle:hover {
                color: #667eea;
            }

        .submit-btn {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 16px;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s;
        }

            .submit-btn:hover {
                transform: translateY(-2px);
                box-shadow: 0 10px 20px rgba(102, 126, 234, 0.3);
            }

        .forget-password {
            text-align: right;
            margin-bottom: 20px;
        }

            .forget-password a {
                color: #667eea;
                text-decoration: none;
                font-size: 14px;
            }

                .forget-password a:hover {
                    text-decoration: underline;
                }

        .divider-text {
            text-align: center;
            margin: 20px 0;
            color: #999;
            position: relative;
        }

            .divider-text::before,
            .divider-text::after {
                content: '';
                position: absolute;
                top: 50%;
                width: 40%;
                height: 1px;
                background: #e0e0e0;
            }

            .divider-text::before {
                left: 0;
            }

            .divider-text::after {
                right: 0;
            }

        .social-login button {
            width: 100%;
            padding: 12px;
            margin-bottom: 10px;
            border: 2px solid #e0e0e0;
            border-radius: 10px;
            background: white;
            cursor: pointer;
            transition: all 0.3s;
            font-size: 14px;
        }

        .btn-google:hover {
            border-color: #db4437;
            color: #db4437;
        }

        .btn-facebook:hover {
            border-color: #4267B2;
            color: #4267B2;
        }

        .switch-form-link {
            text-align: center;
            margin-top: 20px;
            color: #666;
        }

            .switch-form-link a {
                color: #667eea;
                font-weight: bold;
                cursor: pointer;
                text-decoration: none;
            }

                .switch-form-link a:hover {
                    text-decoration: underline;
                }

        .alert {
            padding: 12px 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            font-size: 14px;
        }

        .alert-danger {
            background: #fee;
            color: #c33;
            border: 1px solid #fcc;
        }

        .alert-success {
            background: #efe;
            color: #3c3;
            border: 1px solid #cfc;
        }
    </style>
</head>
<body>
    <div class="auth-container">
        @* Hiển thị thông báo *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">
                <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (!string.IsNullOrEmpty(ViewBag.ErrorMessage))
        {
            <div class="alert alert-danger">
                <i class="fas fa-exclamation-circle"></i> @ViewBag.ErrorMessage
            </div>
        }

        <!-- Form Đăng nhập -->
        @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "auth-form active", id = "login-form" }))
        {
            @Html.AntiForgeryToken()

            <h2 class="form-heading">Đăng nhập</h2>

            @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })

            <div class="input-group">
                @Html.TextBoxFor(m => m.Email, new
                {
                    @class = "form-control",
                    placeholder = " ",
                    id = "login-email",
                    type = "email",
                    required = "required"
                })
                @Html.LabelFor(m => m.Email, "Email", new { @class = "label" })
                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })
            </div>

            <div class="input-group">
                @Html.PasswordFor(m => m.Password, new
                {
                    @class = "form-control",
                    placeholder = " ",
                    id = "login-password",
                    required = "required"
                })
                @Html.LabelFor(m => m.Password, "Mật khẩu", new { @class = "label" })
                <i class="fas fa-eye password-toggle" data-target="login-password"></i>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>

            <div class="forget-password">
                <a href="@Url.Action("ForgotPassword", "Account")">
                    <i class="fas fa-key mr-1"></i> Quên mật khẩu?
                </a>
            </div>

            <button class="submit-btn" type="submit">Đăng nhập</button>

            <div class="switch-form-link">
                Bạn chưa có tài khoản? <a id="show-register-form" href="javascript:void(0);">Đăng ký</a>
            </div>
        }

        <!-- Form Đăng ký -->
        <form action="@Url.Action("Register", "Account")" method="post" class="auth-form" id="register-form">
            @Html.AntiForgeryToken()

            <h2 class="form-heading">Đăng ký</h2>

            <div class="input-group">
                <input type="text"
                       name="FullName"
                       id="fullname"
                       class="form-control"
                       placeholder=" "
                       required />
                <label for="fullname" class="label">Họ và tên</label>
            </div>

            <div class="input-group">
                <input type="email"
                       name="Email"
                       id="register-email"
                       class="form-control"
                       placeholder=" "
                       required />
                <label for="register-email" class="label">Email</label>
            </div>

            <div class="input-group">
                <input type="password"
                       name="Password"
                       id="register-password"
                       class="form-control"
                       placeholder=" "
                       required />
                <label for="register-password" class="label">Mật khẩu</label>
                <i class="fas fa-eye password-toggle" data-target="register-password"></i>
            </div>

            <div class="input-group">
                <input type="password"
                       name="ConfirmPassword"
                       id="confirm-password"
                       class="form-control"
                       placeholder=" "
                       required />
                <label for="confirm-password" class="label">Xác nhận mật khẩu</label>
                <i class="fas fa-eye password-toggle" data-target="confirm-password"></i>
            </div>

            <button class="submit-btn" type="submit">Đăng ký</button>

            <div class="switch-form-link">
                Bạn đã có tài khoản? <a id="show-login-form" href="javascript:void(0);">Đăng nhập</a>
            </div>
        </form>
    </div>

    <!-- jQuery from CDN -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- JavaScript -->
    <script>
        // Debug: Kiểm tra jQuery đã load chưa
        console.log('jQuery loaded:', typeof jQuery !== 'undefined');

        // Chờ DOM ready
        $(document).ready(function () {
            console.log('Document ready!');

            // Toggle giữa form đăng nhập và đăng ký
            $('#show-register-form').on('click', function (e) {
                e.preventDefault();
                console.log('Show register form clicked');
                $('#login-form').removeClass('active');
                $('#register-form').addClass('active');
                return false;
            });

            $('#show-login-form').on('click', function (e) {
                e.preventDefault();
                console.log('Show login form clicked');
                $('#register-form').removeClass('active');
                $('#login-form').addClass('active');
                return false;
            });

            // Toggle hiển thị mật khẩu
            $('.password-toggle').on('click', function () {
                var target = $(this).data('target');
                var input = $('#' + target);

                console.log('Toggle password for:', target);

                if (input.attr('type') === 'password') {
                    input.attr('type', 'text');
                    $(this).removeClass('fa-eye').addClass('fa-eye-slash');
                } else {
                    input.attr('type', 'password');
                    $(this).removeClass('fa-eye-slash').addClass('fa-eye');
                }
            });

            console.log('All event handlers attached');
        });

        // Fallback: Nếu jQuery không load, dùng vanilla JavaScript
        if (typeof jQuery === 'undefined') {
            console.warn('jQuery not loaded, using vanilla JS');

            document.addEventListener('DOMContentLoaded', function () {
                document.getElementById('show-register-form').addEventListener('click', function (e) {
                    e.preventDefault();
                    document.getElementById('login-form').classList.remove('active');
                    document.getElementById('register-form').classList.add('active');
                });

                document.getElementById('show-login-form').addEventListener('click', function (e) {
                    e.preventDefault();
                    document.getElementById('register-form').classList.remove('active');
                    document.getElementById('login-form').classList.add('active');
                });

                // Password toggles
                var toggles = document.querySelectorAll('.password-toggle');
                toggles.forEach(function (toggle) {
                    toggle.addEventListener('click', function () {
                        var target = this.getAttribute('data-target');
                        var input = document.getElementById(target);

                        if (input.type === 'password') {
                            input.type = 'text';
                            this.classList.remove('fa-eye');
                            this.classList.add('fa-eye-slash');
                        } else {
                            input.type = 'password';
                            this.classList.remove('fa-eye-slash');
                            this.classList.add('fa-eye');
                        }
                    });
                });
            });
        }
    </script>
</body>
</html>