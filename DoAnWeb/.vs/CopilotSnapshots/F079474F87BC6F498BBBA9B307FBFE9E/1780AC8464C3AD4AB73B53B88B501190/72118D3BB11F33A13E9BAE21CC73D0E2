
@{
    ViewBag.Title = "Tổng Quan";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    
    var totalRevenue = ViewBag.TotalRevenue ?? 0;
    var totalOrders = ViewBag.TotalOrders ?? 0;
    var totalCustomers = ViewBag.TotalCustomers ?? 0;
    var totalProducts = ViewBag.TotalProducts ?? 0;
}

<div id="dashboard" class="tab-content active">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="fas fa-tachometer-alt text-primary me-2"></i>
            Bảng điều khiển
        </h1>
        <div class="text-muted">
            <i class="far fa-clock me-1"></i>
            Cập nhật: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
        </div>
    </div>
    
    <!-- Thống kê tổng quan -->
    <div class="row g-3">
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="stat-card bg-gradient-primary shadow h-100">
                <div class="icon">
                    <i class="fas fa-dollar-sign"></i>
                </div>
                <div class="info">
                    <h3 id="totalRevenue">@String.Format("{0:N0}", totalRevenue) ₫</h3>
                    <p>Tổng doanh thu</p>
                    <small class="text-white-50">
                        <i class="fas fa-chart-line me-1"></i>
                        Đơn đã giao/hoàn thành
                    </small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="stat-card bg-gradient-success shadow h-100">
                <div class="icon">
                    <i class="fas fa-shopping-cart"></i>
                </div>
                <div class="info">
                    <h3 id="totalOrders">@totalOrders</h3>
                    <p>Tổng đơn hàng</p>
                    <small class="text-white-50">
                        <i class="fas fa-box me-1"></i>
                        Tất cả trạng thái
                    </small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="stat-card bg-gradient-info shadow h-100">
                <div class="icon">
                    <i class="fas fa-users"></i>
                </div>
                <div class="info">
                    <h3 id="totalCustomers">@totalCustomers</h3>
                    <p>Tổng khách hàng</p>
                    <small class="text-white-50">
                        <i class="fas fa-user-check me-1"></i>
                        Tài khoản đã đăng ký
                    </small>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6 mb-3">
            <div class="stat-card bg-gradient-warning shadow h-100">
                <div class="icon">
                    <i class="fas fa-box-open"></i>
                </div>
                <div class="info">
                    <h3 id="totalProducts">@totalProducts</h3>
                    <p>Sản phẩm trong kho</p>
                    <small class="text-white-50">
                        <i class="fas fa-warehouse me-1"></i>
                        Tổng số lượng
                    </small>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Biểu đồ -->
    <div class="row">
        <div class="col-lg-7 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-primary">
                        <i class="fas fa-chart-area me-2"></i>
                        Doanh thu 6 tháng gần nhất
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="dashboardRevenueChart" height="300"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3">
                    <h6 class="m-0 font-weight-bold text-success">
                        <i class="fas fa-chart-pie me-2"></i>
                        Top 5 sản phẩm bán chạy
                    </h6>
                </div>
                <div class="card-body">
                    <canvas id="dashboardTopProductsChart" height="300"></canvas>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Đơn hàng gần đây -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="m-0 font-weight-bold text-info">
                        <i class="fas fa-list me-2"></i>
                        Đơn hàng gần đây
                    </h6>
                    <a href="@Url.Action("DonHang", "Admin")" class="btn btn-sm btn-outline-primary">
                        Xem tất cả <i class="fas fa-arrow-right ms-1"></i>
                    </a>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead class="table-light">
                                <tr>
                                    <th>Mã đơn hàng</th>
                                    <th>Khách hàng</th>
                                    <th>Tổng tiền</th>
                                    <th>Trạng thái</th>
                                    <th>Ngày đặt</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (ViewBag.RecentOrders != null)
                                {
                                    var orders = (List<DoAnWeb.Models.RecentOrderViewModel>)ViewBag.RecentOrders;
                                    foreach (var order in orders)
                                    {
                                        int trangThai = order.TrangThai ?? 0;
                                        var statusClass = "";
                                        var statusText = "";
                                        switch (trangThai)
                                        {
                                            case 1: statusClass = "warning"; statusText = "Chờ xử lý"; break;
                                            case 2: statusClass = "info"; statusText = "Đã xác nhận"; break;
                                            case 3: statusClass = "primary"; statusText = "Đang giao"; break;
                                            case 4: statusClass = "success"; statusText = "Hoàn thành"; break;
                                            case 5: statusClass = "danger"; statusText = "Đã hủy"; break;
                                            default: statusClass = "secondary"; statusText = "Không rõ"; break;
                                        }
                                        
                                        <tr>
                                            <td>
                                                <strong class="text-primary">@order.MaDonHang</strong>
                                            </td>
                                            <td>@order.TenKhachHang</td>
                                            <td>
                                                <strong>@String.Format("{0:N0}", order.TongTien ?? 0) ₫</strong>
                                            </td>
                                            <td>
                                                <span class="badge bg-@statusClass">@statusText</span>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    @(order.NgayTao.HasValue ? order.NgayTao.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                                </small>
                                            </td>
                                            <td>
                                                <a href="@Url.Action("ChiTiet", "DonHang", new { id = order.Id })" 
                                                   class="btn btn-sm btn-outline-primary">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="6" class="text-center text-muted">
                                            <i class="fas fa-inbox fa-3x mb-3"></i>
                                            <p>Chưa có đơn hàng nào</p>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
/* ==================== STAT CARD STYLES ==================== */
.stat-card {
    /* Layout & Dimensions */
    display: flex;
    align-items: center;
    justify-content: flex-start;
    min-height: 140px; /* Uniform height for all cards */
    height: 100%; /* Fill parent container */
        
    /* Spacing & Appearance */
    padding: 24px 20px;
    border-radius: 12px;
    color: white;
        
    /* Effects */
    transition: all 0.3s ease;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    position: relative;
}
    
.stat-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 8px 20px rgba(0, 0, 0, 0.15);
}
    
/* Icon Container */
.stat-card .icon {
    /* Dimensions */
    flex-shrink: 0; /* Prevent icon from shrinking */
    width: 80px; /* Fixed width */
    height: 80px;
        
    /* Layout */
    display: flex;
    align-items: center;
    justify-content: center;
        
    /* Appearance */
    font-size: 2.5rem;
    opacity: 0.9;
    margin-right: 20px;
        
    /* Background circle (optional) */
    background: rgba(255, 255, 255, 0.15);
    border-radius: 50%;
        
    /* Effects */
    transition: all 0.3s ease;
}
    
.stat-card:hover .icon {
    opacity: 1;
    transform: scale(1.1);
}
    
/* Info Container */
.stat-card .info {
    /* Layout */
    flex: 1; /* Take remaining space */
    min-width: 0; /* Allow text truncation */
        
    /* Vertical alignment */
    display: flex;
    flex-direction: column;
    justify-content: center;
        
    /* Spacing */
    padding-right: 10px;
}
    
/* Info Text Elements */
.stat-card .info h3 {
    /* Typography */
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.2;
        
    /* Spacing */
    margin: 0 0 8px 0;
        
    /* Text handling */
    word-wrap: break-word;
    overflow-wrap: break-word;
        
    /* Effects */
    transition: font-size 0.3s ease;
}
    
.stat-card .info p {
    /* Typography */
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.3;
        
    /* Spacing */
    margin: 0 0 6px 0;
        
    /* Appearance */
    opacity: 0.95;
        
    /* Text handling */
    word-wrap: break-word;
    overflow-wrap: break-word;
    white-space: normal; /* Allow wrapping */
}
    
.stat-card .info small {
    /* Typography */
    font-size: 0.75rem;
    line-height: 1.2;
        
    /* Spacing */
    margin: 0;
        
    /* Text handling */
    display: block;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}
    
/* ==================== RESPONSIVE ADJUSTMENTS ==================== */
    
/* Large screens (desktops) */
@media (min-width: 1200px) {
    .stat-card {
        min-height: 150px;
        padding: 28px 24px;
    }
        
    .stat-card .icon {
        width: 90px;
        height: 90px;
        font-size: 2.75rem;
        margin-right: 24px;
    }
        
    .stat-card .info h3 {
        font-size: 2rem;
    }
        
    .stat-card .info p {
        font-size: 1rem;
    }
}
    
/* Medium screens (tablets) */
@media (max-width: 991px) {
    .stat-card {
        min-height: 130px;
        padding: 20px 16px;
    }
        
    .stat-card .icon {
        width: 70px;
        height: 70px;
        font-size: 2.25rem;
        margin-right: 16px;
    }
        
    .stat-card .info h3 {
        font-size: 1.5rem;
    }
        
    .stat-card .info p {
        font-size: 0.85rem;
    }
        
    .stat-card .info small {
        font-size: 0.7rem;
    }
}
    
/* Small screens (mobile) */
@media (max-width: 767px) {
    .stat-card {
        min-height: 120px;
        padding: 18px 14px;
    }
        
    .stat-card .icon {
        width: 60px;
        height: 60px;
        font-size: 2rem;
        margin-right: 14px;
    }
        
    .stat-card .info h3 {
        font-size: 1.4rem;
    }
        
    .stat-card .info p {
        font-size: 0.8rem;
    }
        
    .stat-card .info small {
        font-size: 0.65rem;
    }
}
    
/* Extra small screens */
@media (max-width: 575px) {
    .stat-card {
        min-height: 110px;
        padding: 16px 12px;
        flex-direction: row; /* Keep horizontal layout */
    }
        
    .stat-card .icon {
        width: 55px;
        height: 55px;
        font-size: 1.75rem;
        margin-right: 12px;
    }
        
    .stat-card .info h3 {
        font-size: 1.3rem;
    }
        
    .stat-card .info p {
        font-size: 0.75rem;
    }
        
    .stat-card .info small {
        font-size: 0.6rem;
    }
}
    
    .bg-gradient-primary {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }
    
    .bg-gradient-success {
        background: linear-gradient(135deg, #84fab0 0%, #8fd3f4 100%);
    }
    
    .bg-gradient-info {
        background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);
    }
    
    .bg-gradient-warning {
        background: linear-gradient(135deg, #ffecd2 0%, #fcb69f 100%);
    }
    
    .card {
        border: none;
        border-radius: 10px;
    }
    
    .table-hover tbody tr:hover {
        background-color: #f8f9fa;
    }
</style>

@section scripts {
<script>
    // Dữ liệu doanh thu 6 tháng
    var revenueData = @Html.Raw(Json.Encode(ViewBag.RevenueByMonth ?? new List<object>()));
    
    // Dữ liệu sản phẩm bán chạy
    var topProductsData = @Html.Raw(Json.Encode(ViewBag.TopProducts ?? new List<object>()));
    
    // Biểu đồ doanh thu
    if (revenueData.length > 0) {
        var revenueLabels = revenueData.map(function(item) {
            return 'Tháng ' + item.Month + '/' + item.Year;
        });
        
        var revenueValues = revenueData.map(function(item) {
            return item.Revenue;
        });
        
        var revenueCtx = document.getElementById('dashboardRevenueChart').getContext('2d');
        new Chart(revenueCtx, {
            type: 'line',
            data: {
                labels: revenueLabels,
                datasets: [{
                    label: 'Doanh thu (₫)',
                    data: revenueValues,
                    backgroundColor: 'rgba(102, 126, 234, 0.1)',
                    borderColor: 'rgba(102, 126, 234, 1)',
                    borderWidth: 2,
                    fill: true,
                    tension: 0.4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return 'Doanh thu: ' + context.parsed.y.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' ₫';
                            }
                        }
                    }
                }
            }
        });
    }
    
    // Biểu đồ sản phẩm bán chạy
    if (topProductsData.length > 0) {
        var productLabels = topProductsData.map(function(item) {
            return item.ProductName;
        });
        
        var productValues = topProductsData.map(function(item) {
            return item.TotalQuantity;
        });
        
        var productCtx = document.getElementById('dashboardTopProductsChart').getContext('2d');
        new Chart(productCtx, {
            type: 'doughnut',
            data: {
                labels: productLabels,
                datasets: [{
                    data: productValues,
                    backgroundColor: [
                        'rgba(102, 126, 234, 0.8)',
                        'rgba(132, 250, 176, 0.8)',
                        'rgba(168, 237, 234, 0.8)',
                        'rgba(255, 236, 210, 0.8)',
                        'rgba(252, 182, 159, 0.8)'
                    ],
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        position: 'bottom'
                    },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                return context.label + ': ' + context.parsed + ' sản phẩm';
                            }
                        }
                    }
                }
            }
        });
    }
</script>
}
