@{
    ViewBag.Title = "Đổi mật khẩu";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        <li>
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <a href="@Url.Action("Index", "TaiKhoan")" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                    Tài khoản
                </a>
            </div>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Đổi mật khẩu</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Success/Error Messages -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="bg-green-100 border border-green-400 text-green-700 px-6 py-4 rounded-lg mb-6 animate__animated animate__fadeInDown" role="alert">
        <div class="flex items-center">
            <i class="fas fa-check-circle text-2xl mr-3"></i>
            <div>
                <strong class="font-bold">Thành công!</strong>
                <p class="text-sm">@TempData["SuccessMessage"]</p>
            </div>
            <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times text-green-700 hover:text-green-900"></i>
            </button>
        </div>
    </div>
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="bg-red-100 border border-red-400 text-red-700 px-6 py-4 rounded-lg mb-6 animate__animated animate__fadeInDown" role="alert">
        <div class="flex items-center">
            <i class="fas fa-exclamation-circle text-2xl mr-3"></i>
            <div>
                <strong class="font-bold">Lỗi!</strong>
                <p class="text-sm">@TempData["ErrorMessage"]</p>
            </div>
            <button type="button" class="ml-auto" onclick="this.parentElement.parentElement.remove()">
                <i class="fas fa-times text-red-700 hover:text-red-900"></i>
            </button>
        </div>
    </div>
}

<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
    <!-- Sidebar Menu (1/4) -->
    <div class="lg:col-span-1">
        <div class="bg-white rounded-lg shadow-md p-4 sticky top-4">
            <h3 class="text-lg font-bold text-gray-900 mb-4 pb-3 border-b">Quản lý tài khoản</h3>
            <nav class="space-y-2">
                <a href="@Url.Action("Index", "TaiKhoan")" class="flex items-center px-4 py-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
                    <i class="fas fa-user-circle w-5 mr-3"></i>
                    Thông tin tài khoản
                </a>
                <a href="@Url.Action("DoiMatKhau", "TaiKhoan")" class="flex items-center px-4 py-3 bg-blue-50 text-blue-600 rounded-lg font-semibold">
                    <i class="fas fa-key w-5 mr-3"></i>
                    Đổi mật khẩu
                </a>
                <a href="@Url.Action("DonHang", "TaiKhoan")" class="flex items-center px-4 py-3 text-gray-700 hover:bg-gray-50 rounded-lg transition-colors">
                    <i class="fas fa-shopping-bag w-5 mr-3"></i>
                    Đơn hàng của tôi
                </a>
                <a href="@Url.Action("Logout", "Account")" class="flex items-center px-4 py-3 text-red-600 hover:bg-red-50 rounded-lg transition-colors">
                    <i class="fas fa-sign-out-alt w-5 mr-3"></i>
                    Đăng xuất
                </a>
            </nav>
        </div>
    </div>

    <!-- Main Content (3/4) -->
    <div class="lg:col-span-3">
        <div class="bg-white rounded-lg shadow-md p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6 pb-4 border-b flex items-center">
                <i class="fas fa-lock mr-3 text-blue-600"></i>
                Đổi mật khẩu
            </h2>

            <div class="max-w-2xl">
                <form action="@Url.Action("DoiMatKhau", "TaiKhoan")" method="post" id="changePasswordForm">
                    @Html.AntiForgeryToken()

                    <!-- Mật khẩu cũ -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Mật khẩu hiện tại <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="matKhauCu"
                                   name="matKhauCu"
                                   required
                                   class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
                                   placeholder="Nhập mật khẩu hiện tại">
                            <button type="button" onclick="togglePassword('matKhauCu')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                <i class="fas fa-eye" id="matKhauCu-icon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- Mật khẩu mới -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Mật khẩu mới <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="matKhauMoi"
                                   name="matKhauMoi"
                                   required
                                   minlength="6"
                                   class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
                                   placeholder="Nhập mật khẩu mới (tối thiểu 6 ký tự)">
                            <button type="button" onclick="togglePassword('matKhauMoi')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                <i class="fas fa-eye" id="matKhauMoi-icon"></i>
                            </button>
                        </div>
                        <p class="text-xs text-gray-600 mt-2">
                            <i class="fas fa-info-circle mr-1"></i>
                            Mật khẩu phải có ít nhất 6 ký tự
                        </p>
                    </div>

                    <!-- Xác nhận mật khẩu mới -->
                    <div class="mb-6">
                        <label class="block text-sm font-semibold text-gray-700 mb-2">
                            Xác nhận mật khẩu mới <span class="text-red-500">*</span>
                        </label>
                        <div class="relative">
                            <input type="password"
                                   id="xacNhanMatKhau"
                                   name="xacNhanMatKhau"
                                   required
                                   class="w-full px-4 py-3 pr-12 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-all"
                                   placeholder="Nhập lại mật khẩu mới">
                            <button type="button" onclick="togglePassword('xacNhanMatKhau')" class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-gray-700">
                                <i class="fas fa-eye" id="xacNhanMatKhau-icon"></i>
                            </button>
                        </div>
                        <p id="passwordMatchMessage" class="text-xs mt-2 hidden"></p>
                    </div>

                    <!-- Security Tips -->
                    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-6">
                        <div class="flex">
                            <i class="fas fa-shield-alt text-yellow-600 text-xl mr-3 mt-1"></i>
                            <div class="text-sm">
                                <p class="font-semibold text-yellow-800 mb-2">Mẹo bảo mật:</p>
                                <ul class="list-disc list-inside space-y-1 text-gray-700">
                                    <li>Sử dụng mật khẩu mạnh có chữ hoa, chữ thường, số và ký tự đặc biệt</li>
                                    <li>Không sử dụng mật khẩu giống với các tài khoản khác</li>
                                    <li>Thay đổi mật khẩu định kỳ mỗi 3-6 tháng</li>
                                </ul>
                            </div>
                        </div>
                    </div>

                    <!-- Buttons -->
                    <div class="flex items-center space-x-4">
                        <button type="submit"
                                class="flex-1 bg-gradient-to-r from-blue-500 to-indigo-500 hover:from-blue-600 hover:to-indigo-600 text-white font-bold py-3 px-6 rounded-lg transition-all duration-200 shadow-lg hover:shadow-xl flex items-center justify-center">
                            <i class="fas fa-save mr-2"></i>
                            Đổi mật khẩu
                        </button>
                        <a href="@Url.Action("Index", "TaiKhoan")"
                           class="flex-1 bg-gray-200 hover:bg-gray-300 text-gray-700 font-bold py-3 px-6 rounded-lg transition-colors flex items-center justify-center">
                            <i class="fas fa-times mr-2"></i>
                            Hủy
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Toggle password visibility
        function togglePassword(fieldId) {
            var field = document.getElementById(fieldId);
            var icon = document.getElementById(fieldId + '-icon');

            if (field.type === 'password') {
                field.type = 'text';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            } else {
                field.type = 'password';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            }
        }

        // Check password match
        $('#xacNhanMatKhau').on('input', function () {
            var matKhauMoi = $('#matKhauMoi').val();
            var xacNhan = $(this).val();
            var message = $('#passwordMatchMessage');

            if (xacNhan.length > 0) {
                if (matKhauMoi === xacNhan) {
                    message.removeClass('text-red-500').addClass('text-green-600')
                        .html('<i class="fas fa-check-circle mr-1"></i>Mật khẩu khớp')
                        .removeClass('hidden');
                } else {
                    message.removeClass('text-green-600').addClass('text-red-500')
                        .html('<i class="fas fa-times-circle mr-1"></i>Mật khẩu không khớp')
                        .removeClass('hidden');
                }
            } else {
                message.addClass('hidden');
            }
        });

        // Form validation
        $('#changePasswordForm').on('submit', function (e) {
            var matKhauMoi = $('#matKhauMoi').val();
            var xacNhan = $('#xacNhanMatKhau').val();

            if (matKhauMoi !== xacNhan) {
                e.preventDefault();
                alert('Mật khẩu xác nhận không khớp');
                $('#xacNhanMatKhau').focus();
                return false;
            }
        });

        // Auto-hide messages
        setTimeout(function () {
            $('[role="alert"]').fadeOut('slow', function () {
                $(this).remove();
            });
        }, 5000);
    </script>
}