@model DoAnWeb.Models.ShoppingCart

@{
    ViewBag.Title = "Giỏ hàng";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        <li aria-current="page">
            <div class="flex items-center">
                <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                <span class="text-sm font-medium text-gray-500">Giỏ hàng</span>
            </div>
        </li>
    </ol>
</nav>

<!-- Page Title -->
<div class="flex items-center justify-between mb-6">
    <h1 class="text-3xl font-bold text-gray-900">
        <i class="fas fa-shopping-cart mr-3 text-blue-600"></i>
        Giỏ hàng của bạn
    </h1>
    @if (Model != null && !Model.IsEmpty())
    {
        <span class="text-sm text-gray-600">
            @Model.GetTotalQuantity() sản phẩm
        </span>
    }
</div>

@if (Model != null && !Model.IsEmpty())
{
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Cart Items (Left - 2/3 width) -->
        <div class="lg:col-span-2 space-y-4">
            @foreach (var item in Model.Items)
            {
                <div class="cart-item bg-white rounded-lg shadow-md p-6 hover:shadow-lg transition-shadow"
                     data-product-id="@item.ProductId"
                     data-color="@item.Color">
                    <div class="flex items-center space-x-6">
                        <!-- Product Image -->
                        <div class="flex-shrink-0">
                            <a href="@Url.Action("ChiTietSP", "SanPham", new { id = item.ProductId })">
                                @if (!string.IsNullOrEmpty(item.ProductImage))
                                {
                                    <img src="@Url.Content("~/Content/Images/" + item.ProductImage)"
                                         alt="@item.ProductName"
                                         class="w-24 h-24 object-contain rounded border border-gray-200" />
                                }
                                else
                                {
                                    <img src="@Url.Content("~/Content/Images/no-image.png")"
                                         alt="No Image"
                                         class="w-24 h-24 object-contain rounded border border-gray-200" />
                                }
                            </a>
                        </div>

                        <!-- Product Info -->
                        <div class="flex-1">
                            <h3 class="text-lg font-semibold text-gray-900 mb-2">
                                <a href="@Url.Action("ChiTietSP", "SanPham", new { id = item.ProductId })"
                                   class="hover:text-blue-600">
                                    @item.ProductName
                                </a>
                            </h3>

                            @if (!string.IsNullOrEmpty(item.Color))
                            {
                                <p class="text-sm text-gray-600 mb-2">
                                    <span class="font-medium">Màu:</span> @item.Color
                                </p>
                            }

                            <div class="flex items-center space-x-4">
                                <!-- Price -->
                                <p class="text-lg font-bold text-blue-600">
                                    @String.Format("{0:0,0}", item.Price) đ
                                </p>

                                <!-- Quantity Selector -->
                                <div class="flex items-center border border-gray-300 rounded">
                                    <button type="button"
                                            class="btn-decrease px-3 py-1 hover:bg-gray-100 transition-colors"
                                            onclick="updateQuantity(@item.ProductId, @item.Quantity - 1, '@item.Color')">
                                        <i class="fas fa-minus text-gray-600"></i>
                                    </button>
                                    <input type="number"
                                           class="quantity-input w-16 text-center border-x border-gray-300 py-1 font-semibold"
                                           value="@item.Quantity"
                                           min="1"
                                           readonly />
                                    <button type="button"
                                            class="btn-increase px-3 py-1 hover:bg-gray-100 transition-colors"
                                            onclick="updateQuantity(@item.ProductId, @item.Quantity + 1, '@item.Color')">
                                        <i class="fas fa-plus text-gray-600"></i>
                                    </button>
                                </div>

                                <!-- Item Total -->
                                <p class="item-total text-lg font-bold text-gray-900">
                                    @String.Format("{0:0,0}", item.TotalPrice) đ
                                </p>
                            </div>
                        </div>

                        <!-- Remove Button -->
                        <div class="flex-shrink-0">
                            <button type="button"
                                    class="btn-remove text-red-500 hover:text-red-700 hover:bg-red-50 p-2 rounded transition-colors"
                                    onclick="removeItem(@item.ProductId, '@item.Color')"
                                    title="Xóa sản phẩm">
                                <i class="fas fa-trash-alt text-xl"></i>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Order Summary (Right - 1/3 width) -->
        <div class="lg:col-span-1">
            <div class="bg-white rounded-lg shadow-lg p-6 sticky top-4">
                <h2 class="text-xl font-bold text-gray-900 mb-6 pb-4 border-b">
                    Thông tin đơn hàng
                </h2>

                <div class="space-y-4 mb-6">
                    <div class="flex justify-between text-gray-700">
                        <span>Tạm tính:</span>
                        <span id="subtotal" class="font-semibold">@String.Format("{0:0,0}", Model.GetTotal()) đ</span>
                    </div>

                    <div class="flex justify-between text-gray-700">
                        <span>Phí vận chuyển:</span>
                        <span class="font-semibold text-green-600">Miễn phí</span>
                    </div>

                    <!-- Discount Section -->
                    <div id="discountSection" class="border-t pt-4" style="display: @(Session["DiscountAmount"] != null ? "block" : "none")">
                        <div class="flex justify-between items-center text-green-600">
                            <div class="flex items-center">
                                <i class="fas fa-tag mr-2"></i>
                                <span>Giảm giá (<span id="discountCodeDisplay">@Session["DiscountCode"]</span>):</span>
                            </div>
                            <div class="flex items-center space-x-2">
                                <span id="discountAmount" class="font-semibold">
                                    @(Session["DiscountAmount"] != null ? String.Format("-{0:0,0} đ", Session["DiscountAmount"]) : "")
                                </span>
                                <button type="button" onclick="removeDiscount()" class="text-red-500 hover:text-red-700 p-1" title="Xóa mã giảm giá">
                                    <i class="fas fa-times-circle"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="border-t pt-4">
                        <div class="flex justify-between items-center">
                            <span class="text-lg font-bold text-gray-900">Tổng cộng:</span>
                            <span id="total" class="text-2xl font-bold text-red-600">
                                @{
                                    var discountAmount = Session["DiscountAmount"] != null ? Convert.ToDecimal(Session["DiscountAmount"]) : 0;
                                    var finalTotal = Model.GetTotal() - discountAmount;
                                }
                                @String.Format("{0:0,0}", finalTotal) đ
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Checkout Button -->
                <a href="@Url.Action("Index", "ThanhToan")"
                   class="block w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-4 px-6 rounded-lg transition-all duration-200 text-center shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">
                    <i class="fas fa-credit-card mr-2"></i>
                    Tiến hành thanh toán
                </a>

                <!-- Continue Shopping -->
                <a href="@Url.Action("Index", "Home")"
                   class="block w-full mt-3 text-center text-blue-600 hover:text-blue-800 font-semibold py-2">
                    <i class="fas fa-arrow-left mr-2"></i>
                    Tiếp tục mua hàng
                </a>

                <!-- Promo Code -->
                <div class="mt-6 pt-6 border-t">
                    <h3 class="text-sm font-semibold text-gray-900 mb-3 flex items-center">
                        <i class="fas fa-ticket-alt mr-2 text-blue-600"></i>
                        Mã giảm giá
                    </h3>
                    <div class="flex space-x-2">
                        <input type="text"
                               id="discountCodeInput"
                               placeholder="Nhập mã giảm giá (VD: GIAM10)"
                               class="flex-1 px-3 py-2 border border-gray-300 rounded focus:outline-none focus:ring-2 focus:ring-blue-500 text-sm"
                               value="@Session["DiscountCode"]" />
                        <button type="button"
                                id="btnApplyDiscount"
                                onclick="applyDiscount()"
                                class="px-4 py-2 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded transition-colors text-sm whitespace-nowrap">
                            <i class="fas fa-check mr-1"></i>
                            Áp dụng
                        </button>
                    </div>
                    <div id="discountMessage" class="mt-2 text-sm"></div>

                    <!-- Discount Applied Display -->
                    <div id="discountApplied" style="display: @(Session["DiscountAmount"] != null ? "flex" : "none")" class="mt-4 p-3 bg-green-50 border border-green-200 rounded-lg items-center justify-between">
                        <div class="flex items-center text-green-700 text-sm">
                            <i class="fas fa-check-circle mr-2"></i>
                            <span class="font-medium">Mã <strong id="appliedCode">@Session["DiscountCode"]</strong> đã được áp dụng!</span>
                        </div>
                        <button type="button" onclick="removeDiscount()" class="text-red-500 hover:text-red-700 ml-2 p-1" title="Xóa mã">
                            <i class="fas fa-times-circle text-lg"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <!-- Empty Cart -->
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <div class="mb-6">
            <i class="fas fa-shopping-cart text-gray-300 text-8xl"></i>
        </div>
        <h2 class="text-2xl font-bold text-gray-700 mb-4">Giỏ hàng trống</h2>
        <p class="text-gray-500 mb-6">
            Bạn chưa có sản phẩm nào trong giỏ hàng
        </p>
        <a href="@Url.Action("Index", "Home")"
           class="inline-flex items-center px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg transition-colors">
            <i class="fas fa-arrow-left mr-2"></i>
            Tiếp tục mua sắm
        </a>
    </div>
}

@section scripts {
    <script>
    // Update quantity
    function updateQuantity(productId, quantity, color) {
        if (quantity < 1) {
            if (!confirm('Bạn có muốn xóa sản phẩm này khỏi giỏ hàng?')) {
                return;
            }
        }

        $.ajax({
            url: '@Url.Action("UpdateQuantity", "GioHang")',
            type: 'POST',
            data: {
                productId: productId,
                quantity: quantity,
                color: color
            },
            success: function (response) {
                if (response.success) {
                    if (quantity === 0) {
                        // Remove item from DOM
                        $('[data-product-id="' + productId + '"][data-color="' + color + '"]').fadeOut(300, function() {
                            $(this).remove();
                            checkEmptyCart();
                        });
                    } else {
                        // Update quantity input
                        var $item = $('[data-product-id="' + productId + '"][data-color="' + color + '"]');
                        $item.find('.quantity-input').val(quantity);

                        // Update item total
                        $item.find('.item-total').text(formatCurrency(response.itemTotal));
                    }

                    // Update cart totals
                    updateCartTotals(response.cartTotal, response.cartCount);

                    // Show notification
                    showNotification(response.message, 'success');
                } else {
                    showNotification(response.message, 'error');
                }
            },
            error: function () {
                showNotification('Có lỗi xảy ra, vui lòng thử lại', 'error');
            }
        });
    }

    // Remove item
    function removeItem(productId, color) {
        if (!confirm('Bạn có chắc muốn xóa sản phẩm này?')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("Remove", "GioHang")',
            type: 'POST',
            data: {
                productId: productId,
                color: color
            },
            success: function (response) {
                if (response.success) {
                    // Remove item from DOM
                    $('[data-product-id="' + productId + '"][data-color="' + color + '"]').fadeOut(300, function() {
                        $(this).remove();
                        checkEmptyCart();
                    });

                    // Update cart totals
                    updateCartTotals(response.cartTotal, response.cartCount);

                    // Show notification
                    showNotification(response.message, 'success');
                } else {
                    showNotification(response.message, 'error');
                }
            },
            error: function () {
                showNotification('Có lỗi xảy ra, vui lòng thử lại', 'error');
            }
        });
    }

    // Update cart totals
    function updateCartTotals(total, count) {
        $('#subtotal').text(formatCurrency(total));
        $('#total').text(formatCurrency(total));

        // Update header cart count (if exists)
        $('.cart-count').text(count);
    }

    // Format currency
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN').format(amount) + ' đ';
    }

    // Check if cart is empty
    function checkEmptyCart() {
        if ($('.cart-item').length === 0) {
            location.reload();
        }
    }

    // Show notification
    function showNotification(message, type) {
        var bgColor = type === 'success' ? 'bg-green-500' : 'bg-red-500';
        var notification = $('<div class="fixed top-4 right-4 ' + bgColor + ' text-white px-6 py-3 rounded-lg shadow-lg z-50 animate-fade-in">' +
            '<i class="fas fa-' + (type === 'success' ? 'check' : 'exclamation') + '-circle mr-2"></i>' +
            message +
            '</div>');

        $('body').append(notification);

        setTimeout(function() {
            notification.fadeOut(300, function() {
                $(this).remove();
            });
        }, 3000);
    }

    // Quantity input change (optional - if you want manual input)
    $('.quantity-input').on('change', function() {
        var $item = $(this).closest('.cart-item');
        var productId = $item.data('product-id');
        var color = $item.data('color');
        var quantity = parseInt($(this).val());

        if (quantity < 1) {
            $(this).val(1);
            quantity = 1;
        }

        updateQuantity(productId, quantity, color);
    });

    // Apply discount code
    function applyDiscount() {
        var discountCode = $('#discountCodeInput').val().trim();
        var messageDiv = $('#discountMessage');
        var btnApply = $('#btnApplyDiscount');

        if (!discountCode) {
            showDiscountMessage('Vui lòng nhập mã giảm giá', 'error');
            return;
        }

        // Disable button và hiển thị loading
        btnApply.prop('disabled', true).html('<i class="fas fa-spinner fa-spin mr-1"></i> Đang xử lý...');

        $.ajax({
            url: '@Url.Action("ApplyDiscount", "GioHang")',
            type: 'POST',
            data: { discountCode: discountCode },
            success: function(response) {
                if (response.success) {
                    // Hiển thị section giảm giá
                    $('#discountSection').show();
                    $('#discountCodeDisplay').text(response.discountCode);
                    $('#discountAmount').text('-' + formatCurrency(response.discountAmount));

                    // Cập nhật tổng tiền
                    $('#total').text(formatCurrency(response.finalTotal));

                    // Hiển thị thông báo đã áp dụng
                    $('#discountApplied').show();
                    $('#appliedCode').text(response.discountCode);

                    // Hiển thị message thành công
                    showDiscountMessage(response.message, 'success');

                    // Disable input
                    $('#discountCodeInput').prop('readonly', true);
                } else {
                    showDiscountMessage(response.message, 'error');
                }
            },
            error: function() {
                showDiscountMessage('Có lỗi xảy ra, vui lòng thử lại', 'error');
            },
            complete: function() {
                // Enable button trở lại
                btnApply.prop('disabled', false).html('<i class="fas fa-check mr-1"></i> Áp dụng');
            }
        });
    }

    // Remove discount code
    function removeDiscount() {
        if (!confirm('Bạn có chắc muốn xóa mã giảm giá?')) {
            return;
        }

        $.ajax({
            url: '@Url.Action("RemoveDiscount", "GioHang")',
            type: 'POST',
            success: function(response) {
                if (response.success) {
                    // Ẩn section giảm giá
                    $('#discountSection').hide();
                    $('#discountApplied').hide();

                    // Clear input
                    $('#discountCodeInput').val('').prop('readonly', false);

                    // Cập nhật tổng tiền
                    $('#total').text(formatCurrency(response.finalTotal));

                    // Hiển thị thông báo
                    showDiscountMessage(response.message, 'success');
                } else {
                    showDiscountMessage(response.message, 'error');
                }
            },
            error: function() {
                showDiscountMessage('Có lỗi xảy ra, vui lòng thử lại', 'error');
            }
        });
    }

    // Show discount message
    function showDiscountMessage(message, type) {
        var messageDiv = $('#discountMessage');
        var colorClass = type === 'success' ? 'text-green-600' : 'text-red-600';
        var icon = type === 'success' ? 'check-circle' : 'exclamation-circle';

        messageDiv.html('<i class="fas fa-' + icon + ' mr-1"></i>' + message)
                  .removeClass('text-green-600 text-red-600')
                  .addClass(colorClass);

        // Auto hide sau 5 giây
        setTimeout(function() {
            messageDiv.fadeOut(function() {
                $(this).html('').show();
            });
        }, 5000);
    }

    // Allow enter key to apply discount
    $('#discountCodeInput').on('keypress', function(e) {
        if (e.which === 13) { // Enter key
            e.preventDefault();
            applyDiscount();
        }
    });
    </script>
}