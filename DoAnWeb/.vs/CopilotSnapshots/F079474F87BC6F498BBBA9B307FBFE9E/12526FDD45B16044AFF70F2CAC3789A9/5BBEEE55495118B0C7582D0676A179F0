@model List<tb_TaiKhoan>

@{
    ViewBag.Title = "QuanTriVien";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<div id="admins" class="tab-content active">
    <h1 class="mb-4">Quản lý tài khoản admin</h1>
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimQuanTriVien" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timqtv" name="timqtv" placeholder="Tìm kiếm sản phẩm...">
                <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
            </form>
            <a href="@Url.Action("formThemQTV", "Admin")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm admin
            </a>
        </div>
        <table class="table table-bordered table-hover" id="adminTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="adminTableBody">
                @foreach (var item in Model)
                {
                    <tr id="admin-1">
                        <td>@item.Id</td>
                        <td>@item.TenDangNhap</td>
                        <td>@item.HoTen</td>
                        <td>@item.Email</td>
                        <td>@item.HoatDong</td>
                        <td>
                            <div class="btn-group" role="group">
                                <a href="@Url.Action("formSuaQTV", "Admin", new { id = item.Id })" class="btn btn-sm btn-warning" title="Sửa quyền admin">
                                    <i class="fas fa-edit"></i>
                                </a>
                                <a href="javascript:void(0);" class="btn btn-sm btn-danger" onclick="confirmDeleteAdmin(@item.Id, '@item.TenDangNhap')" title="Xóa admin">
                                    <i class="fas fa-trash"></i>
                                </a>
                                @*<button class="btn btn-sm btn-info" title="Xem log"><i class="fas fa-file-alt"></i></button>*@
                            </div>
                        </td>
                    </tr>
                }

            </tbody>
        </table>
        
        <script>
        function confirmDeleteAdmin(id, username) {
            Swal.fire({
                title: 'Xác nhận xóa',
                html: `Bạn có chắc chắn muốn xóa admin <strong>"${username}"</strong>?<br><small class="text-muted">Hành động này không thể hoàn tác!</small>`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#6c757d',
                confirmButtonText: '<i class="fas fa-trash"></i> Xóa',
                cancelButtonText: '<i class="fas fa-times"></i> Hủy',
                reverseButtons: true
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("XoaQTV", "Admin")' + '?id=' + id;
                }
            });
        }
        </script>
        
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QuanTriVien" : "TimQuanTriVien",
                    new { timqtv = ViewBag.TuKhoa, page = currentPage - 1 })">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(
                        String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QuanTriVien" : "TimQuanTriVien",
                        new { timqtv = ViewBag.TuKhoa, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QuanTriVien" : "TimQuanTriVien",
                    new { timqtv = ViewBag.TuKhoa, page = currentPage + 1 })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>