             </p>
        </div>
    </div>
            `,
    showCancelButton: true,
            confirmButtonColor: '#3b82f6',
       cancelButtonColor: '#6b7280',
            confirmButtonText: '<i class="fas fa-check-circle mr-2"></i>Xác nhận đặt hàng',
    cancelButtonText: '<i class="fas fa-times-circle mr-2"></i>Kiểm tra lại',
            width: '600px',
  customClass: {
                popup: 'rounded-lg',
