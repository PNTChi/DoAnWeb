          .html('<i class="fas fa-spinner fa-spin mr-2"></i>Đang xử lý...');

     // Show processing notification
      Swal.fire({
     title: 'Đang xử lý...',
         html: 'Vui lòng đợi trong giây lát',
  allowOutsideClick: false,
