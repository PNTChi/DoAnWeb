@model List<tb_TaiKhoan>

@{
    ViewBag.Title = "QuanTriVien";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    int currentPage = ViewBag.CurrentPage;
    int totalPages = ViewBag.TotalPages;
    string TuKhoa = ViewBag.TuKhoa;
}

<div id="admins" class="tab-content active">
    <h1 class="mb-4">Quản lý tài khoản admin</h1>
    <div class="table-container">
        <div class="d-flex justify-content-between mb-3">
            <form action="TimQuanTriVien" method="get" class="input-group w-50">
                <input type="text" class="form-control" id="timqtv" name="timqtv" placeholder="Tìm kiếm sản phẩm...">
                <button class="btn btn-outline-secondary" type="submit"><i class="fas fa-search"></i></button>
            </form>
            <a href="@Url.Action("formThemQTV", "Admin")" class="btn btn-primary">
                <i class="fas fa-plus"></i> Thêm admin
            </a>
        </div>
        <table class="table table-bordered table-hover" id="adminTable">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Tên đăng nhập</th>
                    <th>Họ tên</th>
                    <th>Email</th>
                    <th>Trạng thái</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody id="adminTableBody">
                @foreach (var item in Model)
                {
                    <tr id="admin-1">
                        <td>@item.Id</td>
                        <td>@item.TenDangNhap</td>
                        <td>@item.HoTen</td>
                        <td>@item.Email</td>
                        <td>@item.HoatDong</td>
                        <td>
                            @Html.ActionLink("Sửa quyền", "formSuaQTV", "Admin", new { id = item.Id }, new { @class = "btn btn-sm btn-warning" })
                            @Html.ActionLink("Xóa", "XoaQTV", "Admin", new { id = item.Id }, new { @class = "btn btn-sm btn-warning", onclick = "return confirm('Bạn có chắc chắn muốn xóa?');" })
                            @*<button class="btn btn-sm btn-info"><i class="fas fa-file-alt"></i> Xem log</button>*@
                        </td>
                    </tr>
                }

            </tbody>
        </table>
        <nav aria-label="Pagination">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QuanTriVien" : "TimQuanTriVien",
                    new { timqtv = ViewBag.TuKhoa, page = currentPage - 1 })">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="@Url.Action(
                        String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QuanTriVien" : "TimQuanTriVien",
                        new { timqtv = ViewBag.TuKhoa, page = i })">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="@Url.Action(
                    String.IsNullOrEmpty(ViewBag.TuKhoa) ? "QuanTriVien" : "TimQuanTriVien",
                    new { timqtv = ViewBag.TuKhoa, page = currentPage + 1 })">Sau</a>
                </li>
            </ul>
        </nav>
    </div>
</div>