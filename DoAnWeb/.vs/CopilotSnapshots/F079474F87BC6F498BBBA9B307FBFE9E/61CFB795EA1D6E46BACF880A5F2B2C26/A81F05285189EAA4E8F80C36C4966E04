@model List<DoAnWeb.tb_SanPham>

@{
    ViewBag.Title = "Khuyến mãi";
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
      <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
     <i class="fas fa-home mr-2"></i>
    Trang chủ
        </a>
      </li>
        <li aria-current="page">
            <div class="flex items-center">
 <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
         <span class="text-sm font-medium text-gray-500">Khuyến mãi</span>
   </div>
  </li>
    </ol>
</nav>

<!-- Page Header -->
<div class="bg-gradient-to-r from-red-500 to-orange-500 rounded-lg shadow-lg p-8 mb-6 text-white">
    <div class="flex items-center justify-between flex-wrap gap-4">
        <div>
    <h1 class="text-4xl font-bold mb-3 flex items-center">
        <i class="fas fa-tags mr-3 animate-pulse"></i>
          KHUYẾN MÃI HOT
            </h1>
            <p class="text-xl mb-2">
         <i class="fas fa-gift mr-2"></i>
      Giảm giá lên đến <strong class="text-3xl">50%</strong>
    </p>
            <p class="text-lg opacity-90">
        Tìm thấy <strong>@ViewBag.TotalProducts</strong> sản phẩm đang khuyến mãi
         </p>
        </div>
        
        @if (ViewBag.TotalSavings > 0)
        {
            <div class="bg-white rounded-lg p-6 text-center border-4 border-yellow-400 shadow-xl">
                <p class="text-sm font-semibold text-gray-600 mb-1">💰 Tổng tiết kiệm</p>
                <p class="text-3xl font-bold text-red-600">
                    @String.Format("{0:0,0}", ViewBag.TotalSavings) ₫
                </p>
                <p class="text-xs text-green-600 font-semibold mt-1">
                    <i class="fas fa-arrow-down mr-1"></i>Giảm giá cực sốc!
                </p>
            </div>
        }
    </div>
</div>

<!-- Filter & Sort Bar -->
<div class="bg-white rounded-lg shadow-md p-4 mb-6">
    <div class="flex items-center justify-between flex-wrap gap-4">
        <!-- Category Filter -->
        <div class="flex items-center space-x-3">
  <label class="text-sm font-semibold text-gray-700">
         <i class="fas fa-filter mr-2"></i>Danh mục:
       </label>
            <select id="danhMucFilter" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500">
                <option value="0" @(ViewBag.DanhMucId == 0 ? "selected" : "")>Tất cả</option>
   @if (ViewBag.DanhMucList != null)
       {
        foreach (var dm in (List<DoAnWeb.tb_DanhMuc>)ViewBag.DanhMucList)
     {
            <option value="@dm.Id" @(ViewBag.DanhMucId == dm.Id ? "selected" : "")>
   @dm.TenDanhMuc
         </option>
      }
     }
         </select>
        </div>

        <!-- Sort Options -->
        <div class="flex items-center space-x-3">
        <label class="text-sm font-semibold text-gray-700">
                <i class="fas fa-sort mr-2"></i>Sắp xếp:
   </label>
        <select id="sortBy" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-red-500">
                <option value="discount_desc" @(ViewBag.SortBy == "discount_desc" ? "selected" : "")>Giảm nhiều nhất</option>
                <option value="discount_asc" @(ViewBag.SortBy == "discount_asc" ? "selected" : "")>Giảm ít nhất</option>
     <option value="price_asc" @(ViewBag.SortBy == "price_asc" ? "selected" : "")>Giá thấp → cao</option>
      <option value="price_desc" @(ViewBag.SortBy == "price_desc" ? "selected" : "")>Giá cao → thấp</option>
        <option value="newest" @(ViewBag.SortBy == "newest" ? "selected" : "")>Mới nhất</option>
                <option value="popular" @(ViewBag.SortBy == "popular" ? "selected" : "")>Phổ biến</option>
    </select>
        </div>
    </div>
</div>

<!-- Products Grid -->
@if (Model.Any())
{
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
     @foreach (var sp in Model)
        {
         var discountPercent = Math.Round((decimal)(1 - (sp.GiaKhuyenMai.Value / sp.Gia.Value)) * 100);
    var savings = sp.Gia - sp.GiaKhuyenMai;

            <a href="@Url.Action("ChiTietSP", "SanPham", new { id = sp.Id })" 
         class="group block bg-white border-2 border-red-200 rounded-lg overflow-hidden hover:shadow-2xl hover:border-red-500 transition-all duration-300 transform hover:-translate-y-2 relative">
     
      <!-- Discount Badge -->
      <div class="absolute top-3 left-3 z-10">
      <div class="bg-red-500 text-white font-bold px-3 py-2 rounded-lg shadow-lg transform -rotate-12">
              <p class="text-xs">GIẢM</p>
   <p class="text-2xl leading-none">@discountPercent%</p>
         </div>
    </div>

         <!-- Hot Badge -->
 @if (sp.LaSanPhamBanChay == true)
            {
      <div class="absolute top-3 right-3 z-10">
         <span class="bg-orange-500 text-white text-xs font-bold px-2 py-1 rounded-full animate-pulse">
      <i class="fas fa-fire mr-1"></i>HOT
 </span>
 </div>
 }

        <!-- Product Image -->
                <div class="aspect-square overflow-hidden bg-gray-50 relative">
        @if (!string.IsNullOrEmpty(sp.HinhAnh))
            {
     <img src="@Url.Content("~/Content/Images/" + sp.HinhAnh)" 
            alt="@sp.TenSanPham" 
       class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300" />
       }
      else
 {
     <img src="@Url.Content("~/Content/Images/no-image.png")" 
   alt="No Image" 
      class="w-full h-full object-contain opacity-50" />
     }

        <!-- Quick View Overlay -->
        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-all duration-300 flex items-center justify-center opacity-0 group-hover:opacity-100">
       <span class="bg-white text-gray-900 px-4 py-2 rounded-full font-semibold text-sm">
      <i class="fas fa-eye mr-2"></i>Xem chi tiết
   </span>
            </div>
         </div>

   <!-- Product Info -->
    <div class="p-4">
             <!-- Product Name -->
       <h3 class="text-sm font-semibold text-gray-900 mb-2 line-clamp-2 h-10 group-hover:text-red-600 transition-colors">
              @sp.TenSanPham
          </h3>

          <!-- Prices -->
          <div class="space-y-2 mb-3">
      <div class="flex items-center justify-between">
 <span class="text-2xl font-bold text-red-600">
      @String.Format("{0:0,0}", sp.GiaKhuyenMai.Value) ₫
            </span>
        </div>
        <div class="flex items-center justify-between text-sm">
           <span class="text-gray-500 line-through">
    @String.Format("{0:0,0}", sp.Gia.Value) ₫
            </span>
         <span class="text-green-600 font-semibold">
                 Tiết kiệm @String.Format("{0:0,0}", savings) ₫
      </span>
                </div>
         </div>

  <!-- Progress Bar (Sold) -->
    <div class="mb-3">
              <div class="flex items-center justify-between text-xs text-gray-600 mb-1">
     <span>Đã bán: 50</span>
          <span>Còn lại: @(sp.SoLuong ?? 0)</span>
            </div>
   <div class="w-full bg-gray-200 rounded-full h-2 overflow-hidden">
      <div class="bg-gradient-to-r from-red-500 to-orange-500 h-2 rounded-full" style="width: 65%"></div>
          </div>
         </div>

            <!-- Rating & Views -->
  <div class="flex items-center justify-between text-xs text-gray-600 pt-3 border-t">
           <div class="flex items-center">
         <i class="fas fa-star text-yellow-400 mr-1"></i>
         <span>4.5</span>
     </div>
       <div class="flex items-center">
   <i class="fas fa-eye mr-1"></i>
       <span>@(sp.LuotXem ?? 0)</span>
     </div>
         </div>
        </div>
 </a>
        }
    </div>

    <!-- Pagination -->
    if (ViewBag.TotalPages > 1)
    {
        <div class="flex justify-center items-center space-x-2 mb-8">
     <!-- Previous -->
  @if (ViewBag.CurrentPage > 1)
   {
      <a href="?danhMucId=@ViewBag.DanhMucId&sortBy=@ViewBag.SortBy&page=@(ViewBag.CurrentPage - 1)" 
       class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-red-50 hover:border-red-500 transition-colors">
  <i class="fas fa-chevron-left"></i>
           </a>
            }

            <!-- Page Numbers -->
   @for (int i = Math.Max(1, ViewBag.CurrentPage - 2); i <= Math.Min(ViewBag.TotalPages, ViewBag.CurrentPage + 2); i++)
  {
                <a href="?danhMucId=@ViewBag.DanhMucId&sortBy=@ViewBag.SortBy&page=@i" 
    class="px-4 py-2 rounded-lg @(i == ViewBag.CurrentPage ? "bg-red-500 text-white" : "bg-white border border-gray-300 hover:bg-red-50")">
           @i
 </a>
     }

    <!-- Next -->
    @if (ViewBag.CurrentPage < ViewBag.TotalPages)
  {
        <a href="?danhMucId=@ViewBag.DanhMucId&sortBy=@ViewBag.SortBy&page=@(ViewBag.CurrentPage + 1)" 
class="px-4 py-2 bg-white border border-gray-300 rounded-lg hover:bg-red-50 hover:border-red-500 transition-colors">
    <i class="fas fa-chevron-right"></i>
           </a>
 }
    </div>
    }
}
else
{
    <!-- Empty State -->
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <i class="fas fa-tags text-gray-300 text-6xl mb-4"></i>
        <h3 class="text-2xl font-bold text-gray-900 mb-2">Hiện chưa có sản phẩm khuyến mãi</h3>
  <p class="text-gray-600 mb-6">Vui lòng quay lại sau hoặc xem các sản phẩm khác</p>
        <a href="@Url.Action("Index", "SanPham")" class="inline-block bg-red-500 hover:bg-red-600 text-white font-bold py-3 px-6 rounded-lg transition-colors">
            <i class="fas fa-shopping-bag mr-2"></i>
            Xem tất cả sản phẩm
      </a>
    </div>
}

@section scripts {
<script>
    // Filter change handler
    $('#danhMucFilter, #sortBy').on('change', function() {
    var danhMucId = $('#danhMucFilter').val();
        var sortBy = $('#sortBy').val();
        
     var url = '@Url.Action("Index", "KhuyenMai")';
      url += '?danhMucId=' + danhMucId;
    url += '&sortBy=' + sortBy;
        
   window.location.href = url;
    });
</script>
}
