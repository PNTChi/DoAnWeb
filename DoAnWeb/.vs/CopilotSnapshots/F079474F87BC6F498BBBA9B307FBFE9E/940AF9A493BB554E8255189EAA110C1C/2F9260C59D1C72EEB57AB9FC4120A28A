                    if (System.IO.File.Exists(imagePath))
                    {
                        System.IO.File.Delete(imagePath);
                    }
                }

                db.tb_QuangCao.Remove(banner);
                db.SaveChanges();

                TempData["SuccessMessage"] = "Xóa banner thành công!";
            }
            catch (Exception ex)
            {
                TempData["ErrorMessage"] = "Có lỗi xảy ra khi xóa banner: " + ex.Message;
            }

            return RedirectToAction("Banner");
        }

        /// <summary>
        /// GET: Tìm kiếm banner
        /// </summary>
        public ActionResult TimBanner(string timbn, int page = 1, int pageSize = 10)
        {
            var query = db.tb_QuangCao.AsQueryable();

            if (!String.IsNullOrEmpty(timbn))
            {
                string keyword = timbn.ToLower();
                query = query.Where(b =>
                    b.TieuDe.ToLower().Contains(keyword) ||
                    (b.LienKet != null && b.LienKet.ToLower().Contains(keyword)));
            }

            // Pagination
            var totalItems = query.Count();
            var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);

            ViewBag.CurrentPage = page;
            ViewBag.TotalPages = totalPages;
            ViewBag.TotalItems = totalItems;
            ViewBag.TuKhoa = timbn;

            var bannerList = query
                .OrderBy(b => b.ThuTu)
                .ThenByDescending(b => b.NgayTao)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .Select(b => new BannerViewModel
                {
                    Id = b.Id,
                    TieuDe = b.TieuDe,
                    MoTa = b.MoTa,
                    HinhAnh = b.HinhAnh,
                    Link = b.LienKet,
                    ThuTu = b.ThuTu ?? 0,
                    ViTri = b.ViTri,
                    HienThi = b.HienThi ?? false,
                    NgayTao = b.NgayTao,
                    NgayCapNhat = b.NgayCapNhat
                })
                .ToList();

            return View("Banner", bannerList);
        }
    }
