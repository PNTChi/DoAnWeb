        public ActionResult BaoCaoThongKe(DateTime? fromDate, DateTime? toDate)
        {
            // Mặc định lấy dữ liệu 30 ngày gần nhất nếu không có filter
            if (!fromDate.HasValue)
                fromDate = DateTime.Now.AddDays(-30);
            
            if (!toDate.HasValue)
                toDate = DateTime.Now;

            // Validation: Nếu fromDate > toDate, hoán đổi để đảm bảo fromDate luôn nhỏ hơn hoặc bằng toDate
            if (fromDate.HasValue && toDate.HasValue && fromDate.Value > toDate.Value)
            {
                // Swap dates
                var temp = fromDate;
                fromDate = toDate;
                toDate = temp;
            }

            // 1. Doanh thu theo tháng (12 tháng gần nhất) - CHỈ tính đơn hàng Hoàn thành
            var twelveMonthsAgo = DateTime.Now.AddMonths(-12);
            var revenueByMonth = db.tb_DonHang
                .Where(d => d.NgayTao >= twelveMonthsAgo && d.TrangThai == 5) // Trạng thái 5 = Hoàn thành
                .GroupBy(d => new { d.NgayTao.Value.Year, d.NgayTao.Value.Month })
                .Select(g => new
                {
                    Year = g.Key.Year,
                    Month = g.Key.Month,
                    Revenue = g.Sum(d => d.TongTien)
                })
                .OrderBy(x => x.Year).ThenBy(x => x.Month)
                .ToList();

            // 2. Top 10 sản phẩm bán chạy
            var topProducts = db.tb_ChiTietDonHang
                .GroupBy(ct => ct.SanPhamId)
                .Select(g => new
                {
                    ProductId = g.Key,
                    TotalQuantity = g.Sum(ct => ct.SoLuong),
                    ProductName = db.tb_SanPham.FirstOrDefault(s => s.Id == g.Key).TenSanPham
                })
                .OrderByDescending(x => x.TotalQuantity)
                .Take(10)
                .ToList();

            // 3. Báo cáo chi tiết trong khoảng thời gian
            var ordersInPeriod = db.tb_DonHang
                .Where(d => d.NgayTao >= fromDate && d.NgayTao <= toDate)
                .ToList();

            // Tổng doanh thu - CHỈ tính đơn hàng Hoàn thành
            var totalRevenue = ordersInPeriod
                .Where(d => d.TrangThai == 5) // Trạng thái 5 = Hoàn thành
                .Sum(d => (decimal?)(d.TongTien)) ?? 0m;

            // Tổng đơn hàng
            var totalOrders = ordersInPeriod.Count;

            // Đơn hàng hoàn thành (Trạng thái 5)
            var completedOrders = ordersInPeriod.Count(d => d.TrangThai == 5);

            // Đơn hàng đã hủy (Trạng thái -1)
            var cancelledOrders = ordersInPeriod.Count(d => d.TrangThai == -1);

            // Đơn hàng đã trả hàng (Trạng thái 7)
            var returnedOrders = ordersInPeriod.Count(d => d.TrangThai == 7);

            // Tỷ lệ hủy đơn
            var cancelRate = totalOrders > 0 ? (double)cancelledOrders / totalOrders * 100 : 0;

            // Tỷ lệ hoàn thành
            var completeRate = totalOrders > 0 ? (double)completedOrders / totalOrders * 100 : 0;

            // Tỷ lệ trả hàng
            var returnRate = totalOrders > 0 ? (double)returnedOrders / totalOrders * 100 : 0;

            // Sản phẩm tồn kho nhiều nhất
            var topStockProduct = db.tb_SanPham
                .OrderByDescending(s => s.SoLuong)
                .Select(s => new TopStockProductViewModel
                {
                    TenSanPham = s.TenSanPham,
                    SoLuong = s.SoLuong
                })
                .FirstOrDefault();

            // Sản phẩm sắp hết hàng (< 10)
            var lowStockCount = db.tb_SanPham.Count(s => s.SoLuong < 10);

            // Khách hàng mới trong kỳ (không có NgayTao trong tb_TaiKhoan, tạm để 0)
            var newCustomers = 0;

            // Gán ViewBag
            ViewBag.FromDate = fromDate.Value.ToString("yyyy-MM-dd");
            ViewBag.ToDate = toDate.Value.ToString("yyyy-MM-dd");
            ViewBag.RevenueByMonth = revenueByMonth;
            ViewBag.TopProducts = topProducts;
            ViewBag.TotalRevenue = totalRevenue;
            ViewBag.TotalOrders = totalOrders;
            ViewBag.CompletedOrders = completedOrders;
            ViewBag.CancelledOrders = cancelledOrders;
            ViewBag.ReturnedOrders = returnedOrders;
            ViewBag.CancelRate = cancelRate;
            ViewBag.CompleteRate = completeRate;
            ViewBag.ReturnRate = returnRate;
            ViewBag.TopStockProduct = topStockProduct;
            ViewBag.LowStockCount = lowStockCount;
            ViewBag.NewCustomers = newCustomers;

            return View();
        }
