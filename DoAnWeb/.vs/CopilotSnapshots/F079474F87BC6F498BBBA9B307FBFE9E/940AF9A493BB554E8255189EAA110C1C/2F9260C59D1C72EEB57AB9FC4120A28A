        [HttpPost]
        public JsonResult ToggleKhoaTaiKhoan(int id)
        {
            try
            {
                var taiKhoan = db.tb_TaiKhoan.Find(id);
                
                if (taiKhoan == null)
                {
                    return Json(new { success = false, message = "Không tìm thấy tài khoản" });
                }

                // Không cho phép khóa tài khoản admin
                if (taiKhoan.LaQuanTri == true)
                {
                    return Json(new { success = false, message = "Không thể khóa tài khoản quản trị viên" });
                }

                // Toggle trạng thái
                taiKhoan.HoatDong = !taiKhoan.HoatDong;
                db.SaveChanges();

                string message = taiKhoan.HoatDong == true 
                    ? "Đã mở khóa tài khoản thành công" 
                    : "Đã khóa tài khoản thành công";

                return Json(new 
                { 
                    success = true, 
                    message = message,
                    newStatus = taiKhoan.HoatDong
                });
            }
            catch (Exception ex)
            {
                return Json(new { success = false, message = "Có lỗi xảy ra: " + ex.Message });
            }
        }
        public ActionResult TimKhachHang(string timkh, int page = 1)
        {
            int pageSize = 5;
            var query = db.tb_TaiKhoan.AsQueryable();

            // 1. LỌC: Chỉ lấy Khách hàng ngay từ đầu (LaQuanTri == false tương ứng với bit = 0)
            query = query.Where(kh => kh.LaQuanTri == false);

            if (!String.IsNullOrEmpty(timkh))
            {
                string keyword = timkh.ToLower();

                // 2. LỌC: Áp dụng điều kiện tìm kiếm lên danh sách Khách hàng
                query = query.Where(kh =>
                     kh.HoTen.ToLower().Contains(keyword) ||
                     kh.TenDangNhap.ToLower().Contains(keyword));
