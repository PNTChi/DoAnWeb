        /// <summary>
        /// GET: Tìm kiếm tin tức
        /// </summary>
        public ActionResult TimTinTuc(string timtt, int page = 1, int pageSize = 10)
        {
            var query = db.tb_TinTuc.AsQueryable();

            if (!String.IsNullOrEmpty(timtt))
            {
                string keyword = timtt.ToLower();
                query = query.Where(tt =>
                    tt.TieuDe.ToLower().Contains(keyword) ||
                    tt.MoTa.ToLower().Contains(keyword));
            }

            // Pagination
            var totalItems = query.Count();
            var totalPages = (int)Math.Ceiling((double)totalItems / pageSize);
            
            ViewBag.CurrentPage = page;
            ViewBag.TotalPages = totalPages;
            ViewBag.TotalItems = totalItems;
            ViewBag.TuKhoa = timtt;

            var tinTucList = query
                .OrderByDescending(tt => tt.NgayTao)
                .Skip((page - 1) * pageSize)
                .Take(pageSize)
                .ToList();

            return View("TinTuc", tinTucList);
        }

