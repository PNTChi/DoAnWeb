        public ActionResult XoaSP(int id)
        {
            try
            {
                var sanPham = db.tb_SanPham.Find(id);
                if (sanPham == null)
                {
                    TempData["ErrorMessage"] = "Không tìm thấy sản phẩm!";
                    return RedirectToAction("QLSP");
                }

                // Kiểm tra xem sản phẩm có đang được sử dụng trong đơn hàng không
                var isUsedInOrders = db.tb_ChiTietDonHang.Any(ct => ct.SanPhamId == id);

                if (isUsedInOrders)
                {
                    // Không xóa, chỉ ẩn sản phẩm
                    sanPham.HienThi = false;
                    db.SaveChanges();
                    TempData["SuccessMessage"] = "Sản phẩm đã được ẩn (không thể xóa vì đang có trong đơn hàng)";
                    return RedirectToAction("QLSP");
                }

                // Xóa thông số kỹ thuật liên quan
                var thongSo = db.tb_ThongSo.Where(ts => ts.SanPhamId == id).ToList();
                if (thongSo.Any())
                {
                    db.tb_ThongSo.RemoveRange(thongSo);
                }

                // Xóa ảnh sản phẩm phụ từ bảng tb_AnhSanPham
                var anhSanPham = db.tb_AnhSanPham.Where(a => a.SanPhamId == id).ToList();
                if (anhSanPham.Any())
                {
                    foreach (var anh in anhSanPham)
                    {
                        // Xóa file ảnh
                        if (!string.IsNullOrEmpty(anh.HinhAnh))
                        {
                            var imagePath = Path.Combine(Server.MapPath("~/Content/Images"), anh.HinhAnh);
                            if (System.IO.File.Exists(imagePath))
                            {
                                System.IO.File.Delete(imagePath);
                            }
                        }
                    }
                    db.tb_AnhSanPham.RemoveRange(anhSanPham);
                }

                // Xóa ảnh chính của sản phẩm từ thư mục
                if (!string.IsNullOrEmpty(sanPham.HinhAnh))
                {
                    var mainImagePath = Path.Combine(Server.MapPath("~/Content/Images"), sanPham.HinhAnh);
                    if (System.IO.File.Exists(mainImagePath))
                    {
                        System.IO.File.Delete(mainImagePath);
                    }
                }

                // Xóa sản phẩm
                db.tb_SanPham.Remove(sanPham);
                db.SaveChanges();

                TempData["SuccessMessage"] = "Xóa sản phẩm thành công!";
            }
            catch (Exception ex)
            {
                TempData["ErrorMessage"] = "Có lỗi xảy ra khi xóa sản phẩm: " + ex.Message + 
                    (ex.InnerException != null ? " - " + ex.InnerException.Message : "");
            }

            return RedirectToAction("QLSP");
        }











