        [HttpPost]
        [ValidateAntiForgeryToken]
        public ActionResult ThemSP(QLSP sp, HttpPostedFileBase[] fileupload, int defaultImageIndex = 0)
        {
            // Kiểm tra ảnh
            if (fileupload == null || !fileupload.Any(f => f != null && f.ContentLength > 0))
            {
                ViewBag.ThongBao = "Vui lòng chọn ít nhất một ảnh sản phẩm";
                ViewBag.lstDMSP = new SelectList(db.tb_DanhMuc.ToList(), "Id", "TenDanhMuc");
                ViewBag.lstTH = new SelectList(db.tb_ThuongHieu.ToList(), "Id", "TenThuongHieu");
                return View("formThemSP", sp);
            }

            try
            {
                // DEBUG: Log thông tin
                System.Diagnostics.Debug.WriteLine("=== THÊM SẢN PHẨM START ===");
                System.Diagnostics.Debug.WriteLine($"Tên SP: {sp.TenSanPham}");
                System.Diagnostics.Debug.WriteLine($"Mã SP: {sp.MaSanPham}");
                System.Diagnostics.Debug.WriteLine($"DanhMucId: {sp.DanhMucId}");
                System.Diagnostics.Debug.WriteLine($"ThuongHieuId: {sp.ThuongHieuId}");
                System.Diagnostics.Debug.WriteLine($"Số lượng: {sp.SoLuong}");
                System.Diagnostics.Debug.WriteLine($"Giá: {sp.Gia}");
                
                // Lọc các file hợp lệ
                var validFiles = fileupload.Where(f => f != null && f.ContentLength > 0).ToList();
                
                System.Diagnostics.Debug.WriteLine($"Số file upload: {validFiles.Count}");
                
                if (!validFiles.Any())
                {
                    ViewBag.ThongBao = "Vui lòng chọn ít nhất một ảnh sản phẩm";
                    ViewBag.lstDMSP = new SelectList(db.tb_DanhMuc.ToList(), "Id", "TenDanhMuc");
                    ViewBag.lstTH = new SelectList(db.tb_ThuongHieu.ToList(), "Id", "TenThuongHieu");
                    return View("formThemSP", sp);
                }

                // Upload ảnh đầu tiên làm ảnh chính
                var firstFile = validFiles[0];
                var mainFilename = Path.GetFileName(firstFile.FileName);
                var mainPath = Path.Combine(Server.MapPath("~/Content/Images"), mainFilename);
                
                if (System.IO.File.Exists(mainPath))
                {
                    mainFilename = DateTime.Now.Ticks + "_" + mainFilename;
                    mainPath = Path.Combine(Server.MapPath("~/Content/Images"), mainFilename);
                }
                
                firstFile.SaveAs(mainPath);

                // Tạo BiDanh tự động nếu empty
                string biDanh = sp.BiDanh;
                if (string.IsNullOrWhiteSpace(biDanh))
                {
                    // Tạo BiDanh từ TenSanPham
                    biDanh = sp.TenSanPham.ToLower()
                        .Replace(" ", "-")
                        .Replace("á", "a").Replace("à", "a").Replace("ả", "a").Replace("ã", "a").Replace("ạ", "a")
                        .Replace("ă", "a").Replace("ắ", "a").Replace("ằ", "a").Replace("ẳ", "a").Replace("ẵ", "a").Replace("ặ", "a")
                        .Replace("â", "a").Replace("ấ", "a").Replace("ầ", "a").Replace("ẩ", "a").Replace("ẫ", "a").Replace("ậ", "a")
                        .Replace("đ", "d")
                        .Replace("é", "e").Replace("è", "e").Replace("ẻ", "e").Replace("ẽ", "e").Replace("ẹ", "e")
                        .Replace("ê", "e").Replace("ế", "e").Replace("ề", "e").Replace("ể", "e").Replace("ễ", "e").Replace("ệ", "e")
                        .Replace("í", "i").Replace("ì", "i").Replace("ỉ", "i").Replace("ĩ", "i").Replace("ị", "i")
                        .Replace("ó", "o").Replace("ò", "o").Replace("ỏ", "o").Replace("õ", "o").Replace("ọ", "o")
                        .Replace("ô", "o").Replace("ố", "o").Replace("ồ", "o").Replace("ổ", "o").Replace("ỗ", "o").Replace("ộ", "o")
                        .Replace("ơ", "o").Replace("ớ", "o").Replace("ờ", "o").Replace("ở", "o").Replace("ỡ", "o").Replace("ợ", "o")
                        .Replace("ú", "u").Replace("ù", "u").Replace("ủ", "u").Replace("ũ", "u").Replace("ụ", "u")
                        .Replace("ư", "u").Replace("ứ", "u").Replace("ừ", "u").Replace("ử", "u").Replace("ữ", "u").Replace("ự", "u")
                        .Replace("ý", "y").Replace("ỳ", "y").Replace("ỷ", "y").Replace("ỹ", "y").Replace("ỵ", "y");
                    
                    // Thêm timestamp để đảm bảo unique
                    biDanh = biDanh + "-" + DateTime.Now.Ticks;
                    
                    System.Diagnostics.Debug.WriteLine($"BiDanh auto-generated: {biDanh}");
                }
                
                // Tạo sản phẩm mới
                var sanPham = new tb_SanPham
                {
                    TenSanPham = sp.TenSanPham,
                    BiDanh = biDanh,
                    MaSanPham = sp.MaSanPham,
                    MoTa = sp.MoTa,
                    ChiTiet = sp.ChiTiet,
                    Gia = sp.Gia,
                    GiaKhuyenMai = null, // Không có giá khuyến mãi khi tạo mới
                    SoLuong = sp.SoLuong,
                    LuotXem = 0, // Luôn bắt đầu từ 0
                    HinhAnh = mainFilename,
                    DanhMucId = sp.DanhMucId,
                    ThuongHieuId = sp.ThuongHieuId,
                    NgayTao = DateTime.Now,
                    HienThi = true,
                    LaSanPhamMoi = true
                };

                db.tb_SanPham.Add(sanPham);
                db.SaveChanges();

                // Upload các ảnh phụ vào bảng tb_AnhSanPham
                for (int i = 0; i < validFiles.Count; i++)
                {
                    var file = validFiles[i];
                    var filename = Path.GetFileName(file.FileName);
                    var path = Path.Combine(Server.MapPath("~/Content/Images"), filename);
                    
                    if (System.IO.File.Exists(path) && i > 0) // Ảnh đầu đã save rồi
                    {
                        filename = DateTime.Now.Ticks + "_" + i + "_" + filename;
                        path = Path.Combine(Server.MapPath("~/Content/Images"), filename);
                    }
                    
                    if (i > 0) // Chỉ save lại các ảnh từ thứ 2 trở đi
                    {
                        file.SaveAs(path);
                    }

                    // Thêm vào bảng tb_AnhSanPham
                    var anhSanPham = new tb_AnhSanPham
                    {
                        SanPhamId = sanPham.Id,
                        HinhAnh = filename,
                        LaAnhMacDinh = (i == defaultImageIndex) // Ảnh được chọn làm mặc định
                    };
                    
                    db.tb_AnhSanPham.Add(anhSanPham);
                }
                
                db.SaveChanges();

                // Thêm thông số kỹ thuật
                var thongSoList = new List<tb_ThongSo>();
                
                if (!string.IsNullOrEmpty(sp.BoNhoRAM))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Bộ nhớ RAM", GiaTri = sp.BoNhoRAM, ThuTu = 1 });
                
                if (!string.IsNullOrEmpty(sp.BoNhoTrong))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Bộ nhớ trong", GiaTri = sp.BoNhoTrong, ThuTu = 2 });
                
                if (!string.IsNullOrEmpty(sp.ManHinh))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Màn hình", GiaTri = sp.ManHinh, ThuTu = 3 });
                
                if (!string.IsNullOrEmpty(sp.DungLuongPin))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Dung lượng pin", GiaTri = sp.DungLuongPin, ThuTu = 4 });
                
                if (!string.IsNullOrEmpty(sp.Camera))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Camera", GiaTri = sp.Camera, ThuTu = 5 });
                
                if (!string.IsNullOrEmpty(sp.HeDieuHanh))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Hệ điều hành", GiaTri = sp.HeDieuHanh, ThuTu = 6 });
                
                if (!string.IsNullOrEmpty(sp.CongKetNoi))
                    thongSoList.Add(new tb_ThongSo { SanPhamId = sanPham.Id, TenThongSo = "Cổng kết nối", GiaTri = sp.CongKetNoi, ThuTu = 7 });

                if (thongSoList.Any())
                {
                    db.tb_ThongSo.AddRange(thongSoList);
                    db.SaveChanges();
                }

                TempData["SuccessMessage"] = "Thêm sản phẩm thành công!";
                return RedirectToAction("QLSP");
            }
            catch (Exception ex)
            {
                ViewBag.ThongBao = "Có lỗi xảy ra: " + ex.Message;
                ViewBag.lstDMSP = new SelectList(db.tb_DanhMuc.ToList(), "Id", "TenDanhMuc");
                ViewBag.lstTH = new SelectList(db.tb_ThuongHieu.ToList(), "Id", "TenThuongHieu");
                return View("formThemSP", sp);
            }
        }
        
        
        
        
        
        
        
        
        
