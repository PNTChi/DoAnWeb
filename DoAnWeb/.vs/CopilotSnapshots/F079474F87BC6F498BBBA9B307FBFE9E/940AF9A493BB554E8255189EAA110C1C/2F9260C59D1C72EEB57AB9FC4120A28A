        /// <summary>
        /// POST: Cập nhật trạng thái đơn hàng (1→2→3→4)
        /// </summary>
        [HttpPost]
        public JsonResult CapNhatTrangThaiDonHang(int id, int trangThaiMoi)
        {
            try
            {
                var donHang = db.tb_DonHang.Find(id);

                if (donHang == null)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Không tìm thấy đơn hàng"
                    });
                }

                // Validate trạng thái mới
                if (trangThaiMoi < 1 || trangThaiMoi > 5)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Trạng thái không hợp lệ"
                    });
                }

                // Không cho phép quay lại trạng thái cũ
                if (trangThaiMoi <= donHang.TrangThai)
                {
                    return Json(new
                    {
                        success = false,
                        message = "Không thể quay lại trạng thái trước đó"
                    });
                }

                // Cập nhật trạng thái
                donHang.TrangThai = trangThaiMoi;
                donHang.NgayCapNhat = DateTime.Now;
                db.SaveChanges();

                string message = "";
                switch (trangThaiMoi)
                {
                    case 2:
                        message = "Đơn hàng đã được xác nhận";
                        break;
                    case 3:
                        message = "Đơn hàng đang được giao";
                        break;
                    case 4:
                        message = "Đơn hàng đã giao thành công";
                        break;
                    case 5:
                        message = "Đơn hàng đã hoàn thành";
                        break;
                    default:
                        message = "Cập nhật trạng thái thành công";
                        break;
                }

                return Json(new
                {
                    success = true,
                    message = message
                });
            }
            catch (Exception ex)
            {
                return Json(new
                {
                    success = false,
                    message = "Có lỗi xảy ra: " + ex.Message
                });
            }
        }

