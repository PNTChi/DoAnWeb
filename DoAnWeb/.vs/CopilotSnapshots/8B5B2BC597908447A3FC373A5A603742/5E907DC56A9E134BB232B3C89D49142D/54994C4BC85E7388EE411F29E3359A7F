@section scripts {
<script>
    // ========== AUTHENTICATION CHECK ==========
    var isUserAuthenticated = @(Request.IsAuthenticated ? "true" : "false");
    
    function checkLogin() {
        if (!isUserAuthenticated) {
            Swal.fire({
                icon: 'warning',
                title: 'Vui lòng đăng nhập!',
                text: 'Bạn cần đăng nhập để thêm sản phẩm vào giỏ hàng',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                cancelButtonText: 'Hủy',
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#6b7280'
            }).then((result) => {
                if (result.isConfirmed) {
                    window.location.href = '@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })';
                }
            });
            return false;
        }
        return true;
    }

    // ========== ADD TO CART FUNCTION ==========
    function addToCart(productId, productName, price, image) {
        // Show loading (không check frontend nữa, để backend handle)
        Swal.fire({
            title: 'Đang xử lý...',
            html: 'Vui lòng đợi trong giây lát',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.ajax({
            url: '@Url.Action("AddToCart", "GioHang")',
            type: 'POST',
            data: {
                productId: productId,
                quantity: 1,
                color: ''
            },
            success: function(response) {
                Swal.close();
                
                if (response.success) {
                    // Show success with product info
                    Swal.fire({
                        icon: 'success',
                        title: 'Thành công!',
                        html: `
                            <div class="text-left">
                                <div class="flex items-center space-x-4 p-4 bg-gray-50 rounded-lg mb-4">
                                    <img src="${image}" alt="${productName}" class="w-20 h-20 object-contain rounded border">
                                    <div>
                                        <p class="font-semibold text-gray-900">${productName}</p>
                                        <p class="text-sm text-gray-600">Giá: ${formatCurrency(price)}</p>
                                        <p class="text-sm text-blue-600">Số lượng: 1</p>
                                    </div>
                                </div>
                                <p class="text-center text-gray-700">Sản phẩm đã được thêm vào giỏ hàng!</p>
                                <p class="text-center text-sm text-gray-500 mt-2">Tổng: <strong>${response.cartCount}</strong> sản phẩm - <strong>${formatCurrency(response.cartTotal)}</strong></p>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-shopping-cart mr-2"></i>Xem giỏ hàng',
                        cancelButtonText: '<i class="fas fa-shopping-bag mr-2"></i>Tiếp tục mua',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280',
                        customClass: {
                            popup: 'rounded-xl',
                            confirmButton: 'px-6 py-3 rounded-lg font-bold',
                            cancelButton: 'px-6 py-3 rounded-lg font-bold'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Index", "GioHang")';
                        }
                    });

                    // Update cart count in header (if exists)
                    updateCartCount(response.cartCount);
                } else if (response.requireLogin) {
                    // User not logged in (backend check)
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vui lòng đăng nhập!',
                        text: response.message,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })';
                        }
                    });
                } else {
                    // Other errors
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: response.message,
                        confirmButtonText: 'Đóng',
                        confirmButtonColor: '#ef4444'
                    });
                }
            },
            error: function(xhr, status, error) {
                Swal.close();
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra. Vui lòng thử lại sau.',
                    confirmButtonText: 'Đóng',
                    confirmButtonColor: '#ef4444'
                });
            }
        });
    }

    // ========== ADD TO WISHLIST FUNCTION ==========
    function addToWishlist(productId) {
        // Không check frontend, để backend handle
        $.ajax({
            url: '@Url.Action("ThemYeuThich", "SanPham")',
            type: 'POST',
            data: {
                sanPhamId: productId,
                __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
            },
            success: function(response) {
                if (response.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Thêm vào yêu thích!',
                        text: response.message,
                        timer: 2000,
                        showConfirmButton: false
                    });
                } else if (response.requireLogin) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Vui lòng đăng nhập!',
                        text: response.message,
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-sign-in-alt mr-2"></i>Đăng nhập',
                        cancelButtonText: 'Hủy',
                        confirmButtonColor: '#3b82f6',
                        cancelButtonColor: '#6b7280'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            window.location.href = '@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl })';
                        }
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Lỗi!',
                        text: response.message,
                        timer: 2000
                    });
                }
            },
            error: function() {
                Swal.fire({
                    icon: 'error',
                    title: 'Lỗi!',
                    text: 'Có lỗi xảy ra. Vui lòng thử lại sau.',
                    timer: 2000
                });
            }
        });
    }

    // ========== HELPER FUNCTIONS ==========
    
    // Format currency
    function formatCurrency(amount) {
        return new Intl.NumberFormat('vi-VN').format(amount) + ' ₫';
    }

    // Update cart count in header
    function updateCartCount(count) {
        $('.cart-count').text(count);
        $('.cart-badge').text(count);
        
        // Add animation
        $('.cart-count, .cart-badge').addClass('animate-pulse');
        setTimeout(function() {
            $('.cart-count, .cart-badge').removeClass('animate-pulse');
        }, 1000);
    }

    // ========== PAGE LOAD ==========
    $(document).ready(function() {
        // Banner slider
        var currentSlide = 0;
        var slides = $('#bannerSlides').children();
        var totalSlides = slides.length;
        
        function showSlide(index) {
            var offset = -index * 100;
            $('#bannerSlides').css('transform', 'translateX(' + offset + '%)');
            
            // Update dots
            $('[data-index]').removeClass('bg-blue-600').addClass('bg-gray-300');
            $('[data-index="' + index + '"]').removeClass('bg-gray-300').addClass('bg-blue-600');
        }
        
        // Auto slide
        setInterval(function() {
            currentSlide = (currentSlide + 1) % totalSlides;
            showSlide(currentSlide);
        }, 5000);
        
        // Manual slide
        $('[data-index]').click(function() {
            currentSlide = parseInt($(this).data('index'));
            showSlide(currentSlide);
        });
        
        // Product slider
        $('.product-slider').each(function() {
            var slider = $(this);
            var slides = slider.find('.product-slides');
            var prevBtn = slider.find('.prev-btn');
            var nextBtn = slider.find('.next-btn');
            var scrollAmount = 300;
            
            prevBtn.click(function() {
                slides.animate({scrollLeft: '-=' + scrollAmount}, 300);
            });
            
            nextBtn.click(function() {
                slides.animate({scrollLeft: '+=' + scrollAmount}, 300);
            });
        });
    });
</script>
}