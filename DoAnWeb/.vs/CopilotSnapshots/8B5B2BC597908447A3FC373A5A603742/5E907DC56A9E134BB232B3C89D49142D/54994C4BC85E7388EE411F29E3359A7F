@model DoAnWeb.Models.HomeViewModel
@{
    ViewBag.Title = "Trang Chủ";
}

<!-- Banner Slider -->
@if (Model.QuangCao != null && Model.QuangCao.Any())
{
    <div class="relative mb-8 rounded-xl overflow-hidden">
        <div id="bannerContainer" class="relative h-96 bg-gray-200 overflow-hidden">
            <div class="flex transition-transform duration-700 ease-in-out" id="bannerSlides">
                @foreach (var banner in Model.QuangCao)
                {
                    @if (!string.IsNullOrEmpty(banner.HinhAnh))
                    {
                        var target = banner.MoTrangMoi == true ? "_blank" : "_self";
                        if (!string.IsNullOrEmpty(banner.LienKet))
                        {
                            <a href="@banner.LienKet" class="w-full h-full flex-shrink-0 block" target="@target">
                                <img src="@Url.Content("~/Content/Images/" + banner.HinhAnh)" 
                                     alt="@banner.TieuDe" 
                                     class="w-full h-full object-cover">
                            </a>
                        }
                        else
                        {
                            <div class="w-full h-full flex-shrink-0">
                                <img src="@Url.Content("~/Content/Images/" + banner.HinhAnh)" 
                                     alt="@banner.TieuDe" 
                                     class="w-full h-full object-cover">
                            </div>
                        }
                    }
                }
            </div>
            @if (Model.QuangCao.FirstOrDefault() != null)
            {
                var firstBanner = Model.QuangCao.FirstOrDefault();
                var bannerTarget = firstBanner.MoTrangMoi == true ? "_blank" : "_self";
                <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-6 text-white">
                    <h2 class="text-3xl font-bold">@(firstBanner.TieuDe ?? "Ưu đãi đặc biệt")</h2>
                    <p class="text-xl">@(firstBanner.MoTa ?? "Khám phá ngay các sản phẩm hot nhất")</p>
                    @if (!string.IsNullOrEmpty(firstBanner.LienKet))
                    {
                        <a href="@firstBanner.LienKet" target="@bannerTarget" class="mt-4 px-6 py-2 bg-red-600 rounded-lg font-medium hover:bg-red-700 transition inline-block">Xem ngay</a>
                    }
                </div>
            }
        </div>
        <div class="flex justify-center mt-4 space-x-2">
            @for (int i = 0; i < Model.QuangCao.Count; i++)
            {
                <button class="w-3 h-3 rounded-full @(i == 0 ? "bg-blue-600" : "bg-gray-300")" data-index="@i"></button>
            }
        </div>
    </div>
}
else
{
    <!-- Fallback nếu không có quảng cáo -->
    <div class="relative mb-8 rounded-xl overflow-hidden">
        <div id="bannerContainer" class="relative h-96 bg-gray-200 overflow-hidden">
            <div class="flex transition-transform duration-700 ease-in-out" id="bannerSlides">
                <img src="https://placehold.co/1200x500?text=Banner+1" class="w-full h-full object-cover flex-shrink-0" alt="Banner 1">
                <img src="https://placehold.co/1200x500?text=Banner+2" class="w-full h-full object-cover flex-shrink-0" alt="Banner 2">
                <img src="https://placehold.co/1200x500?text=Banner+3" class="w-full h-full object-cover flex-shrink-0" alt="Banner 3">
                <img src="https://placehold.co/1200x500?text=Banner+4" class="w-full h-full object-cover flex-shrink-0" alt="Banner 4">
            </div>
            <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-6 text-white">
                <h2 class="text-3xl font-bold">Ưu đãi mùa hè 2024</h2>
                <p class="text-xl">Giảm giá lên đến 50% - Trả góp 0%</p>
                <button class="mt-4 px-6 py-2 bg-red-600 rounded-lg font-medium hover:bg-red-700 transition">Xem ngay</button>
            </div>
        </div>
        <div class="flex justify-center mt-4 space-x-2">
            <button class="w-3 h-3 rounded-full bg-blue-600" data-index="0"></button>
            <button class="w-3 h-3 rounded-full bg-gray-300" data-index="1"></button>
            <button class="w-3 h-3 rounded-full bg-gray-300" data-index="2"></button>
            <button class="w-3 h-3 rounded-full bg-gray-300" data-index="3"></button>
        </div>
    </div>
