## 💻 Code Implementation

### 1. TaiKhoanController.cs

#### Method: YeuCauTraHang
```csharp
[HttpPost]
[ValidateAntiForgeryToken]
public JsonResult YeuCauTraHang(int id, string lyDo)
{
    // Validate
    if (!IsAuthenticated)
        return Json(new { success = false, message = "Vui lòng đăng nhập" });

    var donHang = db.tb_DonHang
        .FirstOrDefault(dh => dh.Id == id && dh.TaiKhoanId == CurrentUser.Id);

    if (donHang == null)
        return Json(new { success = false, message = "Không tìm thấy đơn hàng" });

    // ⭐ QUAN TRỌNG: Chỉ cho phép khi trạng thái = 3 (Đang giao)
    if (donHang.TrangThai != 3)
        return Json(new { success = false, message = "Không thể yêu cầu trả hàng" });

    // Validate lý do
    if (string.IsNullOrWhiteSpace(lyDo) || lyDo.Length < 10)
        return Json(new { success = false, message = "Vui lòng nhập lý do (tối thiểu 10 ký tự)" });

    // Cập nhật trạng thái
    donHang.TrangThai = 6; // Yêu cầu trả hàng
    donHang.NgayCapNhat = DateTime.Now;
    db.SaveChanges();

    return Json(new { success = true, message = "Đã gửi yêu cầu trả hàng. Chúng tôi sẽ liên hệ sớm nhất." });
}
```

### 2. AdminController.cs

#### Method: HoanTienKhachHang
```csharp
[HttpPost]
public JsonResult HoanTienKhachHang(int id)
{
    var donHang = db.tb_DonHang.Find(id);

    if (donHang == null)
        return Json(new { success = false, message = "Không tìm thấy đơn hàng" });

    // ⭐ Chỉ cho phép khi trạng thái = 6 (Yêu cầu trả hàng)
    if (donHang.TrangThai != 6)
        return Json(new { success = false, message = "Chỉ có thể hoàn tiền khi ở trạng thái 'Yêu cầu trả hàng'" });

    // ⭐ Kiểm tra không phải COD
    if (donHang.LoaiThanhToan == 1) // 1 = COD
        return Json(new { success = false, message = "Đơn COD không cần hoàn tiền" });

    // Hoàn số lượng sản phẩm về kho
    var chiTietDonHang = db.tb_ChiTietDonHang.Where(ct => ct.DonHangId == id).ToList();
    
    foreach (var chiTiet in chiTietDonHang)
    {
        var sanPham = db.tb_SanPham.Find(chiTiet.SanPhamId);
        if (sanPham != null)
        {
            sanPham.SoLuong = (sanPham.SoLuong ?? 0) + chiTiet.SoLuong;
        }
    }

    // Cập nhật trạng thái
    donHang.TrangThai = -1; // Đã hoàn tiền
    donHang.NgayCapNhat = DateTime.Now;
    db.SaveChanges();

    return Json(new { success = true, message = "Đã hoàn tiền thành công!" });
}
```

