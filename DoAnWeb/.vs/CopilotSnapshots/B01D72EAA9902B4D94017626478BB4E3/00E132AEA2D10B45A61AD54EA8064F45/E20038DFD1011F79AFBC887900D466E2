@model DoAnWeb.Models.ProductListViewModel

@{
    ViewBag.Title = Model.CurrentCategoryName;
}

<!-- Breadcrumb -->
<nav class="flex mb-6" aria-label="Breadcrumb">
    <ol class="inline-flex items-center space-x-1 md:space-x-3">
        <li class="inline-flex items-center">
            <a href="@Url.Action("Index", "Home")" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">
                <i class="fas fa-home mr-2"></i>
                Trang chủ
            </a>
        </li>
        @if (ViewBag.TenDanhMuc != null)
        {
            <li>
                <div class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                    <a href="@Url.Action("Index", "SanPham", new { danhMucId = ViewBag.DanhMucId })" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                        @ViewBag.TenDanhMuc
                    </a>
                </div>
            </li>
        }
        @if (ViewBag.TenThuongHieu != null)
        {
            <li>
                <div class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                    @if (ViewBag.TenDanhMuc != null)
                    {
                        <a href="@Url.Action("Index", "SanPham", new { thuongHieuId = ViewBag.ThuongHieuId })" class="text-sm font-medium text-gray-700 hover:text-blue-600">
                            @ViewBag.TenThuongHieu
                        </a>
                    }
                    else
                    {
                        <span class="text-sm font-medium text-gray-500">@ViewBag.TenThuongHieu</span>
                    }
                </div>
            </li>
        }
        @if (ViewBag.TenDanhMuc == null && ViewBag.TenThuongHieu == null)
        {
            <li aria-current="page">
                <div class="flex items-center">
                    <i class="fas fa-chevron-right text-gray-400 mx-2"></i>
                    <span class="text-sm font-medium text-gray-500">@Model.CurrentCategoryName</span>
                </div>
            </li>
        }
    </ol>
</nav>

<!-- Page Header -->
<div class="bg-white rounded-lg shadow-md p-6 mb-6">
  <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900 mb-2">@Model.CurrentCategoryName</h1>
   <p class="text-gray-600">
         Tìm thấy <span class="font-semibold text-blue-600">@Model.TotalProducts</span> sản phẩm
 </p>
     </div>

  <!-- Sort Options -->
   <form method="get" action="@Url.Action("Index")" class="mt-4 md:mt-0">
        @if (Model.DanhMucId.HasValue)
        {
            <input type="hidden" name="danhMucId" value="@Model.DanhMucId" />
        }
        @if (Model.ThuongHieuId.HasValue)
        {
            <input type="hidden" name="thuongHieuId" value="@Model.ThuongHieuId" />
        }
        @if (!string.IsNullOrEmpty(Model.SearchKeyword))
        {
            <input type="hidden" name="search" value="@Model.SearchKeyword" />
        }
        
        <select name="loc" onchange="this.form.submit()" class="px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 cursor-pointer">
            <option value="moi" @(Model.FilterType == "moi" || string.IsNullOrEmpty(Model.FilterType) ? "selected" : "")>Mới nhất</option>
            <option value="banchay" @(Model.FilterType == "banchay" ? "selected" : "")>Bán chạy</option>
            <option value="gia-tang" @(Model.FilterType == "gia-tang" ? "selected" : "")>Giá: Thấp đến cao</option>
            <option value="gia-giam" @(Model.FilterType == "gia-giam" ? "selected" : "")>Giá: Cao đến thấp</option>
        </select>
    </form>
    </div>
</div>

@if (Model.Products != null && Model.Products.Any())
{
    <!-- Product Grid -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8">
        @foreach (var sp in Model.Products)
   {
            <a href="@Url.Action("ChiTietSP", "SanPham", new { id = sp.Id })" class="group block bg-white rounded-lg shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
          <!-- Product Image -->
       <div class="aspect-square overflow-hidden bg-gray-100 relative">
      @if (!string.IsNullOrEmpty(sp.HinhAnh))
     {
          <img src="@Url.Content("~/Content/Images/" + sp.HinhAnh)" 
         onerror="this.onerror=null;this.src='/Content/Images/no-image.png';" 
         alt="@sp.TenSanPham" 
    class="w-full h-full object-contain group-hover:scale-110 transition-transform duration-300" />
       }
         else
             {
               <img src="@Url.Content("~/Content/Images/no-image.png")" 
        alt="No Image" 
     class="w-full h-full object-contain" />
         }

  <!-- Badges -->
   @if (sp.LaSanPhamMoi == true)
             {
       <span class="absolute top-2 left-2 bg-green-500 text-white text-xs font-bold px-2 py-1 rounded">
          MỚI
      </span>
               }
   @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai < sp.Gia)
   {
            <span class="absolute top-2 right-2 bg-red-500 text-white text-xs font-bold px-2 py-1 rounded">
     -@Math.Round((decimal)(1 - (sp.GiaKhuyenMai.Value / sp.Gia.Value)) * 100)%
       </span>
          }

              <!-- Quick View Button (Optional) -->
  <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-10 transition-all duration-300 flex items-center justify-center">
            <button class="opacity-0 group-hover:opacity-100 bg-white text-blue-600 px-4 py-2 rounded-lg font-semibold transition-all duration-300 transform translate-y-4 group-hover:translate-y-0">
         <i class="fas fa-eye mr-2"></i>Xem nhanh
            </button>
    </div>
           </div>

   <!-- Product Info -->
        <div class="p-4">
     <!-- Product Name -->
    <h3 class="text-sm font-semibold text-gray-900 mb-2 line-clamp-2 h-10 group-hover:text-blue-600">
           @sp.TenSanPham
    </h3>

         <!-- Brand (if available) -->
 @if (sp.tb_ThuongHieu != null)
        {
      <p class="text-xs text-gray-500 mb-2">@sp.tb_ThuongHieu.TenThuongHieu</p>
   }

      <!-- Price -->
          @if (sp.GiaKhuyenMai.HasValue && sp.GiaKhuyenMai < sp.Gia)
     {
    <div class="space-y-1">
            <div class="text-lg font-bold text-red-600">
    @sp.GiaKhuyenMai.Value.ToString("#,##0").Replace(',', '.') ₫
          </div>
            <div class="text-sm text-gray-500 line-through">
          @(sp.Gia.HasValue ? sp.Gia.Value.ToString("#,##0").Replace(',', '.') : "0") ₫
 </div>
           </div>
      }
      else
   {
    <div class="text-lg font-bold text-blue-600">
   @(sp.Gia.HasValue ? sp.Gia.Value.ToString("#,##0").Replace(',', '.') : "0") ₫
     </div>
            }

     <!-- Rating & Views -->
            <div class="flex items-center justify-between mt-3 text-xs text-gray-600">
       <div class="flex items-center">
        <i class="fas fa-star text-yellow-400 mr-1"></i>
        <span>4.5</span>
          </div>
       <div class="flex items-center">
      <i class="fas fa-eye mr-1"></i>
     <span>@(sp.LuotXem ?? 0)</span>
  </div>
 </div>

        <!-- Stock Status -->
        @if (sp.SoLuong.HasValue && sp.SoLuong > 0)
             {
      <div class="mt-3 text-xs text-green-600 flex items-center">
          <i class="fas fa-check-circle mr-1"></i>
              Còn hàng
  </div>
       }
      else
          {
      <div class="mt-3 text-xs text-red-600 flex items-center">
  <i class="fas fa-times-circle mr-1"></i>
       Hết hàng
    </div>
         }
  </div>
        </a>
        }
    </div>

    <!-- Pagination -->
    if (Model.TotalPages > 1)
    {
        <div class="bg-white rounded-lg shadow-md p-6">
            <nav class="flex items-center justify-between">
    <!-- Previous Button -->
      @if (Model.HasPreviousPage)
        {
               <a href="@Url.Action("Index", new { 
     danhMucId = Model.DanhMucId, 
        thuongHieuId = Model.ThuongHieuId, 
    search = Model.SearchKeyword,
              loc = Model.FilterType,
             page = Model.CurrentPage - 1 
                })" 
      class="flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
    <i class="fas fa-chevron-left mr-2"></i>
     Trang trước
    </a>
    }
            else
        {
  <span class="flex items-center px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed">
            <i class="fas fa-chevron-left mr-2"></i>
    Trang trước
            </span>
   }

  <!-- Page Numbers -->
      <div class="flex items-center space-x-2">
    @{
      int startPage = Math.Max(1, Model.CurrentPage - 2);
      int endPage = Math.Min(Model.TotalPages, Model.CurrentPage + 2);
     }

     @if (startPage > 1)
    {
      <a href="@Url.Action("Index", new { 
      danhMucId = Model.DanhMucId, 
      thuongHieuId = Model.ThuongHieuId, 
     search = Model.SearchKeyword,
    loc = Model.FilterType,
         page = 1 
  })" 
      class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">
        1
      </a>
            if (startPage > 2)
     {
            <span class="px-2 text-gray-500">...</span>
 }
    }

           @for (int i = startPage; i <= endPage; i++)
           {
        if (i == Model.CurrentPage)
   {
        <span class="px-3 py-2 text-sm font-medium text-white bg-blue-600 border border-blue-600 rounded">
    @i
   </span>
       }
      else
 {
              <a href="@Url.Action("Index", new { 
            danhMucId = Model.DanhMucId, 
       thuongHieuId = Model.ThuongHieuId, 
 search = Model.SearchKeyword,
   loc = Model.FilterType,
                 page = i 
                })" 
       class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">
      @i
</a>
         }
 }

                @if (endPage < Model.TotalPages)
        {
                 if (endPage < Model.TotalPages - 1)
    {
     <span class="px-2 text-gray-500">...</span>
          }
    <a href="@Url.Action("Index", new { 
    danhMucId = Model.DanhMucId, 
  thuongHieuId = Model.ThuongHieuId, 
               search = Model.SearchKeyword,
        loc = Model.FilterType,
             page = Model.TotalPages 
     })" 
    class="px-3 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded hover:bg-gray-50">
      @Model.TotalPages
                  </a>
         }
             </div>

       <!-- Next Button -->
                @if (Model.HasNextPage)
                {
          <a href="@Url.Action("Index", new { 
              danhMucId = Model.DanhMucId, 
      thuongHieuId = Model.ThuongHieuId, 
      search = Model.SearchKeyword,
      loc = Model.FilterType,
        page = Model.CurrentPage + 1 
         })" 
           class="flex items-center px-4 py-2 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-lg hover:bg-gray-50">
          Trang sau
        <i class="fas fa-chevron-right ml-2"></i>
          </a>
           }
          else
                {
        <span class="flex items-center px-4 py-2 text-sm font-medium text-gray-400 bg-gray-100 border border-gray-200 rounded-lg cursor-not-allowed">
    Trang sau
      <i class="fas fa-chevron-right ml-2"></i>
       </span>
    }
      </nav>

      <!-- Page Info -->
<div class="mt-4 text-center text-sm text-gray-600">
   Trang <span class="font-semibold">@Model.CurrentPage</span> / <span class="font-semibold">@Model.TotalPages</span>
  (Hiển thị @((Model.CurrentPage - 1) * Model.PageSize + 1) - @Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalProducts) của @Model.TotalProducts sản phẩm)
   </div>
        </div>
    }
}
else
{
    <!-- No Products Found -->
    <div class="bg-white rounded-lg shadow-md p-12 text-center">
        <div class="mb-6">
       <i class="fas fa-box-open text-gray-300 text-6xl"></i>
        </div>
      <h3 class="text-2xl font-bold text-gray-700 mb-4">Không tìm thấy sản phẩm nào</h3>
        <p class="text-gray-500 mb-6">
 @if (!string.IsNullOrEmpty(Model.SearchKeyword))
            {
         <span>Không có sản phẩm nào phù hợp với từ khóa "<strong>@Model.SearchKeyword</strong>"</span>
       }
            else
            {
 <span>Không có sản phẩm nào trong danh mục này</span>
            }
 </p>
    <a href="@Url.Action("Index", "Home")" class="inline-flex items-center px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition">
            <i class="fas fa-home mr-2"></i>
            Về trang chủ
        </a>
    </div>
}

@section scripts {
    <script>
   // Smooth scroll to top when changing page
      if (window.location.search.includes('page=')) {
  window.scrollTo({ top: 0, behavior: 'smooth' });
        }
    </script>
}
