@{
    ViewBag.Title = "Về Đồ Án Lập Trình Web";
}

<!-- Hero Section -->
<div class="bg-gradient-to-r from-blue-600 to-blue-800 text-white rounded-lg shadow-lg p-8 md:p-12 mb-8">
    <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">
            <i class="fas fa-graduation-cap mr-3"></i>Về Đồ Án Lập Trình Web
        </h1>
        <p class="text-lg md:text-xl text-blue-100 mb-6">
            Website Thương Mại Điện Tử - Bán Thiết Bị Điện Tử
        </p>
        <div class="flex flex-wrap justify-center gap-4 text-sm md:text-base">
            <div class="bg-white/10 backdrop-blur-sm rounded-full px-6 py-2">
                <i class="fas fa-university mr-2"></i>
                Trường ĐH Công Thương TP.HCM
            </div>
            <div class="bg-white/10 backdrop-blur-sm rounded-full px-6 py-2">
                <i class="fas fa-book mr-2"></i>
                Môn: Lập Trình Web
            </div>
        </div>
    </div>
</div>

<!-- Introduction Section -->
<div class="bg-white rounded-lg shadow-md p-6 md:p-8 mb-8">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-800 mb-4 flex items-center">
            <i class="fas fa-info-circle text-blue-600 mr-3"></i>
            Giới Thiệu Dự Án
        </h2>
        <div class="prose prose-lg max-w-none">
            <p class="text-gray-700 leading-relaxed mb-4">
                Đây là đồ án môn <strong>Lập Trình Web</strong> với chủ đề xây dựng website thương mại điện tử 
                chuyên bán các thiết bị điện tử như điện thoại, laptop, tablet, phụ kiện và các sản phẩm công nghệ khác.
            </p>
            <p class="text-gray-700 leading-relaxed mb-4">
                Website được phát triển với mục tiêu tạo ra một nền tảng mua sắm trực tuyến hiện đại, 
                thân thiện với người dùng, tích hợp đầy đủ các tính năng cần thiết cho một hệ thống thương mại điện tử.
            </p>
            
            <div class="bg-blue-50 border-l-4 border-blue-600 p-4 my-6">
                <h3 class="font-bold text-blue-900 mb-2">
                    <i class="fas fa-bullseye mr-2"></i>Mục Tiêu Đồ Án:
                </h3>
                <ul class="list-disc list-inside text-gray-700 space-y-2 ml-4">
                    <li>Áp dụng kiến thức về ASP.NET MVC, Entity Framework và SQL Server</li>
                    <li>Xây dựng hệ thống quản lý sản phẩm, đơn hàng và khách hàng hoàn chỉnh</li>
                    <li>Thiết kế giao diện responsive, thân thiện với mọi thiết bị</li>
                    <li>Tích hợp các tính năng thanh toán, quản lý giỏ hàng và theo dõi đơn hàng</li>
                    <li>Xây dựng trang quản trị (Admin) với đầy đủ chức năng CRUD</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<!-- Buying Guide Section -->
<div id="guideline" class="bg-white rounded-lg shadow-md p-6 md:p-8 mb-8">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center flex items-center justify-center">
            <i class="fas fa-shopping-bag text-blue-600 mr-3"></i>
            Hướng Dẫn Mua Hàng Online
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- Step 1 -->
            <div class="text-center group">
                <div class="bg-gradient-to-br from-blue-500 to-blue-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg group-hover:scale-110 transition-transform">
                    <i class="fas fa-search text-3xl text-white"></i>
                </div>
                <div class="bg-blue-600 text-white rounded-full px-4 py-1 inline-block mb-3 text-sm font-bold">
                    Bước 1
                </div>
                <h3 class="font-bold text-gray-800 mb-2">Tìm Kiếm Sản Phẩm</h3>
                <p class="text-gray-600 text-sm">
                    Sử dụng thanh tìm kiếm hoặc duyệt qua các danh mục để tìm sản phẩm yêu thích
                </p>
            </div>
            
            <!-- Step 2 -->
            <div class="text-center group">
                <div class="bg-gradient-to-br from-green-500 to-green-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg group-hover:scale-110 transition-transform">
                    <i class="fas fa-cart-plus text-3xl text-white"></i>
                </div>
                <div class="bg-green-600 text-white rounded-full px-4 py-1 inline-block mb-3 text-sm font-bold">
                    Bước 2
                </div>
                <h3 class="font-bold text-gray-800 mb-2">Thêm Vào Giỏ Hàng</h3>
                <p class="text-gray-600 text-sm">
                    Chọn số lượng và nhấn "Thêm vào giỏ hàng". Kiểm tra giỏ hàng bất kỳ lúc nào
                </p>
            </div>
            
            <!-- Step 3 -->
            <div class="text-center group">
                <div class="bg-gradient-to-br from-orange-500 to-orange-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg group-hover:scale-110 transition-transform">
                    <i class="fas fa-clipboard-check text-3xl text-white"></i>
                </div>
                <div class="bg-orange-600 text-white rounded-full px-4 py-1 inline-block mb-3 text-sm font-bold">
                    Bước 3
                </div>
                <h3 class="font-bold text-gray-800 mb-2">Điền Thông Tin</h3>
                <p class="text-gray-600 text-sm">
                    Nhập thông tin giao hàng, chọn phương thức vận chuyển và thanh toán
                </p>
            </div>
            
            <!-- Step 4 -->
            <div class="text-center group">
                <div class="bg-gradient-to-br from-purple-500 to-purple-600 w-20 h-20 rounded-full flex items-center justify-center mx-auto mb-4 shadow-lg group-hover:scale-110 transition-transform">
                    <i class="fas fa-credit-card text-3xl text-white"></i>
                </div>
                <div class="bg-purple-600 text-white rounded-full px-4 py-1 inline-block mb-3 text-sm font-bold">
                    Bước 4
                </div>
                <h3 class="font-bold text-gray-800 mb-2">Thanh Toán</h3>
                <p class="text-gray-600 text-sm">
                    Xác nhận đơn hàng và hoàn tất thanh toán. Theo dõi đơn hàng trong tài khoản
                </p>
            </div>
        </div>
        
        <!-- Additional Info -->
        <div class="mt-8 bg-gradient-to-r from-blue-50 to-purple-50 rounded-lg p-6 border border-blue-100">
            <div class="flex items-start space-x-4">
                <i class="fas fa-lightbulb text-yellow-500 text-2xl mt-1"></i>
                <div>
                    <h4 class="font-bold text-gray-800 mb-2">Lưu Ý Quan Trọng:</h4>
                    <ul class="text-gray-700 text-sm space-y-1">
                        <li><i class="fas fa-check text-green-500 mr-2"></i>Hỗ trợ thanh toán COD (Thanh toán khi nhận hàng)</li>
                        <li><i class="fas fa-check text-green-500 mr-2"></i>Miễn phí vận chuyển cho đơn hàng từ 500.000đ</li>
                        <li><i class="fas fa-check text-green-500 mr-2"></i>Chính sách đổi trả trong vòng 7 ngày</li>
                        <li><i class="fas fa-check text-green-500 mr-2"></i>Bảo hành chính hãng theo quy định nhà sản xuất</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Team Section -->
<div class="bg-white rounded-lg shadow-md p-6 md:p-8 mb-8">
    <div class="max-w-4xl mx-auto">
        <h2 class="text-2xl font-bold text-gray-800 mb-6 text-center flex items-center justify-center">
            <i class="fas fa-users text-blue-600 mr-3"></i>
            Đội Ngũ Phát Triển
        </h2>
        
        <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-lg p-6 border border-blue-100">
            <div class="text-center">
                <div class="inline-block bg-white rounded-full p-4 shadow-md mb-4">
                    <i class="fas fa-user-graduate text-5xl text-blue-600"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Sinh Viên Thực Hiện</h3>
                <p class="text-gray-600 mb-4">
                    Đồ án được thực hiện bởi sinh viên khoa Công Nghệ Thông Tin
                </p>
                <div class="flex flex-wrap justify-center gap-4">
                    <div class="bg-white rounded-lg px-6 py-3 shadow-sm">
                        <i class="fas fa-envelope text-blue-600 mr-2"></i>
                        <span class="text-gray-700">Email: <strong>doanlaptrinhweb@gmail.com</strong></span>
                    </div>
                    <div class="bg-white rounded-lg px-6 py-3 shadow-sm">
                        <i class="fas fa-calendar text-blue-600 mr-2"></i>
                        <span class="text-gray-700">Năm học: <strong>2024-2025</strong></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Tech Stack Section -->
<div class="bg-gradient-to-r from-gray-900 to-gray-800 text-white rounded-lg shadow-lg p-6 md:p-8">
    <div class="max-w-6xl mx-auto">
        <h2 class="text-2xl font-bold mb-6 text-center flex items-center justify-center">
            <i class="fas fa-code text-blue-400 mr-3"></i>
            Công Nghệ Sử Dụng
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            <!-- ASP.NET MVC -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fas fa-layer-group text-4xl text-blue-400 mb-3"></i>
                    <h3 class="font-bold mb-2">ASP.NET MVC 5</h3>
                    <p class="text-sm text-gray-300">Framework Backend</p>
                </div>
            </div>
            
            <!-- SQL Server -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fas fa-database text-4xl text-green-400 mb-3"></i>
                    <h3 class="font-bold mb-2">SQL Server</h3>
                    <p class="text-sm text-gray-300">Cơ sở dữ liệu</p>
                </div>
            </div>
            
            <!-- Entity Framework -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fas fa-project-diagram text-4xl text-purple-400 mb-3"></i>
                    <h3 class="font-bold mb-2">Entity Framework</h3>
                    <p class="text-sm text-gray-300">ORM Framework</p>
                </div>
            </div>
            
            <!-- Tailwind CSS -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fas fa-palette text-4xl text-cyan-400 mb-3"></i>
                    <h3 class="font-bold mb-2">Tailwind CSS</h3>
                    <p class="text-sm text-gray-300">CSS Framework</p>
                </div>
            </div>
            
            <!-- JavaScript -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fab fa-js-square text-4xl text-yellow-400 mb-3"></i>
                    <h3 class="font-bold mb-2">JavaScript</h3>
                    <p class="text-sm text-gray-300">Ngôn ngữ Client-side</p>
                </div>
            </div>
            
            <!-- jQuery -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fas fa-file-code text-4xl text-blue-300 mb-3"></i>
                    <h3 class="font-bold mb-2">jQuery</h3>
                    <p class="text-sm text-gray-300">JavaScript Library</p>
                </div>
            </div>
            
            <!-- Bootstrap -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fab fa-bootstrap text-4xl text-purple-300 mb-3"></i>
                    <h3 class="font-bold mb-2">Bootstrap 4</h3>
                    <p class="text-sm text-gray-300">UI Components</p>
                </div>
            </div>
            
            <!-- Chart.js -->
            <div class="bg-white/10 backdrop-blur-sm rounded-lg p-6 hover:bg-white/20 transition-all">
                <div class="text-center">
                    <i class="fas fa-chart-line text-4xl text-red-400 mb-3"></i>
                    <h3 class="font-bold mb-2">Chart.js</h3>
                    <p class="text-sm text-gray-300">Data Visualization</p>
                </div>
            </div>
        </div>
        
        <!-- Additional Tools -->
        <div class="mt-8 text-center">
            <h3 class="text-lg font-bold mb-4">Công Cụ & Thư Viện Khác:</h3>
            <div class="flex flex-wrap justify-center gap-3">
                <span class="bg-white/10 rounded-full px-4 py-2 text-sm">
                    <i class="fas fa-check-circle text-green-400 mr-2"></i>SweetAlert2
                </span>
                <span class="bg-white/10 rounded-full px-4 py-2 text-sm">
                    <i class="fas fa-check-circle text-green-400 mr-2"></i>Font Awesome
                </span>
                <span class="bg-white/10 rounded-full px-4 py-2 text-sm">
                    <i class="fas fa-check-circle text-green-400 mr-2"></i>AJAX
                </span>
                <span class="bg-white/10 rounded-full px-4 py-2 text-sm">
                    <i class="fas fa-check-circle text-green-400 mr-2"></i>Razor View Engine
                </span>
                <span class="bg-white/10 rounded-full px-4 py-2 text-sm">
                    <i class="fas fa-check-circle text-green-400 mr-2"></i>LINQ
                </span>
            </div>
        </div>
    </div>
</div>

<!-- Call to Action -->
<div class="mt-8 text-center">
    <a href="@Url.Action("Index", "Home")" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-full shadow-lg transition-all hover:scale-105">
        <i class="fas fa-home mr-2"></i>Về Trang Chủ
    </a>
</div>