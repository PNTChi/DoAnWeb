@{
    ViewBag.Title = "Access Denied - 403";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .access-denied-container {
        min-height: 80vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
    }
    
    .access-denied-box {
        text-align: center;
        max-width: 600px;
    }
    
    .error-code {
        font-size: 120px;
        font-weight: bold;
        color: #dc3545;
        line-height: 1;
        margin-bottom: 20px;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.1);
    }
    
    .error-icon {
        font-size: 80px;
        color: #ffc107;
        margin-bottom: 20px;
    }
    
    .error-title {
        font-size: 32px;
        font-weight: 600;
        color: #333;
        margin-bottom: 15px;
    }
    
    .error-message {
        font-size: 18px;
        color: #666;
        margin-bottom: 30px;
        line-height: 1.6;
    }
    
    .error-details {
        background: #f8f9fa;
        border-left: 4px solid #ffc107;
        padding: 20px;
        margin: 30px 0;
        text-align: left;
    }
    
    .error-details h4 {
        color: #856404;
        margin-bottom: 10px;
    }
    
    .error-details ul {
        color: #666;
        margin-left: 20px;
    }
    
    .error-details li {
        margin-bottom: 8px;
    }
    
    .action-buttons {
        margin-top: 30px;
    }
    
    .action-buttons .btn {
        margin: 5px;
        padding: 12px 30px;
        font-size: 16px;
    }
    
    .btn-go-back {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
    }
    
    .btn-go-back:hover {
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
    }
    
    .btn-go-home {
        background: #6c757d;
        color: white;
        border: none;
    }
    
    .btn-go-home:hover {
        background: #5a6268;
    }
</style>

<div class="access-denied-container">
    <div class="access-denied-box">
        <div class="error-icon">
            <i class="fas fa-lock"></i>
        </div>
        
        <div class="error-code">403</div>
        
        <h1 class="error-title">Truy cập bị từ chối</h1>
        
        <p class="error-message">
            Xin lỗi, bạn không có quyền truy cập vào trang này.<br>
            Vui lòng liên hệ quản trị viên nếu bạn cho rằng đây là lỗi.
        </p>
        
        <div class="error-details">
            <h4><i class="fas fa-info-circle"></i> Tại sao tôi thấy trang này?</h4>
            <ul>
                <li>Bạn đang cố gắng truy cập một trang yêu cầu quyền quản trị viên</li>
                <li>Tài khoản của bạn không có đủ quyền để thực hiện hành động này</li>
                <li>Trang này chỉ dành cho nhân viên hoặc quản trị viên cấp cao</li>
            </ul>
        </div>
        
        <div class="action-buttons">
            <button onclick="history.back()" class="btn btn-go-back">
                <i class="fas fa-arrow-left"></i> Quay lại
            </button>
            <a href="@Url.Action("Index", "Home")" class="btn btn-go-home">
                <i class="fas fa-home"></i> Về trang chủ
            </a>
        </div>
        
        @if (Session["UserName"] != null)
        {
            <p style="margin-top: 30px; color: #999; font-size: 14px;">
                <strong>Thông tin debug:</strong><br>
                - Tài khoản: <strong>@Session["UserName"]</strong><br>
                - User ID: @Session["UserId"]<br>
                - IsAdmin: @Session["IsAdmin"]<br>
                - Role ID: @(Session["Role"] ?? "NULL") 
                @if (Session["Role"] != null)
                {
                    <span>(Quyền: @(Convert.ToInt32(Session["Role"]) == 1 ? "Admin" : "Staff"))</span>
                }
                else
                {
                    <span class="text-danger">(⚠️ KHÔNG CÓ ROLE - ĐÂY LÀ VẤN ĐỀ!)</span>
                }
            </p>
        }
    </div>
</div>

@section Scripts {
    <script>
        // Auto redirect after 10 seconds
        setTimeout(function() {
            if (confirm('Bạn sẽ được chuyển về trang chủ. Nhấn OK để tiếp tục hoặc Cancel để ở lại.')) {
                window.location.href = '@Url.Action("Index", "Home")';
            }
        }, 10000);
    </script>
}
